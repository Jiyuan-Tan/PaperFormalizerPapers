/-- For [a finite real transition matrix](hyp:R), [positive-power irreducibility](goal)
means [each ordered pair of states has a strictly positive transition probability
under some nonnegative power of the matrix](step:1). -/
def IsPowerIrreducible {T : Type*} [Fintype T] [DecidableEq T]
    (R : Matrix T T ℝ) : Prop :=
  ∀ x y, ∃ n : ℕ, 0 < (R ^ n) x y

/-- For [a measure on the sample space](hyp:μ), [a sequence of state observations](hyp:U),
[an initial mass vector](hyp:nu), and [a transition matrix](hyp:R), [having the matrix
Markov law](goal) means [each observation is measurable for the full state sigma algebra](step:1)
and [each nonempty finite path has probability equal to its initial mass times
the product of its successive transition entries](step:2). -/
def HasMatrixMarkovLaw {T Ω : Type*} [Fintype T] [mΩ : MeasurableSpace Ω]
    (μ : Measure Ω) (U : ℕ → Ω → T) (nu : T → ℝ) (R : Matrix T T ℝ) : Prop :=
  (∀ k, @Measurable Ω T mΩ ⊤ (U k)) ∧
  (∀ (n : ℕ) (x : Fin (n + 1) → T),
    μ.real {ω | ∀ i : Fin (n + 1), U i ω = x i} =
      nu (x 0) * ∏ i : Fin n, R (x i.castSucc) (x i.succ))

/-- For [a finite transition matrix](hyp:R), [a stationary mass vector](hyp:phi),
[a real reward](hyp:f), and [a nonnegative lag](hyp:k), [the stationary lag product](goal)
is [the two-state reward product averaged against the stationary mass and the
k-step transition probabilities](step:1). It is a covariance when the reward's
stationary mean is zero. -/
noncomputable def stationaryLagProduct {T : Type*} [Fintype T] [DecidableEq T]
    (R : Matrix T T ℝ) (phi f : T → ℝ) (k : ℕ) : ℝ :=
  ∑ x, ∑ y, phi x * (R ^ k) x y * f x * f y

/-- For [a finite transition matrix](hyp:R), [stationary state masses](hyp:phi),
[a real reward](hyp:f), and [a sample length](hyp:n), [the weighted covariance sum](goal)
is [the sum of stationary positive-lag reward products for lags below the sample
length, each weighted by one minus the lag divided by that length](step:1). -/
noncomputable def weightedLagSum {T : Type*} [Fintype T] [DecidableEq T]
    (R : Matrix T T ℝ) (phi f : T → ℝ) (n : ℕ) : ℝ :=
  ∑ k ∈ Finset.Ico 1 n, (1 - (k : ℝ) / n) * stationaryLagProduct R phi f k

/-- For [a row-stochastic finite matrix](hyp:hR) with [positive-power reachability](hyp:hreach),
[a stationary probability vector](hyp:hphi), and [measurable observations](hyp:hU) satisfying
[the Markov cylinder-probability formula](hyp:hpaths),
[the second moment of every centred sum of a real reward](hyp:f) [grows at most linearly
in its length](goal). -/
theorem exists_linear_secondMoment_bound
    {T Ω : Type*} [Fintype T] [DecidableEq T] [Nonempty T]
    [mΩ : MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
    {R : Matrix T T ℝ} {phi nu : T → ℝ} {U : ℕ → Ω → T}
    (hR : IsStochasticMatrix R)
    (hreach : ∀ x y, ∃ n : ℕ, 0 < (R ^ n) x y)
    (hphi : IsStationary R phi)
    (hU : ∀ k, @Measurable Ω T mΩ ⊤ (U k))
    (hpaths : ∀ (n : ℕ) (x : Fin (n + 1) → T),
      μ.real {ω | ∀ i : Fin (n + 1), U i ω = x i} =
        nu (x 0) * ∏ i : Fin n, R (x i.castSucc) (x i.succ))
    (f : T → ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ n : ℕ,
      (∫ ω, (∑ k ∈ Finset.range n, (f (U k ω) - ∑ x, phi x * f x)) ^ 2 ∂μ) ≤
        C * (n + 1) := by
  -- Center f, solve its Poisson equation, bound innovations and the two endpoint
  -- values, and use the martingale sum second-moment identity. This proof
  -- uses no convergence or mixing of single-time marginal distributions.
  -- A useful explicit choice is B = sum_x |g x| and C = 8 * B^2:
  -- each innovation and the endpoint difference have absolute value at most 2B;
  -- (a+b)^2 ≤ 2a^2+2b^2 and orthogonality give C*(n+1).
  -- The current/next observations are measurable for observedInformation U (k+1)
  -- directly from le_iSup and observedInformation_mono; no process law beyond
  -- condExp_transitionInnovation is needed for the martingale estimate.
  classical
  let a : ℝ := ∑ x, phi x * f x
  have hc : ∑ x, phi x * (f x - a) = 0 := by
    simp_rw [mul_sub]
    rw [Finset.sum_sub_distrib, ← Finset.sum_mul, hphi.1.2]
    simp [a]
  obtain ⟨g, hg⟩ := exists_potential_of_stationary_mean_zero hR hreach hphi hc
  let B : ℝ := ∑ x, |g x|
  have hb (x : T) : |g x| ≤ B :=
    Finset.single_le_sum (fun y _ => abs_nonneg (g y)) (Finset.mem_univ x)
  have hrg (x : T) : |R.mulVec g x| ≤ B := by
    simpa using abs_mulVec_pow_le hR hb 1 x
  let F : Filtration ℕ mΩ :=
    ⟨observedInformation U, observedInformation_mono U, observedInformation_le hU⟩
  let D := transitionInnovation R U g
  have hd (k : ℕ) : MemLp (D k) 2 μ :=
    (memLp_finiteState_score μ hU g (k + 1) 2).sub
      (memLp_finiteState_score μ hU (R.mulVec g) k 2)
  have ha (k : ℕ) : StronglyMeasurable[F (k + 1)] (D k) := by
    have hu (j : ℕ) (hj : j ≤ k + 1) :
        @Measurable Ω T (F (k + 1)) ⊤ (U j) :=
      Measurable.of_comap_le (le_iSup_of_le
        (⟨j, by omega⟩ : Fin (k + 2)) le_rfl)
    exact ((show @Measurable T ℝ ⊤ _ g from fun _ _ => trivial).comp
      (hu (k + 1) le_rfl)).stronglyMeasurable.sub
      ((show @Measurable T ℝ ⊤ _ (R.mulVec g) from fun _ _ => trivial).comp
        (hu k (by omega))).stronglyMeasurable
  have hm (k : ℕ) : μ[D k | F k] =ᵐ[μ] 0 :=
    (condExp_transitionInnovation μ hU hpaths g k).1
  have hdb (k : ℕ) (ω : Ω) : |D k ω| ≤ 2 * B := by
    exact (abs_sub _ _).trans (by linarith [hb (U (k + 1) ω), hrg (U k ω)])
  have hdi (k : ℕ) : (∫ ω, (D k ω) ^ 2 ∂μ) ≤ 4 * B ^ 2 := by
    calc
      _ ≤ ∫ _ : Ω, 4 * B ^ 2 ∂μ :=
        integral_mono (hd k).integrable_sq (integrable_const _) (fun ω => by
          have h := hdb k ω
          have hb0 : 0 ≤ B := (abs_nonneg _).trans (hb (U 0 ω))
          have hh := (sq_le_sq₀ (abs_nonneg (D k ω))
            (by positivity : 0 ≤ 2 * B)).mpr h
          nlinarith [sq_abs (D k ω)])
      _ = _ := by simp
  refine ⟨8 * B ^ 2, by positivity, fun n => ?_⟩
  have hs : MemLp (fun ω => ∑ k ∈ Finset.range n, D k ω) 2 μ :=
    memLp_finsetSum _ (fun k _ => hd k)
  have hsi : (∫ ω, (∑ k ∈ Finset.range n, D k ω) ^ 2 ∂μ) ≤ n * (4 * B ^ 2) := by
    rw [integral_sq_sum_martingaleDifferences μ F D hd ha hm]
    simpa using Finset.sum_le_sum (s := Finset.range n) (fun k _ => hdi k)
  have hpoint (ω : Ω) :
      (∑ k ∈ Finset.range n, (f (U k ω) - a)) ^ 2 ≤
        2 * (∑ k ∈ Finset.range n, D k ω) ^ 2 + 8 * B ^ 2 := by
    rw [sum_score_eq_innovations_add_boundary R U (fun x => f x - a) g hg]
    have hh : |g (U 0 ω) - g (U n ω)| ≤ 2 * B :=
      (abs_sub _ _).trans (by linarith [hb (U 0 ω), hb (U n ω)])
    have hb0 : 0 ≤ B := (abs_nonneg _).trans (hb (U 0 ω))
    change ((∑ k ∈ Finset.range n, D k ω) + g (U 0 ω) - g (U n ω)) ^ 2 ≤ _
    have hh2 := (sq_le_sq₀ (abs_nonneg (g (U 0 ω) - g (U n ω)))
      (by positivity : 0 ≤ 2 * B)).mpr hh
    nlinarith [sq_abs (g (U 0 ω) - g (U n ω)),
      sq_nonneg ((∑ k ∈ Finset.range n, D k ω) - (g (U 0 ω) - g (U n ω)))]
  have hleft : MemLp (fun ω => ∑ k ∈ Finset.range n, (f (U k ω) - a)) 2 μ :=
    memLp_finsetSum _ (fun k _ => memLp_finiteState_score μ hU (fun x => f x - a) k 2)
  calc
    _ ≤ ∫ ω, 2 * (∑ k ∈ Finset.range n, D k ω) ^ 2 + 8 * B ^ 2 ∂μ :=
      integral_mono hleft.integrable_sq (hs.integrable_sq.const_mul 2 |>.add
        (integrable_const _)) hpoint
    _ = 2 * (∫ ω, (∑ k ∈ Finset.range n, D k ω) ^ 2 ∂μ) + 8 * B ^ 2 := by
      rw [integral_add (hs.integrable_sq.const_mul 2) (integrable_const _),
        integral_const_mul]
      simp
    _ ≤ _ := by nlinarith

/-- For [a row-stochastic finite matrix](hyp:hR) with [positive-power reachability](hyp:hreach),
[a stationary probability vector](hyp:hphi), and [measurable observations](hyp:hU) satisfying
[the Markov cylinder-probability formula](hyp:hpaths),
[the time average of any real reward](hyp:f) [converges in probability to its stationary
mean](goal). -/
theorem tendstoInMeasure_timeAverage
    {T Ω : Type*} [Fintype T] [DecidableEq T] [Nonempty T]
    [mΩ : MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
    {R : Matrix T T ℝ} {phi nu : T → ℝ} {U : ℕ → Ω → T}
    (hR : IsStochasticMatrix R)
    (hreach : ∀ x y, ∃ n : ℕ, 0 < (R ^ n) x y)
    (hphi : IsStationary R phi)
    (hU : ∀ k, @Measurable Ω T mΩ ⊤ (U k))
    (hpaths : ∀ (n : ℕ) (x : Fin (n + 1) → T),
      μ.real {ω | ∀ i : Fin (n + 1), U i ω = x i} =
        nu (x 0) * ∏ i : Fin n, R (x i.castSucc) (x i.succ))
    (f : T → ℝ) :
    TendstoInMeasure μ (fun n ω => (∑ k ∈ Finset.range n, f (U k ω)) / n)
      atTop (fun _ => ∑ x, phi x * f x) := by
  -- Apply Chebyshev to exists_linear_secondMoment_bound and divide by n².
  -- Causalean.Stat.Modes.tendstoInProbability_iff_measureReal_norm converts
  -- the goal to scalar tail probabilities for the real-valued Chebyshev bound.
  classical
  obtain ⟨C, hC, hbound⟩ :=
    exists_linear_secondMoment_bound μ hR hreach hphi hU hpaths f
  let a : ℝ := ∑ x, phi x * f x
  let S : ℕ → Ω → ℝ := fun n ω => ∑ k ∈ Finset.range n, (f (U k ω) - a)
  have hS (n : ℕ) : MemLp (S n) 2 μ :=
    memLp_finsetSum _ (fun k _ => memLp_finiteState_score μ hU (fun x => f x - a) k 2)
  apply (Causalean.Stat.Modes.tendstoInProbability_iff_measureReal_norm
    (fun _ : ℕ => μ) _ atTop (fun _ _ => a)).mpr
  intro ε hε
  have ht : Tendsto (fun n : ℕ => (2 * C / ε ^ 2) * (n : ℝ)⁻¹) atTop (𝓝 0) := by
    convert (tendsto_inv_atTop_zero.comp
      (tendsto_natCast_atTop_atTop : Tendsto (fun n : ℕ => (n : ℝ)) atTop atTop)).const_mul
      (2 * C / ε ^ 2) using 1 <;> simp
  apply squeeze_zero' (Eventually.of_forall (fun n => ENNReal.toReal_nonneg)) ?_ ht
  filter_upwards [eventually_ge_atTop 1] with n hn
  have hn0 : (0 : ℝ) < n := by exact_mod_cast (by omega : 0 < n)
  have hn1 : (1 : ℝ) ≤ n := by exact_mod_cast hn
  have he (ω : Ω) : (∑ k ∈ Finset.range n, f (U k ω)) / n - a = S n ω / n := by
    simp only [S, Finset.sum_sub_distrib, Finset.sum_const, Finset.card_range, nsmul_eq_mul]
    field_simp
  have hi : Integrable (fun ω => (S n ω / n) ^ 2) μ := by
    have hh : MemLp (fun ω => S n ω / n) 2 μ := by
      simpa only [div_eq_mul_inv] using ((hS n).mul_const (n : ℝ)⁻¹)
    exact hh.integrable_sq
  have hc := mul_meas_ge_le_integral_of_nonneg
    (ae_of_all μ (fun ω => sq_nonneg (S n ω / n))) hi (ε ^ 2)
  have hset : {ω | ε ^ 2 ≤ (S n ω / n) ^ 2} =
      {ω | ε ≤ ‖(∑ k ∈ Finset.range n, f (U k ω)) / n - a‖} := by
    ext ω
    rw [Set.mem_ofPred_eq, Set.mem_ofPred_eq, he, Real.norm_eq_abs]
    rw [← sq_abs (S n ω / n)]
    exact (sq_le_sq₀ hε.le (abs_nonneg _))
  rw [hset] at hc
  have hint : (∫ ω, (S n ω / n) ^ 2 ∂μ) ≤ C * (n + 1) / (n : ℝ) ^ 2 := by
    simp_rw [div_pow, div_eq_mul_inv]
    rw [integral_mul_const]
    exact mul_le_mul_of_nonneg_right (hbound n) (by positivity)
  change μ.real {ω | ε ≤ ‖(∑ k ∈ Finset.range n, f (U k ω)) / n - a‖} ≤ _
  have htail : μ.real {ω | ε ≤ ‖(∑ k ∈ Finset.range n, f (U k ω)) / n - a‖} ≤
      (C * (n + 1) / (n : ℝ) ^ 2) / ε ^ 2 := by
    apply (le_div_iff₀ (sq_pos_of_pos hε)).mpr
    nlinarith [hc.trans hint]
  refine htail.trans ?_
  apply (div_le_iff₀ (sq_pos_of_pos hε)).mpr
  apply (div_le_iff₀ (sq_pos_of_pos hn0)).mpr
  field_simp
  nlinarith

/-- For [a process on a finite state space](hyp:U) and [any real potential on that space](hyp:g),
[its initial value minus its value at time n, divided by the square root of n,
vanishes uniformly over all outcomes](goal). -/
theorem tendsto_uniform_potential_boundary
    {T Ω : Type*} [Finite T] (U : ℕ → Ω → T) (g : T → ℝ) :
    ∀ ε : ℝ, 0 < ε → ∀ᶠ n : ℕ in atTop,
      ∀ ω, |(g (U 0 ω) - g (U n ω)) / Real.sqrt n| < ε := by
  -- Bound |g| on its finite domain; the numerator is at most twice that bound.
  classical
  let := Fintype.ofFinite T
  let B : ℝ := ∑ x : T, |g x|
  have hb (x : T) : |g x| ≤ B :=
    Finset.single_le_sum (fun y _ => abs_nonneg (g y)) (Finset.mem_univ x)
  intro ε hε
  have ht : Tendsto (fun n : ℕ => ε * Real.sqrt n) atTop atTop :=
    (Real.tendsto_sqrt_atTop.comp tendsto_natCast_atTop_atTop).const_mul_atTop hε
  filter_upwards [ht.eventually (eventually_gt_atTop (2 * B)),
    eventually_gt_atTop 0] with n hn hnpos ω
  have hs : 0 < Real.sqrt (n : ℝ) := Real.sqrt_pos.mpr (Nat.cast_pos.mpr hnpos)
  rw [abs_div, abs_of_pos hs, div_lt_iff₀ hs]
  calc
    |g (U 0 ω) - g (U n ω)| ≤ |g (U 0 ω)| + |g (U n ω)| := abs_sub _ _
    _ ≤ 2 * B := by linarith [hb (U 0 ω), hb (U n ω)]
    _ < ε * Real.sqrt n := hn

/-- For [a row-stochastic finite matrix](hyp:hR) with [positive-power reachability](hyp:hreach),
[a stationary probability vector](hyp:hphi), and [measurable observations](hyp:hU)
satisfying [the Markov cylinder formula](hyp:hpaths),
if [a reward has a Poisson potential](hyp:hpoisson), then [its square-root-normalized
partial sums converge in distribution to the centred Gaussian whose variance is
the stationary average innovation variance](goal). -/
theorem tendstoInDistribution_sum_div_sqrt_of_potential
    {T Ω : Type*} [Fintype T] [DecidableEq T] [Nonempty T]
    [mΩ : MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
    {R : Matrix T T ℝ} {phi nu f g : T → ℝ} {U : ℕ → Ω → T}
    (hR : IsStochasticMatrix R)
    (hreach : ∀ x y, ∃ n : ℕ, 0 < (R ^ n) x y)
    (hphi : IsStationary R phi)
    (hU : ∀ k, @Measurable Ω T mΩ ⊤ (U k))
    (hpaths : ∀ (n : ℕ) (x : Fin (n + 1) → T),
      μ.real {ω | ∀ i : Fin (n + 1), U i ω = x i} =
        nu (x 0) * ∏ i : Fin n, R (x i.castSucc) (x i.succ))
    (hpoisson : ∀ x, g x - R.mulVec g x = f x) :
    TendstoInDistribution (fun n ω => (∑ k ∈ Finset.range n, f (U k ω)) / Real.sqrt n)
      atTop (id : ℝ → ℝ) (fun _ => μ)
      (gaussianReal 0 (∑ x, phi x * innovationVariance R g x).toNNReal) := by
  -- Make a filtration from observedInformation_mono and observedInformation_le.
  -- Conditional moments come from condExp_transitionInnovation. Apply the time
  -- average LLN to innovationVariance R g for the bracket limit; use the bounded
  -- martingale CLT, including zero variance. Finally transfer through the
  -- uniformly vanishing boundary with Mathlib's converging-together theorem,
  -- tendstoInDistribution_of_tendstoInMeasure_sub, with Y the reward sum
  -- and X the innovation sum; its final hypothesis is aemeasurability of Y.
  classical
  let B : ℝ := ∑ x, |g x|
  have hb (x : T) : |g x| ≤ B :=
    Finset.single_le_sum (fun y _ => abs_nonneg (g y)) (Finset.mem_univ x)
  have hrg (x : T) : |R.mulVec g x| ≤ B := by
    simpa using abs_mulVec_pow_le hR hb 1 x
  let F : Filtration ℕ mΩ :=
    ⟨observedInformation U, observedInformation_mono U, observedInformation_le hU⟩
  let D := transitionInnovation R U g
  have ha (k : ℕ) : StronglyMeasurable[F (k + 1)] (D k) := by
    have hu (j : ℕ) (hj : j ≤ k + 1) :
        @Measurable Ω T (F (k + 1)) ⊤ (U j) :=
      Measurable.of_comap_le (le_iSup_of_le
        (⟨j, by omega⟩ : Fin (k + 2)) le_rfl)
    exact ((show @Measurable T ℝ ⊤ _ g from fun _ _ => trivial).comp
      (hu (k + 1) le_rfl)).stronglyMeasurable.sub
      ((show @Measurable T ℝ ⊤ _ (R.mulVec g) from fun _ _ => trivial).comp
        (hu k (by omega))).stronglyMeasurable
  have hm (k : ℕ) : μ[D k | F k] =ᵐ[μ] 0 :=
    (condExp_transitionInnovation μ hU hpaths g k).1
  have hdb (k : ℕ) (ω : Ω) : |D k ω| ≤ 2 * B :=
    (abs_sub _ _).trans (by linarith [hb (U (k + 1) ω), hrg (U k ω)])
  let v : ℝ := ∑ x, phi x * innovationVariance R g x
  have hv : 0 ≤ v := Finset.sum_nonneg fun x _ =>
    mul_nonneg (hphi.1.1 x) (Finset.sum_nonneg fun y _ =>
      mul_nonneg (hR.1 x y) (sq_nonneg _))
  have hvariance : TendstoInMeasure μ
      (fun n ω => (∑ k ∈ Finset.range n, μ[fun z => (D k z) ^ 2 | F k] ω) / n)
      atTop (fun _ => v) := by
    refine TendstoInMeasure.congr_left (f := fun n ω =>
      (∑ k ∈ Finset.range n, innovationVariance R g (U k ω)) / n) ?_
      (tendstoInMeasure_timeAverage μ hR hreach hphi hU hpaths (innovationVariance R g))
    intro n
    have he : ∀ᵐ ω ∂μ, ∀ k ∈ Finset.range n,
        μ[fun z => (D k z) ^ 2 | F k] ω = innovationVariance R g (U k ω) := by
      exact (Finset.eventually_all _).mpr fun k _ =>
        (condExp_transitionInnovation μ hU hpaths g k).2
    filter_upwards [he] with ω hω
    rw [Finset.sum_congr rfl (fun k hk => hω k hk)]
  have hclt := tendstoInDistribution_sum_div_sqrt_of_bounded_martingaleDifferences
    μ F D (2 * B) v ha hm hdb hv hvariance
  let Y : ℕ → Ω → ℝ := fun n ω => (∑ k ∈ Finset.range n, f (U k ω)) / Real.sqrt n
  let X : ℕ → Ω → ℝ := fun n ω => (∑ k ∈ Finset.range n, D k ω) / Real.sqrt n
  have hsub (n : ℕ) (ω : Ω) : (Y - X) n ω =
      (g (U 0 ω) - g (U n ω)) / Real.sqrt n := by
    dsimp [Y, X]
    rw [sum_score_eq_innovations_add_boundary R U f g hpoisson]
    simp only [add_div, sub_div]
    ring
  have hboundary : TendstoInMeasure μ (Y - X) atTop 0 := by
    apply (Causalean.Stat.Modes.tendstoInProbability_iff_measureReal_norm
      (fun _ : ℕ => μ) (Y - X) atTop (fun _ _ => 0)).mpr
    intro ε hε
    apply tendsto_const_nhds.congr'
    filter_upwards [tendsto_uniform_potential_boundary U g ε hε] with n hn
    have he : {ω | ε ≤ ‖(Y - X) n ω - 0‖} = ∅ := by
      ext ω
      simp only [Set.mem_ofPred_eq, Set.mem_empty_iff_false, iff_false, sub_zero,
        Real.norm_eq_abs, hsub]
      exact not_le_of_gt (hn ω)
    rw [he]
    simp
  exact tendstoInDistribution_of_tendstoInMeasure_sub Y (id : ℝ → ℝ) hclt hboundary
    (fun n => (Finset.aemeasurable_fun_sum _ (fun k _ =>
      ((show @Measurable T ℝ ⊤ _ f from fun _ _ => trivial).comp (hU k)).aemeasurable)).div_const _)

/-- For a finite nonempty state space, [a row-stochastic transition matrix](hyp:hR)
that [is irreducible](hyp:hIrreducible), [a stationary probability vector](hyp:hphi),
and [measurable random variables forming a Markov chain with any initial law
and that transition matrix](hyp:hU), if [a real reward
has stationary mean zero](hyp:hcenter), then [its Cesàro-weighted stationary covariance
sums converge to a real limit, its stationary second moment plus twice this limit
is nonnegative, and its partial sums divided by the square root of their length
converge in distribution to the centred normal law with that variance, with a point
mass at zero when the variance is zero](goal).

No aperiodicity or stationary-start assumption is required. The Gaussian target
is Mathlib's Gaussian probability measure, whose zero-variance case is a Dirac law.
The one-observation path probabilities on the probability space already imply
that the initial mass vector is nonnegative and sums to one.
-/
theorem tendstoInDistribution_sum_div_sqrt_of_irreducible_markovChain
    {T : Type*} [Fintype T] [DecidableEq T] [Nonempty T]
    {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
    (R : Matrix T T ℝ) (hR : IsStochasticMatrix R)
    (hIrreducible : IsPowerIrreducible R)
    (phi nu : T → ℝ) (hphi : IsStationary R phi)
    (U : ℕ → Ω → T) (hU : HasMatrixMarkovLaw μ U nu R)
    (f : T → ℝ) (hcenter : ∑ x, phi x * f x = 0) :
    ∃ L : ℝ, Tendsto (weightedLagSum R phi f) atTop (nhds L) ∧
      let s2 := (∑ x, phi x * f x ^ 2) + 2 * L
      0 ≤ s2 ∧ TendstoInDistribution
        (fun N ω => (∑ i : Fin N, f (U i ω)) / Real.sqrt N)
        atTop (id : ℝ → ℝ) (fun _ => μ) (gaussianReal 0 s2.toNNReal) := by
  -- Assembly only: obtain a potential, use the weighted covariance limit, rewrite
  -- its variance as the stationary innovation variance, and apply the potential CLT.
  -- Convert range sums to Fin sums with Fin.sum_univ_eq_sum_range.
  obtain ⟨g, hg⟩ := exists_potential_of_stationary_mean_zero
    hR hIrreducible hphi hcenter
  refine ⟨∑ x, phi x * f x * R.mulVec g x, ?_, ?_⟩
  · change Tendsto (fun n : ℕ => ∑ k ∈ Finset.Ico 1 n,
        (1 - (k : ℝ) / n) * ∑ x, ∑ y, phi x * (R ^ k) x y * f x * f y)
        atTop (nhds (∑ x, phi x * f x * R.mulVec g x))
    exact tendsto_weighted_covariances_of_potential
      hR hIrreducible hphi hcenter hg
  · dsimp only
    have hvar := sum_innovationVariance_eq hR hphi hg
    constructor
    · rw [← hvar]
      exact sum_innovationVariance_nonneg hR.1 hphi.1.1 g
    · have hlimit := tendstoInDistribution_sum_div_sqrt_of_potential
        μ hR hIrreducible hphi hU.1 hU.2 hg
      rw [hvar] at hlimit
      have hsum :
          (fun N ω => (∑ i : Fin N, f (U i ω)) / Real.sqrt N) =
          (fun N ω => (∑ i ∈ Finset.range N, f (U i ω)) / Real.sqrt N) := by
        funext N ω
        rw [Fin.sum_univ_eq_sum_range (fun i => f (U i ω)) N]
      rw [hsum]
      exact hlimit

end Toolkit.Foundations.Probability.LimitTheorems
