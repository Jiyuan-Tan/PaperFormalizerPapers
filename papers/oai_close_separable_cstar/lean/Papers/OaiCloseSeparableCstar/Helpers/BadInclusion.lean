public import Papers.OaiCloseSeparableCstar.Helpers.FreeNorm
public import Papers.OaiCloseSeparableCstar.Helpers.TensorLp

/-! # Lemma 10: the deformed inclusion fails the spatial tensor-norm identity -/

public section

open scoped BigOperators InnerProductSpace

namespace Papers.OaiCloseSeparableCstar

/-- [Right regular translation on the first tensor factor commutes with every
element of the ambient algebra associated with any unitary representation](goal). -/
-- @node: rightFactorTest_mem_commutant
lemma rightFactorTest_mem_commutant (π : FG →* unitary (Op KSp)) (g : FG) :
    flipOp * constantDiagOp (rightReg g : Op KSp) * flipOp ∈ commutant (Dalg π) := by
  rw [Dalg_commutant_eq]
  refine ⟨(rightReg g : Op KSp), ?_, rfl⟩
  rintro _ ⟨h, rfl⟩
  exact leftReg_commutes_rightReg h g

/-- [Each tensor generator of a unitary representation belongs to the norm-closed
star algebra generated by that representation's tensor generators](goal). -/
-- @node: Qop_mem_Palg
lemma Qop_mem_Palg (π : FG →* unitary (Op KSp)) (g : FG) : Qop π g ∈ Palg π := by
  apply StarSubalgebra.le_topologicalClosure
  exact StarAlgebra.subset_adjoin ℂ _ ⟨g, rfl⟩

/-- [The diagonal coefficient at the tensor identity basis vector of a tensor
generator times right translation on the first factor equals the identity basis
coefficient of the original representation at the same group element](goal). -/
-- @node: badInclusion_test_coefficient
lemma badInclusion_test_coefficient (π : FG →* unitary (Op KSp)) (g : FG) :
    ⟪((Qop π g * (flipOp * constantDiagOp (rightReg g : Op KSp) * flipOp) : Op LSp)
      (lp.single 2 (1 : FG) (delta 1) : LSp)), (lp.single 2 (1 : FG) (delta 1) : LSp)⟫_ℂ =
      ⟪(π g : Op KSp) (delta 1), delta 1⟫_ℂ := by
  classical
  rw [lp.inner_single_right]
  change ⟪(π g : Op KSp)
    (((flipOp * constantDiagOp (rightReg g : Op KSp) * flipOp : Op LSp)
      (lp.single 2 (1 : FG) (delta 1))) (g⁻¹ * 1)), delta 1⟫_ℂ = _
  rw [firstFactor_single_apply]
  have he : ((rightReg g : Op KSp) (delta 1)) (g⁻¹ * 1) = 1 := by
    change delta 1 ((g⁻¹ * 1) * g) = 1
    simp [delta]
  rw [he, one_smul]

/-- If [t lies strictly between zero and one](hyp:ht) and [the representation has
generator coefficients t and the prescribed uniform distance bound from the left
regular representation](hyp:hπ), then [the norm of the sum over the first m free
generators of each tensor generator times the corresponding right translation on
the first factor is at least m times t](goal). -/
-- @node: badInclusion_large_norm
lemma badInclusion_large_norm (t : ℝ) (ht : DeformationRange t)
    (π : FG →* unitary (Op KSp)) (hπ : IsTreeRep t ht π) (m : ℕ) :
    (m : ℝ) * t ≤ ‖∑ i : Fin m, Qop π (gen i.val) *
      (flipOp * constantDiagOp (rightReg (gen i.val) : Op KSp) * flipOp)‖ := by
  classical
  let v : LSp := lp.single 2 (1 : FG) (delta 1)
  let A : Op LSp := ∑ i : Fin m, Qop π (gen i.val) *
    (flipOp * constantDiagOp (rightReg (gen i.val) : Op KSp) * flipOp)
  have hv : ‖v‖ = 1 := by simp [v, delta, lp.norm_single (by norm_num : (0 : ENNReal) < 2)]
  have hc : ⟪A v, v⟫_ℂ = (m : ℂ) * (t : ℂ) := by
    dsimp [A]
    rw [sum_apply, sum_inner]
    simp only [v, badInclusion_test_coefficient, hπ.1]
    simp
  have hn : ‖⟪A v, v⟫_ℂ‖ ≤ ‖A‖ := by
    calc
      _ ≤ ‖A v‖ * ‖v‖ := norm_inner_le_norm _ _
      _ ≤ (‖A‖ * ‖v‖) * ‖v‖ := mul_le_mul_of_nonneg_right (A.le_opNorm v) (norm_nonneg _)
      _ = ‖A‖ := by rw [hv]; simp
  rw [hc, norm_mul, Complex.norm_natCast, Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos ht.1] at hn
  exact hn

/-- If [t lies strictly between zero and one](hyp:ht), then [there is a positive
integer m for which twice the square root of m is strictly less than m times
t](goal). -/
-- @node: badInclusion_choose_m
lemma badInclusion_choose_m (t : ℝ) (ht : DeformationRange t) :
    ∃ m : ℕ, 0 < m ∧ 2 * Real.sqrt m < (m : ℝ) * t := by
  obtain ⟨m, hm⟩ := exists_nat_gt (4 / t ^ 2)
  have ht2 : 0 < t ^ 2 := sq_pos_of_pos ht.1
  have hm2 : 4 < (m : ℝ) * t ^ 2 := (div_lt_iff₀ ht2).mp hm
  have hm0 : (0 : ℝ) < m := by nlinarith
  have hs0 : 0 < Real.sqrt m := Real.sqrt_pos.mpr hm0
  have hs2 : (Real.sqrt m) ^ 2 = (m : ℝ) := Real.sq_sqrt hm0.le
  have hst : 2 < Real.sqrt m * t := by
    have hpos : 0 < Real.sqrt m * t := mul_pos hs0 ht.1
    have hsq : 4 < (Real.sqrt m * t) ^ 2 := by nlinarith [hm2]
    nlinarith
  refine ⟨m, Nat.cast_pos.mp hm0, ?_⟩
  have h := mul_lt_mul_of_pos_left hst hs0
  nlinarith [h]

/-- If [m is a positive integer](hyp:hm), then [the spatial tensor norm of the sum
over the first m free generators, pairing each tensor generator of the
representation with the corresponding right translation on the first factor, is
at most twice the square root of m](goal). -/
-- @node: badInclusion_small_norm
lemma badInclusion_small_norm (π : FG →* unitary (Op KSp)) (m : ℕ) (hm : 0 < m) :
    tensorSumNorm (fun i : Fin m => Qop π (gen i.val))
      (fun i => flipOp * constantDiagOp (rightReg (gen i.val) : Op KSp) * flipOp) ≤
        2 * Real.sqrt m := by
  classical
  let ζ : FG →* Op LSp :=
    { toFun := fun g => reindexOp
        { toFun := fun x => x * g
          invFun := fun x => x * g⁻¹
          left_inv := by intro x; simp [mul_assoc]
          right_inv := by intro x; simp [mul_assoc] }
      map_one' := by ext v x y; change v (x * 1) y = v x y; simp
      map_mul' := by
        intro g h
        ext v x y
        change v (x * (g * h)) y = v ((x * g) * h) y
        simp [mul_assoc] }
  have hζ (g : FG) : ‖ζ g‖ ≤ 1 := by
    apply ContinuousLinearMap.opNorm_le_bound _ zero_le_one
    intro v
    change ‖reindexOp _ v‖ ≤ 1 * ‖v‖
    rw [reindexOp_norm, one_mul]
  have hζeq (g : FG) :
      flipOp * constantDiagOp (rightReg g : Op KSp) * flipOp = ζ g := by
    ext v x y
    rfl
  let σ : FG →* Op (TensorProduct ℂ KSp LSp) :=
    { toFun := fun g => TensorProduct.mapL (π g : Op KSp) (ζ g)
      map_one' := by
        rw [map_one, map_one]
        exact TensorProduct.mapL_id_id
      map_mul' := by
        intro g h
        rw [map_mul, map_mul]
        exact TensorProduct.mapL_mul _ _ _ _ }
  have hσ (g : FG) : ‖σ g‖ ≤ 1 := by
    exact (TensorProduct.norm_mapL_le _ _).trans
      (by simpa using (mul_le_mul (unitary_norm_le_one (π g)) (hζ g)
        (norm_nonneg _) zero_le_one))
  let A : Op (TensorProduct ℂ LSp LSp) :=
    ∑ i : Fin m, TensorProduct.mapL (Qop π (gen i.val)) (ζ (gen i.val))
  let B : Op (lp (fun _ : FG => TensorProduct ℂ KSp LSp) 2) :=
    ∑ i : Fin m, shiftOp (gen i.val) *
      diagOp (fun _ : FG => σ (gen i.val)) 1 (fun _ => hσ _)
  let e := lpTensorIsometry (I := FG) (E := KSp) (F := LSp)
  have he (x : TensorProduct ℂ LSp LSp) : e (A x) = B (e x) := by
    induction x using TensorProduct.induction_on with
    | zero => simp
    | tmul v w =>
      ext y
      change lpTensorLinear (A (v ⊗ₜ[ℂ] w)) y = B (lpTensorLinear (v ⊗ₜ[ℂ] w)) y
      simp only [A, B, sum_apply, map_sum, lp.coeFn_sum, Finset.sum_apply,
        TensorProduct.mapL_tmul, lpTensorLinear_tmul]
      apply Finset.sum_congr rfl
      intro i _
      rfl
    | add x y hx hy => simp only [map_add, hx, hy]
  have hAB : ‖A‖ ≤ ‖B‖ := by
    apply A.opNorm_le_bound (norm_nonneg B)
    intro x
    rw [← e.norm_map (A x), he]
    simpa only [e.norm_map] using B.le_opNorm (e x)
  rw [tensorSumNorm_eq_opNorm]
  simp_rw [hζeq]
  change ‖A‖ ≤ _
  exact hAB.trans ((norm_sum_shift_twist_le σ hσ (fun i : Fin m => gen i.val)).trans
    (by
      rw [Fin.sum_univ_eq_sum_range (fun i => (leftReg (gen i) : Op KSp))]
      exact norm_sum_leftReg_gen_le m hm))

-- @node: lem:bad-inclusion
/-- If [t lies strictly between zero and one](hyp:ht) and [the representation has
generator coefficients t and the prescribed uniform distance bound from the left
regular representation](hyp:hπ), then [the inclusion of its generated algebra in
the ambient algebra fails the spatial tensor norm identity: operator norms of
finite sums of products with ambient-commuting operators need not equal the
corresponding spatial tensor norms](goal). -/
lemma badInclusion (t : ℝ) (ht : DeformationRange t)
    (π : FG →* unitary (Op KSp)) (hπ : IsTreeRep t ht π) :
    ¬ HasSpatialTensorIdentity (Dalg π) (Palg π) := by
  intro hidentity
  obtain ⟨m, hm, hgap⟩ := badInclusion_choose_m t ht
  let p : Fin m → Op LSp := fun i => Qop π (gen i.val)
  let z : Fin m → Op LSp := fun i =>
    flipOp * constantDiagOp (rightReg (gen i.val) : Op KSp) * flipOp
  have hp : ∀ i, p i ∈ Palg π := fun i => Qop_mem_Palg π (gen i.val)
  have hz : ∀ i, z i ∈ commutant (Dalg π) :=
    fun i => rightFactorTest_mem_commutant π (gen i.val)
  have hlarge : (m : ℝ) * t ≤ ‖∑ i, p i * z i‖ :=
    badInclusion_large_norm t ht π hπ m
  have hsmall : tensorSumNorm p z ≤ 2 * Real.sqrt m := by
    exact badInclusion_small_norm π m hm
  have heq := hidentity m hm p z hp hz
  exact (not_lt_of_ge ((heq ▸ hlarge).trans hsmall)) hgap

end Papers.OaiCloseSeparableCstar
