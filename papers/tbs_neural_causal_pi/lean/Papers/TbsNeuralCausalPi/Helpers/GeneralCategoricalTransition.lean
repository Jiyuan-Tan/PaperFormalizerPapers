module
public import Papers.TbsNeuralCausalPi.Helpers.CategoricalSelectorLaw
public import Papers.TbsNeuralCausalPi.Helpers.CanonicalNormalization
public import Papers.TbsNeuralCausalPi.Helpers.EvaluationKernels
/-! # Normalized categorical laws of a general SCM

The generation assumption identifies the original measurable mechanism with
the first-maximizer selector pointwise in its intrinsic noise. In
particular, normalized propensities inherit measurability on their domain;
no separate measurability assumption on the raw weights is necessary.
-/
public section
namespace Papers.TbsNeuralCausalPi
open MeasureTheory ProbabilityTheory
open scoped ENNReal
noncomputable section

variable {n b : ℕ} {kind : Fin n → NodeKind} {dims : Fin b → ℕ}

-- @node: categoricalLabel_joint_measurable
/-- If [the node is categorical with k labels](hyp:hi), [its actual label is
jointly measurable in its structural input and intrinsic noise](goal). -/
@[fun_prop] lemma categoricalLabel_joint_measurable
    (M : EuclideanSCM kind dims) (i : Fin n) (k : ℕ)
    (hi : kind i = Sum.inr k) :
    Measurable (fun z : StructuralInput kind dims M.dag M.incidence i × L1Vec k =>
      M.categoricalLabel i k hi z.1 z.2) := by
  have hc : Measurable (cast (congrArg ObservedValue hi) : ObservedValue (kind i) → Fin k) := by
    generalize hv : kind i = v at hi ⊢
    cases hi
    exact measurable_id
  have hg : Measurable (fun g : L1Vec k => WithLp.toLp 1
      (fun j => g.ofLp (Fin.cast (congrArg noiseDim hi) j))) := by fun_prop
  exact hc.comp ((M.structuralMeasurable i).comp
    (measurable_fst.prodMk (hg.comp measurable_snd)))

-- @node: categoricalLabel_ae_normalized_selector
/-- If [the mechanism is generated by Gumbel argmax with the given weights](hyp:hcat),
[the node has k categorical labels](hyp:hi), and [the structural input belongs to
the node's domain](hyp:hx), [the actual label agrees almost surely under the
intrinsic Gumbel law with the canonical selector using normalized weights](goal). -/
lemma categoricalLabel_ae_normalized_selector
    (M : EuclideanSCM kind dims) (p : MechanismWeights M)
    (hcat : CategoricalGumbelArgmax M p) (i : Fin n) (k : ℕ)
    (hi : kind i = Sum.inr k)
    (x : StructuralInput kind dims M.dag M.incidence i) (hx : x ∈ M.domain i) :
    (fun g : Fin k → ℝ => M.categoricalLabel i k hi x (WithLp.toLp 1 g)) =ᵐ[gumbelInputs k]
      (fun g => canonicalSelector (.inr k)
        (fun m hm => M.categoricalPositive i m (hi.trans hm))
        (WithLp.toLp 1 (fun j => (p i x).ofLp
          (Fin.cast (congrArg outputDim hi).symm j) / ∑ l, (p i x).ofLp l))
        (WithLp.toLp 1 g)) := by
  have hs := (hcat.1 i k hi x hx).2
  filter_upwards [] with g
  rw [hcat.2.2.1 i k hi x hx g]
  change _ = (firstArgmax (fun j =>
    extendedLog ((p i x).ofLp (Fin.cast (congrArg outputDim hi).symm j) /
      ∑ l, (p i x).ofLp l) + (g j : EReal))).getD _
  exact congrArg (fun a : Option (Fin k) => a.getD ⟨0, M.categoricalPositive i k hi⟩)
    (firstArgmax_normalized_weights
      (fun j : Fin k => (p i x).ofLp (Fin.cast (congrArg outputDim hi).symm j))
      g _ hs).symm

-- @node: categoricalLabel_normalized_law
/-- If [the mechanism is generated by Gumbel argmax with the given weights](hyp:hcat),
[the node has k categorical labels](hyp:hi), and [the structural input is in its
domain](hyp:hx), [the label law under intrinsic Gumbel noise is the sum of point
masses at the labels weighted by their normalized mechanism weights](goal). -/
lemma categoricalLabel_normalized_law
    (M : EuclideanSCM kind dims) (p : MechanismWeights M)
    (hcat : CategoricalGumbelArgmax M p) (i : Fin n) (k : ℕ)
    (hi : kind i = Sum.inr k)
    (x : StructuralInput kind dims M.dag M.incidence i) (hx : x ∈ M.domain i) :
    (gumbelInputs k).map (fun g => M.categoricalLabel i k hi x (WithLp.toLp 1 g)) =
      ∑ j : Fin k, ENNReal.ofReal ((p i x).ofLp
        (Fin.cast (congrArg outputDim hi).symm j) / ∑ l, (p i x).ofLp l) •
          Measure.dirac j := by
  rw [Measure.map_congr (categoricalLabel_ae_normalized_selector M p hcat i k hi x hx)]
  apply canonicalSelector_categorical_law
  have hp := canonical_normalized_mem_simplex (p i x).ofLp
    (hcat.1 i k hi x hx).1 (hcat.1 i k hi x hx).2
  refine ⟨fun j => hp.1 _, ?_⟩
  exact (Equiv.sum_comp (finCongr (congrArg outputDim hi).symm)
    (fun j => (p i x).ofLp j / ∑ l, (p i x).ofLp l)).trans hp.2

-- @node: categorical_normalized_coordinate_measurable
/-- If [the mechanism is generated by Gumbel argmax with the given weights](hyp:hcat)
and [the node has k categorical labels](hyp:hi), [the normalized weight of any
chosen label is measurable on the node's structural input domain](goal). -/
@[fun_prop] lemma categorical_normalized_coordinate_measurable
    (M : EuclideanSCM kind dims) (p : MechanismWeights M)
    (hcat : CategoricalGumbelArgmax M p) (i : Fin n) (k : ℕ)
    (hi : kind i = Sum.inr k) (j : Fin k) :
    Measurable (fun x : M.domain i => (p i x.val).ofLp
      (Fin.cast (congrArg outputDim hi).symm j) / ∑ l, (p i x.val).ofLp l) := by
  let F : StructuralInput kind dims M.dag M.incidence i × (Fin k → ℝ) → Fin k :=
    fun z => M.categoricalLabel i k hi z.1 (WithLp.toLp 1 z.2)
  have hF : Measurable F := by fun_prop
  let := gumbelInputs_probability k
  let R := privateNoiseUpdateKernel (gumbelInputs k) F hF
  have hprob (x : M.domain i) :
      R x.val {j} = ENNReal.ofReal ((p i x.val).ofLp
        (Fin.cast (congrArg outputDim hi).symm j) / ∑ l, (p i x.val).ofLp l) := by
    change ((gumbelInputs k).map (fun g => M.categoricalLabel i k hi x.val
      (WithLp.toLp 1 g))) {j} = _
    rw [categoricalLabel_normalized_law M p hcat i k hi x.val x.property]
    change (∑ l : Fin k, ENNReal.ofReal ((p i x.val).ofLp
      (Fin.cast (congrArg outputDim hi).symm l) / ∑ a, (p i x.val).ofLp a) •
        Measure.dirac l) {j} = _
    rw [Measure.finsetSum_apply]
    classical
    simp [Measure.smul_apply, Pi.single_apply, mul_ite]
  have hm : Measurable (fun x : M.domain i => (R x.val {j}).toReal) :=
    ENNReal.measurable_toReal.comp
      ((R.measurable_coe (measurableSet_singleton j)).comp measurable_subtype_coe)
  convert hm using 1
  funext x
  rw [hprob x, ENNReal.toReal_ofReal
    (div_nonneg ((hcat.1 i k hi x.val x.property).1 _)
      (hcat.1 i k hi x.val x.property).2.le)]

-- @node: categorical_normalized_propensity_measurable
/-- If [the mechanism is generated by Gumbel argmax with the given weights](hyp:hcat)
and [the node has k categorical labels](hyp:hi), [the vector of normalized label
weights is measurable on the node's structural input domain](goal). -/
@[fun_prop] lemma categorical_normalized_propensity_measurable
    (M : EuclideanSCM kind dims) (p : MechanismWeights M)
    (hcat : CategoricalGumbelArgmax M p) (i : Fin n) (k : ℕ)
    (hi : kind i = Sum.inr k) :
    Measurable (fun x : M.domain i => WithLp.toLp 1 (fun j : Fin k =>
      (p i x.val).ofLp (Fin.cast (congrArg outputDim hi).symm j) /
        ∑ l, (p i x.val).ofLp l)) := by
  fun_prop

-- @node: privateBlock_categoricalLabel_normalized_mixture
/-- If [the mechanism is generated by Gumbel argmax with the given weights](hyp:hcat),
[the node has k categorical labels](hyp:hi), and [the structural input depends
measurably on the private input block](hyp:hx), [the label law under independent
private input and Gumbel noise is the finite mixture whose weight at each label
is the private-input average of its normalized mechanism weight](goal). -/
lemma privateBlock_categoricalLabel_normalized_mixture
    {Z : Type*} [MeasurableSpace Z] (rho : Measure Z) [IsProbabilityMeasure rho]
    (M : EuclideanSCM kind dims) (p : MechanismWeights M)
    (hcat : CategoricalGumbelArgmax M p) (i : Fin n) (k : ℕ)
    (hi : kind i = Sum.inr k) (x : Z → M.domain i) (hx : Measurable x) :
    (rho.prod (gumbelInputs k)).map (fun z =>
      M.categoricalLabel i k hi (x z.1).val (WithLp.toLp 1 z.2)) =
      ∑ j : Fin k, ENNReal.ofReal (∫ z, (p i (x z).val).ofLp
        (Fin.cast (congrArg outputDim hi).symm j) / ∑ l, (p i (x z).val).ofLp l ∂rho) •
          Measure.dirac j := by
  let w : Z → L1Vec k := fun z => WithLp.toLp 1 (fun j =>
    (p i (x z).val).ofLp (Fin.cast (congrArg outputDim hi).symm j) /
      ∑ l, (p i (x z).val).ofLp l)
  have hw : Measurable w :=
    (categorical_normalized_propensity_measurable M p hcat i k hi).comp hx
  let hk := fun m hm => M.categoricalPositive i m (hi.trans hm)
  have hws (z : Z) : (w z).ofLp ∈ probabilitySimplex k := by
    have hp := canonical_normalized_mem_simplex (p i (x z).val).ofLp
      (hcat.1 i k hi (x z).val (x z).property).1
      (hcat.1 i k hi (x z).val (x z).property).2
    refine ⟨fun j => hp.1 _, ?_⟩
    exact (Equiv.sum_comp (finCongr (congrArg outputDim hi).symm)
      (fun j => (p i (x z).val).ofLp j / ∑ l, (p i (x z).val).ofLp l)).trans hp.2
  have hF : Measurable (fun z : Z × (Fin k → ℝ) =>
      M.categoricalLabel i k hi (x z.1).val (WithLp.toLp 1 z.2)) := by fun_prop
  have hH : Measurable (fun z : Z × (Fin k → ℝ) =>
      canonicalSelector (.inr k) hk (w z.1) (WithLp.toLp 1 z.2)) := by
    apply firstArgmax_getD_measurable
    intro j
    fun_prop
  let := gumbelInputs_probability k
  refine Eq.trans ?_ (privateBlock_canonicalSelector_mixture
    (Y := Fin k) rho hk w hw (Filter.Eventually.of_forall hws) id)
  ext s hs
  dsimp only [id]
  erw [Measure.map_apply hF hs, Measure.prod_apply (hs.preimage hF),
    Measure.map_apply hH hs, Measure.prod_apply (hs.preimage hH)]
  apply lintegral_congr
  intro z
  have h := congrArg (fun mu : Measure (Fin k) => mu s)
    (Measure.map_congr (categoricalLabel_ae_normalized_selector
      M p hcat i k hi (x z).val (x z).property))
  erw [Measure.map_apply (hF.comp measurable_prodMk_left) hs,
    Measure.map_apply (hH.comp measurable_prodMk_left) hs] at h
  exact h

end
end Papers.TbsNeuralCausalPi
