module
public import Papers.TbsNeuralCausalPi.Helpers.SimulationNetworkHistories
/-! # Terminal grid comparisons after counted activation histories

The activation history and the final output tests use the same parameter
assignment. Terminal tests are counted separately on each activation region,
so their cost is one polynomial sign bound, rather than one per grid point.
-/
@[expose] public section
namespace Papers.TbsNeuralCausalPi
noncomputable section

-- @node: simulationTerminalPatternEnvelope
/-- Given [a finite set of parameter labels](hyp:S), [layer comparison polynomials
depending on earlier comparison histories](hyp:p), [terminal comparison polynomials
depending on the completed history](hyp:q), and [a number of layers](hyp:t), the
[finite envelope of history and terminal-pattern pairs](goal) attaches every
attainable terminal pattern to each history in the layer envelope, after renaming
all parameters into the finite set with one extra default coordinate. -/
def simulationTerminalPatternEnvelope {I J V : Type*} [Fintype I] [Fintype J]
    (S : Finset V)
    (p : ℕ → List (I → Bool × Bool) → I → MvPolynomial V ℝ)
    (q : List (I → Bool × Bool) → J → MvPolynomial V ℝ) (t : ℕ) :
    Finset (List (I → Bool × Bool) × (J → Bool × Bool)) := by
  classical
  exact (simulationLayerPatternEnvelope
    (fun k s i => simulationFinitePolynomial S (p k s i)) t).biUnion (fun s =>
      (simulationPolynomialPatternFinset (fun j => simulationFinitePolynomial S (q s j))).image
        (fun a => (s, a)))

-- @node: simulationTerminalPatternEnvelope_mem
/-- If [all layer polynomials use only parameters in the finite set](hyp:hp) and
[all terminal polynomials do so as well](hyp:hq), then [the history and terminal
comparison pattern generated by any one shared parameter assignment belong to
the terminal-pattern envelope at the chosen depth](goal). -/
lemma simulationTerminalPatternEnvelope_mem {I J V : Type*} [Fintype I] [Fintype J]
    (S : Finset V)
    (p : ℕ → List (I → Bool × Bool) → I → MvPolynomial V ℝ)
    (q : List (I → Bool × Bool) → J → MvPolynomial V ℝ)
    (hp : ∀ k s i, (p k s i).vars ⊆ S)
    (hq : ∀ s j, (q s j).vars ⊆ S) (theta : V → ℝ) (t : ℕ) :
    (simulationLayerPatternHistory p theta t,
      polynomialComparisonPattern (q (simulationLayerPatternHistory p theta t)) theta) ∈
        simulationTerminalPatternEnvelope S p q t := by
  classical
  have hh := simulationLayerPatternHistory_finite_parameters S p hp theta t
  unfold simulationTerminalPatternEnvelope
  apply Finset.mem_biUnion.mpr
  refine ⟨_, ?_, Finset.mem_image.mpr ⟨_, ?_, rfl⟩⟩
  · rw [← hh]
    exact simulationLayerPatternHistory_mem _ _ _
  · apply (simulationPolynomialPatternFinset_mem _ _).mpr
    refine ⟨simulationFiniteAssignment S theta, ?_⟩
    funext j
    simp only [polynomialComparisonPattern, simulationFinitePolynomial_eval S _ (hq _ j) theta]

-- @node: simulationTerminalPatternEnvelope_card_le
/-- If [each layer polynomial before depth t has degree at most d](hyp:hp) and
[each terminal polynomial has degree at most e](hyp:hq), then [the number of
history and terminal-pattern pairs in the envelope is at most
$(8|I|\max(d,1)+5)^{(|S|+2)t}(8|J|\max(e,1)+5)^{|S|+2}$](goal), where
$|S|$ is the number of retained parameters and $|I|$ and $|J|$ count the layer
and terminal tests. -/
lemma simulationTerminalPatternEnvelope_card_le {I J V : Type*} [Fintype I] [Fintype J]
    (S : Finset V)
    (p : ℕ → List (I → Bool × Bool) → I → MvPolynomial V ℝ)
    (q : List (I → Bool × Bool) → J → MvPolynomial V ℝ)
    (d e t : ℕ) (hp : ∀ k < t, ∀ s i, (p k s i).totalDegree ≤ d)
    (hq : ∀ s j, (q s j).totalDegree ≤ e) :
    (simulationTerminalPatternEnvelope S p q t).card ≤
      (8 * Fintype.card I * max d 1 + 5) ^ ((S.card + 2) * t) *
        (8 * Fintype.card J * max e 1 + 5) ^ (S.card + 2) := by
  classical
  let E := simulationLayerPatternEnvelope
    (fun k s i => simulationFinitePolynomial S (p k s i)) t
  have hE := simulationLayerPatternEnvelope_card_le
    (fun k s i => simulationFinitePolynomial S (p k s i)) d t
    (fun k hk s i => (simulationFinitePolynomial_degree S _).trans (hp k hk s i))
  have hq' (s) := simulationPolynomialPatternFinset_card_le
    (fun j => simulationFinitePolynomial S (q s j)) e
    (fun j => (simulationFinitePolynomial_degree S _).trans (hq s j))
  simp only [simulationFinitePolynomial_card, Nat.add_assoc] at hE hq'
  calc
    _ ≤ ∑ s ∈ E,
        ((simulationPolynomialPatternFinset
          (fun j => simulationFinitePolynomial S (q s j))).image (fun a => (s, a))).card :=
      Finset.card_biUnion_le
    _ ≤ ∑ _s ∈ E, (8 * Fintype.card J * max e 1 + 5) ^ (S.card + 2) :=
      Finset.sum_le_sum (fun s _ => Finset.card_image_le.trans (hq' s))
    _ = E.card * (8 * Fintype.card J * max e 1 + 5) ^ (S.card + 2) := by simp
    _ ≤ _ := Nat.mul_le_mul_right _ hE

-- @node: simulationTerminalPatterns_encard_le
/-- If [all layer polynomials use only parameters in S](hyp:hp), [all terminal
polynomials use only parameters in S](hyp:hq), [layer polynomials before depth t
have degree at most d](hyp:hd), and [terminal polynomials have degree at most
e](hyp:he), then [the number of terminal weak and strict sign patterns obtained
by varying one assignment shared with the layer history is at most
$(8|I|\max(d,1)+5)^{(|S|+2)t}(8|J|\max(e,1)+5)^{|S|+2}$](goal).

Here $|I|$ and $|J|$ count the layer and terminal tests, and $|S|$ counts the
retained parameters. -/
lemma simulationTerminalPatterns_encard_le {I J V : Type*} [Fintype I] [Fintype J]
    (S : Finset V)
    (p : ℕ → List (I → Bool × Bool) → I → MvPolynomial V ℝ)
    (q : List (I → Bool × Bool) → J → MvPolynomial V ℝ)
    (hp : ∀ k s i, (p k s i).vars ⊆ S)
    (hq : ∀ s j, (q s j).vars ⊆ S)
    (d e t : ℕ) (hd : ∀ k < t, ∀ s i, (p k s i).totalDegree ≤ d)
    (he : ∀ s j, (q s j).totalDegree ≤ e) :
    (Set.range (fun theta => polynomialComparisonPattern
      (q (simulationLayerPatternHistory p theta t)) theta)).encard ≤
      ((8 * Fintype.card I * max d 1 + 5) ^ ((S.card + 2) * t) *
        (8 * Fintype.card J * max e 1 + 5) ^ (S.card + 2) : ℕ) := by
  have hsub : Set.range (fun theta => polynomialComparisonPattern
      (q (simulationLayerPatternHistory p theta t)) theta) ⊆
      Prod.snd '' (↑(simulationTerminalPatternEnvelope S p q t) :
        Set (List (I → Bool × Bool) × (J → Bool × Bool))) := by
    rintro _ ⟨theta, rfl⟩
    exact ⟨_, simulationTerminalPatternEnvelope_mem S p q hp hq theta t, rfl⟩
  exact (Set.encard_mono hsub).trans ((Set.encard_image_le _ _).trans
    (by exact_mod_cast simulationTerminalPatternEnvelope_card_le S p q d e t hd he))

-- @node: simulationHistoryGridPolynomial
/-- For [a ReLU network](hyp:q), [a finite input sample](hyp:sample), [a choice
of sample point and output coordinate for each grid test](hyp:coord),
[a threshold for each test](hyp:threshold), [a fixed activation comparison
history](hyp:s), and [a test index](hyp:j), the [grid comparison polynomial](goal)
is the network's output polynomial under that history at the selected point
and coordinate, minus the selected threshold. -/
def simulationHistoryGridPolynomial {din dout W L m : ℕ} {J : Type*}
    (q : ReLUNet din dout W L) (sample : Fin m → L1Vec din)
    (coord : J → Fin m × Fin dout) (threshold : J → ℝ)
    (s : List (Fin m × Fin W → Bool × Bool)) (j : J) :
    MvPolynomial (ℕ × ℕ × ℕ) ℝ :=
  simulationHistoryOutputPolynomial q sample s (coord j).1 (coord j).2 -
    MvPolynomial.C (threshold j)

-- @node: simulationHistoryGridPolynomial_degree
/-- [For any fixed activation history and grid test, the output-minus-threshold
polynomial of a network with L hidden layers has total degree at most
L plus one](goal). -/
lemma simulationHistoryGridPolynomial_degree {din dout W L m : ℕ} {J : Type*}
    (q : ReLUNet din dout W L) (sample : Fin m → L1Vec din)
    (coord : J → Fin m × Fin dout) (threshold : J → ℝ)
    (s : List (Fin m × Fin W → Bool × Bool)) (j : J) :
    (simulationHistoryGridPolynomial q sample coord threshold s j).totalDegree ≤ L + 1 :=
  (MvPolynomial.totalDegree_sub_C_le _ _).trans
    (simulationHistoryOutputPolynomial_degree q sample s _ _)

-- @node: simulationHistoryGridPolynomial_vars
/-- If [the input dimension is at most w](hyp:hdin), [the output dimension is
at most w](hyp:hdout), and [the hidden-width bound is at most w](hyp:hW), then
[every parameter occurring in any fixed-history grid comparison polynomial
lies in the common parameter box for L plus one affine layers of width
at most w](goal). -/
lemma simulationHistoryGridPolynomial_vars {din dout W L m : ℕ} {J : Type*}
    (q : ReLUNet din dout W L) (sample : Fin m → L1Vec din)
    (coord : J → Fin m × Fin dout) (threshold : J → ℝ)
    (s : List (Fin m × Fin W → Bool × Bool)) (j : J)
    (w : ℕ) (hdin : din ≤ w) (hdout : dout ≤ w) (hW : W ≤ w) :
    (simulationHistoryGridPolynomial q sample coord threshold s j).vars ⊆
      simulationParameterBox (L + 1) w := by
  apply (MvPolynomial.vars_sub_subset (p := _) (q := _)).trans
  simp only [MvPolynomial.vars_C, Finset.union_empty]
  exact simulationHistoryOutputPolynomial_vars q sample s _ _ w hdin hdout hW

-- @node: simulationHistoryGridPolynomial_actual
/-- [Evaluating a grid comparison polynomial at the network's stored parameters,
using the activation history generated by those same parameters, gives the
network's actual output at the selected sample point and output coordinate
minus the test threshold](goal). -/
lemma simulationHistoryGridPolynomial_actual {din dout W L m : ℕ} {J : Type*}
    (q : ReLUNet din dout W L) (sample : Fin m → L1Vec din)
    (coord : J → Fin m × Fin dout) (threshold : J → ℝ) (j : J) :
    MvPolynomial.eval (simulationNetworkParameters q)
      (simulationHistoryGridPolynomial q sample coord threshold
        (simulationLayerPatternHistory
          (simulationHistoryTests (w := W) (simulationStoredLayers q)
            (fun a => simulationInputPolynomial (sample a)))
          (simulationNetworkParameters q) L) j) =
      (q.eval (sample (coord j).1)).ofLp (coord j).2 - threshold j := by
  rw [simulationHistoryGridPolynomial, map_sub, MvPolynomial.eval_C,
    simulationHistoryOutputPolynomial_actual]

-- @node: simulationNetwork_grid_patterns_encard_le
/-- If [the input dimension is at most w](hyp:hdin), [the output dimension is
at most w](hyp:hdout), and [the hidden-width bound W is at most w](hyp:hW), then
[the number of grid comparison patterns obtained by varying a shared parameter
assignment for a prototype network's activation history and terminal tests is
at most $(8mW\max(L,1)+5)^{(P+2)L}(8|J|(L+1)+5)^{P+2}$, where
$P=(L+1)w(w+1)$, m is the sample size, L is the number of hidden layers, and
$|J|$ is the number of grid tests](goal). -/
lemma simulationNetwork_grid_patterns_encard_le {din dout W L m : ℕ}
    {J : Type*} [Fintype J]
    (q : ReLUNet din dout W L) (sample : Fin m → L1Vec din)
    (coord : J → Fin m × Fin dout) (threshold : J → ℝ)
    (w : ℕ) (hdin : din ≤ w) (hdout : dout ≤ w) (hW : W ≤ w) :
    (Set.range (fun theta => polynomialComparisonPattern
      (simulationHistoryGridPolynomial q sample coord threshold
        (simulationLayerPatternHistory
          (simulationHistoryTests (w := W) (simulationStoredLayers q)
            (fun a => simulationInputPolynomial (sample a))) theta L)) theta)).encard ≤
      ((8 * (m * W) * max L 1 + 5) ^ (((L + 1) * (w * (w + 1)) + 2) * L) *
        (8 * Fintype.card J * (L + 1) + 5) ^ ((L + 1) * (w * (w + 1)) + 2) : ℕ) := by
  let z := fun a => simulationInputPolynomial (sample a)
  let p := fun k s aj => if k < L then
    simulationHistoryTests (w := W) (simulationStoredLayers q) z k s aj else 0
  have hh (theta) : simulationLayerPatternHistory p theta L =
      simulationLayerPatternHistory
        (simulationHistoryTests (w := W) (simulationStoredLayers q) z) theta L := by
    apply simulationLayerPatternHistory_congr_prefix
    intro k hk s
    funext aj
    simp only [p, if_pos hk]
  have hl (k) (hk : k < L) := simulationStoredLayers_dimensions q w hdin hW k hk
  have hbox (k) (hk : k < L) :
      simulationLayerVariables k (simulationStoredLayers q k).input
        (simulationStoredLayers q k).output ⊆ simulationParameterBox (L + 1) w :=
    simulationLayerVariables_subset_box (by omega) (hl k hk).1 (hl k hk).2
  have h := simulationTerminalPatterns_encard_le (simulationParameterBox (L + 1) w) p
    (simulationHistoryGridPolynomial q sample coord threshold)
    (by
      intro k s aj
      dsimp only [p]
      split_ifs with hk
      · exact simulationHistoryTests_vars _ z _ (fun _ _ => by simp [z, simulationInputPolynomial])
          L hbox k hk s aj
      · simp)
    (fun s j => simulationHistoryGridPolynomial_vars q sample coord threshold s j w hdin hdout hW)
    L (L + 1) L
    (by
      intro k hk s aj
      dsimp only [p]
      rw [if_pos hk]
      exact (simulationHistoryTests_degree _ z 0
        (fun _ _ => by simp [z, simulationInputPolynomial]) k s aj).trans (by omega))
    (simulationHistoryGridPolynomial_degree q sample coord threshold)
  have hcard : (simulationParameterBox (L + 1) w).card = (L + 1) * (w * (w + 1)) := by
    simp [simulationParameterBox]
  simpa only [hh, Fintype.card_prod, Fintype.card_fin, hcard,
    Nat.mul_assoc, max_eq_left (by omega : 1 ≤ L + 1)]
    using h

-- @node: simulationAffinePolynomial_shape_congr
/-- If two affine layers [have equal input dimensions](hyp:hi) and [equal output
dimensions](hyp:ho), then [their symbolic affine output polynomials agree at
every layer index and output coordinate for the same input polynomials](goal).

Stored numerical weights enter only through the assignment at evaluation. -/
lemma simulationAffinePolynomial_shape_congr (l r : AffineLayer)
    (hi : l.input = r.input) (ho : l.output = r.output) (k : ℕ)
    (z : ℕ → MvPolynomial (ℕ × ℕ × ℕ) ℝ) (j : ℕ) :
    simulationAffinePolynomial l k z j = simulationAffinePolynomial r k z j := by
  unfold simulationAffinePolynomial
  rcases l with ⟨a, b, weight, bias⟩
  rcases r with ⟨c, d, weight', bias'⟩
  dsimp [AffineLayer.input, AffineLayer.output] at hi ho
  subst c
  subst d
  rfl

-- @node: simulationHistoryState_shape_congr
/-- If [two layer sequences have the same input and output dimensions at every
layer before depth t](hyp:hshape), then [replaying any fixed activation history
from the same input polynomials produces identical state polynomials at depth
t for every sample point and coordinate](goal). -/
lemma simulationHistoryState_shape_congr {m w : ℕ} (layers other : ℕ → AffineLayer)
    (z : Fin m → ℕ → MvPolynomial (ℕ × ℕ × ℕ) ℝ) (t : ℕ)
    (hshape : ∀ k < t, (layers k).input = (other k).input ∧
      (layers k).output = (other k).output)
    (s : List (Fin m × Fin w → Bool × Bool)) (a : Fin m) (j : ℕ) :
    simulationHistoryState layers z t s a j = simulationHistoryState other z t s a j := by
  induction t generalizing s j with
  | zero => rfl
  | succ t ih =>
    have hz : simulationHistoryState layers z t s.tail a =
        simulationHistoryState other z t s.tail a :=
      funext (fun j => ih (fun k hk => hshape k (by omega)) s.tail j)
    simp only [simulationHistoryState, hz, simulationReluPolynomial]
    rw [simulationAffinePolynomial_shape_congr _ _ (hshape t (by omega)).1
      (hshape t (by omega)).2]

-- @node: simulationHistoryTests_shape_congr
/-- If [two layer sequences have the same input and output dimensions before
depth t](hyp:hshape) and [the tested layer k is before that depth](hyp:hk), then
[their layer-k comparison polynomials agree for the same input polynomials and
activation history, at every sampled point and hidden coordinate](goal). -/
lemma simulationHistoryTests_shape_congr {m w : ℕ} (layers other : ℕ → AffineLayer)
    (z : Fin m → ℕ → MvPolynomial (ℕ × ℕ × ℕ) ℝ) (t : ℕ)
    (hshape : ∀ k < t, (layers k).input = (other k).input ∧
      (layers k).output = (other k).output) (k : ℕ) (hk : k < t)
    (s : List (Fin m × Fin w → Bool × Bool)) :
    simulationHistoryTests layers z k s = simulationHistoryTests other z k s := by
  funext aj
  have hz : simulationHistoryState layers z k s aj.1 =
      simulationHistoryState other z k s aj.1 :=
    funext (simulationHistoryState_shape_congr layers other z k
      (fun r hr => hshape r (hr.trans hk)) s aj.1)
  simp only [simulationHistoryTests, hz,
    simulationAffinePolynomial_shape_congr _ _ (hshape k hk).1 (hshape k hk).2]

-- @node: simulationSameNetworkShape
/-- [Two ReLU networks with common dimension, width, and depth bounds](hyp:q,r)
[have the same shape](goal) when [their final hidden widths agree](step:1) and
[their stored affine layers have equal input and output dimensions at every
index below the hidden-depth bound](step:2). -/
def simulationSameNetworkShape {din dout W L : ℕ} (q r : ReLUNet din dout W L) : Prop :=
  finalWidth din q.hidden = finalWidth din r.hidden ∧
    ∀ k < L, (simulationStoredLayers q k).input = (simulationStoredLayers r k).input ∧
      (simulationStoredLayers q k).output = (simulationStoredLayers r k).output

-- @node: simulationSameNetworkShape_refl
/-- [Every ReLU network has the same shape as itself](goal). -/
lemma simulationSameNetworkShape_refl {din dout W L : ℕ} (q : ReLUNet din dout W L) :
    simulationSameNetworkShape q q := ⟨rfl, fun _ _ => ⟨rfl, rfl⟩⟩

-- @node: simulationHistoryOutputPolynomial_shape_congr
/-- If [two ReLU networks have the same shape](hyp:hshape), then [their symbolic
output polynomials agree for any common sample, fixed activation history,
sample point, and output coordinate](goal). -/
lemma simulationHistoryOutputPolynomial_shape_congr {din dout W L m : ℕ}
    (q r : ReLUNet din dout W L) (hshape : simulationSameNetworkShape q r)
    (sample : Fin m → L1Vec din) (s : List (Fin m × Fin W → Bool × Bool))
    (a : Fin m) (j : Fin dout) :
    simulationHistoryOutputPolynomial q sample s a j =
      simulationHistoryOutputPolynomial r sample s a j := by
  have hz : simulationHistoryState (simulationStoredLayers q)
      (fun a => simulationInputPolynomial (sample a)) L s a =
      simulationHistoryState (simulationStoredLayers r)
        (fun a => simulationInputPolynomial (sample a)) L s a :=
    funext (simulationHistoryState_shape_congr _ _ _ L hshape.2 s a)
  unfold simulationHistoryOutputPolynomial
  rw [hz]
  have hf := hshape.1
  generalize finalWidth din q.hidden = a at *
  generalize finalWidth din r.hidden = b at *
  have hab : a = b := hf
  subst b
  rfl

-- @node: simulationNetwork_grid_pattern_same_shape
/-- If [a prototype network and a second network have the same shape](hyp:hshape),
then [the prototype's grid polynomial comparison pattern, with both the history
and evaluation determined by the second network's stored parameters, equals
the second network's actual weak and strict output-to-threshold comparisons
at every selected sample point and output coordinate](goal). -/
lemma simulationNetwork_grid_pattern_same_shape {din dout W L m : ℕ} {J : Type*}
    (q r : ReLUNet din dout W L) (hshape : simulationSameNetworkShape q r)
    (sample : Fin m → L1Vec din) (coord : J → Fin m × Fin dout) (threshold : J → ℝ) :
    polynomialComparisonPattern
      (simulationHistoryGridPolynomial q sample coord threshold
        (simulationLayerPatternHistory
          (simulationHistoryTests (w := W) (simulationStoredLayers q)
            (fun a => simulationInputPolynomial (sample a)))
          (simulationNetworkParameters r) L)) (simulationNetworkParameters r) =
      fun j => (decide ((r.eval (sample (coord j).1)).ofLp (coord j).2 ≤ threshold j),
        decide ((r.eval (sample (coord j).1)).ofLp (coord j).2 < threshold j)) := by
  have hh : simulationLayerPatternHistory
      (simulationHistoryTests (w := W) (simulationStoredLayers q)
        (fun a => simulationInputPolynomial (sample a))) (simulationNetworkParameters r) L =
      simulationLayerPatternHistory
        (simulationHistoryTests (w := W) (simulationStoredLayers r)
          (fun a => simulationInputPolynomial (sample a))) (simulationNetworkParameters r) L := by
    apply simulationLayerPatternHistory_congr_prefix
    intro k hk s
    exact simulationHistoryTests_shape_congr _ _ _ L hshape.2 k hk s
  funext j
  simp only [polynomialComparisonPattern, hh, simulationHistoryGridPolynomial,
    simulationHistoryOutputPolynomial_shape_congr q r hshape,
    map_sub, MvPolynomial.eval_C, simulationHistoryOutputPolynomial_actual,
    sub_nonpos, sub_neg]

-- @node: simulationNetwork_same_shape_grid_patterns_encard_le
/-- If [the input dimension is at most w](hyp:hdin), [the output dimension is
at most w](hyp:hdout), and [the hidden-width bound W is at most w](hyp:hW), then
[the number of distinct weak and strict grid comparison patterns realized by
networks of the prototype's shape is at most
$(8mW\max(L,1)+5)^{(P+2)L}(8|J|(L+1)+5)^{P+2}$, where
$P=(L+1)w(w+1)$, m is the sample size, L is the hidden-depth bound, and $|J|$
is the number of grid tests](goal). -/
lemma simulationNetwork_same_shape_grid_patterns_encard_le {din dout W L m : ℕ}
    {J : Type*} [Fintype J]
    (q : ReLUNet din dout W L) (sample : Fin m → L1Vec din)
    (coord : J → Fin m × Fin dout) (threshold : J → ℝ)
    (w : ℕ) (hdin : din ≤ w) (hdout : dout ≤ w) (hW : W ≤ w) :
    {s | ∃ r : ReLUNet din dout W L, simulationSameNetworkShape q r ∧
      (fun j => (decide ((r.eval (sample (coord j).1)).ofLp (coord j).2 ≤ threshold j),
        decide ((r.eval (sample (coord j).1)).ofLp (coord j).2 < threshold j))) = s}.encard ≤
      ((8 * (m * W) * max L 1 + 5) ^ (((L + 1) * (w * (w + 1)) + 2) * L) *
        (8 * Fintype.card J * (L + 1) + 5) ^ ((L + 1) * (w * (w + 1)) + 2) : ℕ) := by
  apply (Set.encard_mono (b := Set.range (fun theta => polynomialComparisonPattern
      (simulationHistoryGridPolynomial q sample coord threshold
        (simulationLayerPatternHistory
          (simulationHistoryTests (w := W) (simulationStoredLayers q)
            (fun a => simulationInputPolynomial (sample a))) theta L)) theta)) ?_).trans
    (simulationNetwork_grid_patterns_encard_le q sample coord threshold w hdin hdout hW)
  rintro s ⟨r, hs, rfl⟩
  exact ⟨simulationNetworkParameters r,
    simulationNetwork_grid_pattern_same_shape q r hs sample coord threshold⟩

-- @node: simulationNetwork_same_shape_grid_readout_encard_le
/-- If [the input dimension is at most w](hyp:hdin), [the output dimension is
at most w](hyp:hdout), and [the hidden-width bound W is at most w](hyp:hW), then
[applying any fixed decoding rule to the weak and strict grid comparisons of
networks of the prototype's shape yields at most
$(8mW\max(L,1)+5)^{(P+2)L}(8|J|(L+1)+5)^{P+2}$ distinct readouts, where
$P=(L+1)w(w+1)$, m is the sample size, L is the hidden-depth bound, and $|J|$
is the number of grid tests](goal). -/
lemma simulationNetwork_same_shape_grid_readout_encard_le {din dout W L m : ℕ}
    {J A : Type*} [Fintype J]
    (q : ReLUNet din dout W L) (sample : Fin m → L1Vec din)
    (coord : J → Fin m × Fin dout) (threshold : J → ℝ)
    (decode : (J → Bool × Bool) → A)
    (w : ℕ) (hdin : din ≤ w) (hdout : dout ≤ w) (hW : W ≤ w) :
    {s | ∃ r : ReLUNet din dout W L, simulationSameNetworkShape q r ∧
      decode (fun j =>
        (decide ((r.eval (sample (coord j).1)).ofLp (coord j).2 ≤ threshold j),
          decide ((r.eval (sample (coord j).1)).ofLp (coord j).2 < threshold j))) = s}.encard ≤
      ((8 * (m * W) * max L 1 + 5) ^ (((L + 1) * (w * (w + 1)) + 2) * L) *
        (8 * Fintype.card J * (L + 1) + 5) ^ ((L + 1) * (w * (w + 1)) + 2) : ℕ) := by
  apply (Set.encard_mono (b := decode '' {s | ∃ r : ReLUNet din dout W L,
      simulationSameNetworkShape q r ∧ (fun j =>
        (decide ((r.eval (sample (coord j).1)).ofLp (coord j).2 ≤ threshold j),
          decide ((r.eval (sample (coord j).1)).ofLp (coord j).2 < threshold j))) = s}) ?_).trans
    ((Set.encard_image_le _ _).trans
      (simulationNetwork_same_shape_grid_patterns_encard_le
        q sample coord threshold w hdin hdout hW))
  rintro s ⟨r, hs, rfl⟩
  exact ⟨_, ⟨r, hs, rfl⟩, rfl⟩

-- @node: simulationNetwork_same_shape_clipped_patterns_encard_le
/-- If [the input dimension is at most w](hyp:hdin), [the output dimension is
at most w](hyp:hdout), and [the hidden-width bound W is at most w](hyp:hW), then
[the number of weak and strict grid comparison patterns realized by networks
of the prototype's shape after clipping their outputs by first taking the
minimum with K and then the maximum with minus K is at most
$(8mW\max(L,1)+5)^{(P+2)L}(8|J|(L+1)+5)^{P+2}$, where
$P=(L+1)w(w+1)$, m is the sample size, L is the hidden-depth bound, and $|J|$
is the number of grid tests](goal). -/
lemma simulationNetwork_same_shape_clipped_patterns_encard_le {din dout W L m : ℕ}
    {J : Type*} [Fintype J]
    (q : ReLUNet din dout W L) (sample : Fin m → L1Vec din)
    (coord : J → Fin m × Fin dout) (threshold : J → ℝ) (K : ℝ)
    (w : ℕ) (hdin : din ≤ w) (hdout : dout ≤ w) (hW : W ≤ w) :
    {s | ∃ r : ReLUNet din dout W L, simulationSameNetworkShape q r ∧
      (fun j =>
        (decide ((truncK K (r.eval (sample (coord j).1))).ofLp (coord j).2 ≤ threshold j),
          decide ((truncK K (r.eval (sample (coord j).1))).ofLp
            (coord j).2 < threshold j))) = s}.encard ≤
      ((8 * (m * W) * max L 1 + 5) ^ (((L + 1) * (w * (w + 1)) + 2) * L) *
        (8 * Fintype.card J * (L + 1) + 5) ^ ((L + 1) * (w * (w + 1)) + 2) : ℕ) := by
  classical
  let decode : (J → Bool × Bool) → (J → Bool × Bool) := fun s j =>
    (decide (-K ≤ threshold j) && (decide (K ≤ threshold j) || (s j).1),
      decide (-K < threshold j) && (decide (K < threshold j) || (s j).2))
  have heq (r : ReLUNet din dout W L) : decode (fun j =>
        (decide ((r.eval (sample (coord j).1)).ofLp (coord j).2 ≤ threshold j),
          decide ((r.eval (sample (coord j).1)).ofLp (coord j).2 < threshold j))) =
      fun j =>
        (decide ((truncK K (r.eval (sample (coord j).1))).ofLp (coord j).2 ≤ threshold j),
          decide ((truncK K (r.eval (sample (coord j).1))).ofLp (coord j).2 < threshold j)) := by
    funext j
    simp only [decode, truncK, WithLp.ofLp_toLp, max_le_iff, min_le_iff,
      max_lt_iff, min_lt_iff, Bool.decide_and, Bool.decide_or, Bool.or_comm]
  have h := simulationNetwork_same_shape_grid_readout_encard_le
    q sample coord threshold decode w hdin hdout hW
  simpa only [heq] using h

end
