module
public import Papers.TbsNeuralCausalPi.Helpers.CausalTablePatterns
public import Papers.TbsNeuralCausalPi.Helpers.NetworkBorelParameters
public import Papers.TbsNeuralCausalPi.Setup.Optimization
/-! # Borel families of causal-table indicators

Replacing generator weights preserves the reference structural equations.
The indicator reads only the generated grid cell and the original private
Gumbels, so arbitrary structural function spaces never enter its parameters.
-/
@[expose] public section
namespace Papers.TbsNeuralCausalPi
open MeasureTheory
open scoped NNReal
noncomputable section
variable {n b : ℕ} {kind : Fin n → NodeKind} {dims counts : Fin b → ℕ}
  {dag : Causalean.Graph.DAG (Fin n)} {G : SimpleGraph (Fin n)}
  {C : Fin b → Set (Fin n)}

-- @node: ncmWithGenerators
/-- From [a reference neural causal model](hyp:R0) and [replacement block generators](hyp:g)
that [belong to the prescribed generator classes](hyp:hmem) and [are realizable by neural generators](hyp:hreal),
[the model with replaced generators](goal) keeps the reference structural equations and uses the distributions induced by the replacement generators as its block laws. -/
def ncmWithGenerators {F0 : StructuralClass kind dims dag C}
    {F1 : GeneratorClass dims counts}
    (R0 : NCMIn kind dims dag G C counts F0 F1)
    (g : ∀ j, ((Fin (counts j) → ℝ) × (Fin (counts j) → ℝ)) → L1Vec (dims j))
    (hmem : ∀ j, g j ∈ F1 j) (hreal : ∀ j, NeuralGeneratorRealizable (g j)) :
    NCMIn kind dims dag G C counts F0 F1 where
  canonical := { R0.canonical with
    blockLaw := fun j => by
      letI := generatorInputLaw_probability (counts j)
      exact ⟨(generatorInputLaw (counts j)).map (g j),
        Measure.isProbabilityMeasure_map (hreal j).measurable.aemeasurable⟩ }
  rawStructural := R0.rawStructural
  structuralMem := R0.structuralMem
  structuralNetworks := R0.structuralNetworks
  continuousEq := R0.continuousEq
  categoricalEq := R0.categoricalEq
  generator := g
  generatorMem := hmem
  generatorNetworks := hreal
  blockLaw_eq := fun _ => rfl

-- @node: ncmWithThreePartGenerators
/-- Given [blockwise component dimensions](hyp:dC), [a truncation radius](hyp:K),
[a base width](hyp:dU), [two width multipliers](hyp:c1,c2), [a resolution index](hyp:r0),
[two depth schedules](hyp:L1,L2), [a temperature schedule](hyp:tau),
[a reference model in the resulting generator class](hyp:R0), and [three-part generators of the corresponding sizes](hyp:q),
[the replacement model](goal) retains the reference structural equations and replaces each generator by the truncated evaluation of its three-part generator. -/
def ncmWithThreePartGenerators {F0 : StructuralClass kind dims dag C}
    (dC : ∀ j, Fin (counts j) → ℕ) (K : ℝ≥0) (dU c1 c2 r0 : ℕ)
    (L1 L2 : ℕ → ℕ) (tau : ℕ → ℝ)
    (R0 : NCMIn kind dims dag G C counts F0
      (generatorClassN counts dC K dU c1 c2 L1 L2 tau r0))
    (q : ∀ j, ThreePartGenerator (counts j) (dims j) (dC j)
      (c1 * dU) (L1 r0) (c2 * dU ^ 2) (L2 r0) (tau r0)) :
    NCMIn kind dims dag G C counts F0
      (generatorClassN counts dC K dU c1 c2 L1 L2 tau r0) :=
  ncmWithGenerators R0 (fun j => truncK K ∘ (q j).eval)
    (fun j => ⟨q j, rfl⟩)
    (fun j => Or.inr ⟨dC j, _, _, _, _, tau r0, q j, Or.inr ⟨K, rfl⟩⟩)

-- @node: ncmCausalTableIndicator_eq_reference_readout
/-- For [a categorical probability table](hyp:table),
[the causal-table indicator at a simulation input equals the reference model's indicator with its grid code held constant at the cell generated by the original model](goal). -/
lemma ncmCausalTableIndicator_eq_reference_readout
    {F0 : StructuralClass kind dims dag C} {F1 : GeneratorClass dims counts}
    (R R0 : NCMIn kind dims dag G C counts F0 F1)
    {s : ℕ} (code : Latent dims → Fin s)
    (table : ∀ i k, kind i = Sum.inr k →
      CategoricalStratum kind → Fin s → probabilitySimplex k)
    (a : ℝ) (t : Option (Finset (Fin s × CategoricalStratum kind)))
    (z : SimulationInput kind counts) :
    ncmCausalTableIndicator R code table a t z =
      ncmCausalTableIndicator R0
        (fun _ => code (jointNonGumbel (ncmSimulationExogenous R z))) table a t z := by
  classical
  cases t with
  | none =>
    change decide (z ∈ ncmCausalTableAmbiguity R code table a) = _
    exact congrArg (fun P : Prop => decide P)
      ((ncmCausalTableAmbiguity_reference R R0 code table a z).trans
      (ncmCausalTableAmbiguity_reference R0 R0
        (fun _ => code (jointNonGumbel (ncmSimulationExogenous R z))) table a z).symm)
  | some t =>
    simp only [ncmCausalTableIndicator,
      ncmCausalTableType_reference R R0,
      ncmCausalTableType_reference R0 R0]

-- @node: ncmCausalTableIndicator_joint_measurable
/-- If [the generated grid cell is jointly measurable in the model parameter and simulation input](hyp:hcode),
then, for [a finite collection of categorical probability tables](hyp:tables),
[the causal-table indicator is jointly measurable in the model parameter, table, choice of ambiguity or type-subset event, and simulation input, with discrete measurable structures on the finite choices](goal). -/
@[fun_prop] lemma ncmCausalTableIndicator_joint_measurable
    {F0 : StructuralClass kind dims dag C} {F1 : GeneratorClass dims counts}
    {T : Type} [MeasurableSpace T]
    (R : T → NCMIn kind dims dag G C counts F0 F1)
    (R0 : NCMIn kind dims dag G C counts F0 F1)
    {s : ℕ} (code : Latent dims → Fin s)
    (hcode : Measurable (fun p : T × SimulationInput kind counts =>
      code (jointNonGumbel (ncmSimulationExogenous (R p.1) p.2))))
    (tables : Finset (∀ i k, kind i = Sum.inr k →
      CategoricalStratum kind → Fin s → probabilitySimplex k)) (a : ℝ) :
    letI : MeasurableSpace tables := ⊤
    letI : MeasurableSpace (Option (Finset (Fin s × CategoricalStratum kind))) := ⊤
    Measurable (fun p :
        (T × tables × Option (Finset (Fin s × CategoricalStratum kind))) ×
          SimulationInput kind counts =>
      ncmCausalTableIndicator (R p.1.1) code p.1.2.1.val a p.1.2.2 p.2) := by
  classical
  letI : MeasurableSpace tables := ⊤
  letI : MeasurableSpace (Option (Finset (Fin s × CategoricalStratum kind))) := ⊤
  let S := tables × Option (Finset (Fin s × CategoricalStratum kind)) × Fin s
  letI : MeasurableSpace S := inferInstanceAs (MeasurableSpace
    (tables × Option (Finset (Fin s × CategoricalStratum kind)) × Fin s))
  have hread : Measurable (fun p : S × SimulationInput kind counts =>
      ncmCausalTableIndicator R0 (fun _ => p.1.2.2) p.1.1.val a p.1.2.1 p.2) := by
    apply measurable_from_prod_countable_right
    intro idx
    exact ncmCausalTableIndicator_measurable R0 (fun _ => idx.2.2)
      measurable_const idx.1.val a idx.2.1
  have hcell := hcode.comp (show Measurable (fun p :
      (T × tables × Option (Finset (Fin s × CategoricalStratum kind))) ×
        SimulationInput kind counts => (p.1.1, p.2)) by fun_prop)
  let selectors :
      ((T × tables × Option (Finset (Fin s × CategoricalStratum kind))) ×
        SimulationInput kind counts) → S := fun p =>
      (p.1.2.1, p.1.2.2,
        code (jointNonGumbel (ncmSimulationExogenous (R p.1.1) p.2)))
  have hselectors : Measurable selectors := by
    have ht : Measurable (fun p :
      (T × tables × Option (Finset (Fin s × CategoricalStratum kind))) ×
        SimulationInput kind counts => p.1.2.1) := by fun_prop
    have ho : Measurable (fun p :
      (T × tables × Option (Finset (Fin s × CategoricalStratum kind))) ×
        SimulationInput kind counts => p.1.2.2) := by fun_prop
    exact ht.prodMk (ho.prodMk hcell)
  have h := hread.comp (hselectors.prodMk measurable_snd)
  convert h using 1
  funext p
  exact ncmCausalTableIndicator_eq_reference_readout (R p.1.1) R0 code _ a _ _

-- @node: hasPseudoDimAtMost_range
/-- If [the real-valued zero-one functions associated with an indexed Boolean family have pseudo-dimension at most the given bound](hyp:h),
[the same bound holds when that family is indexed by its distinct Boolean functions](goal). -/
lemma hasPseudoDimAtMost_range {X I : Type*} (B : I → X → Bool) {v : ℕ}
    (h : Causalean.Stat.Concentration.HasPseudoDimAtMost
      (fun i x => if B i x then (1 : ℝ) else 0) v) :
    Causalean.Stat.Concentration.HasPseudoDimAtMost
      (fun f : Set.range B => fun x => if f.val x then (1 : ℝ) else 0) v := by
  intro m sample
  have heq : Causalean.Stat.Concentration.growthFamily
      (Causalean.Stat.Concentration.subgraphClassifier
        (fun f : Set.range B => fun x => if f.val x then (1 : ℝ) else 0)) sample =
      Causalean.Stat.Concentration.growthFamily
        (Causalean.Stat.Concentration.subgraphClassifier
          (fun i x => if B i x then (1 : ℝ) else 0)) sample := by
    ext s
    simp only [Causalean.Stat.Concentration.mem_growthFamily_iff]
    constructor
    · rintro ⟨⟨f, i, rfl⟩, hf⟩
      exact ⟨i, hf⟩
    · rintro ⟨i, hi⟩
      exact ⟨⟨B i, Set.mem_range_self i⟩, hi⟩
  rw [heq]
  exact h m sample

end
end Papers.TbsNeuralCausalPi
