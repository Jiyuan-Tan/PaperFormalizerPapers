module
public import Papers.TbsNeuralCausalPi.Helpers.PolynomialCriticalWitnesses
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.LinearAlgebra.FreeModule.Finite.Matrix
public import Mathlib.LinearAlgebra.Dimension.Constructions
public import Mathlib.RingTheory.MvPolynomial.Groebner
public import Mathlib.RingTheory.MvPolynomial.MonomialOrder.DegLex
/-! # Counting polynomial roots through their coordinate algebra

Evaluation embeds the common real zeros of an ideal into the characters
of its quotient. Thus a finite-dimensional quotient bounds the number of
roots by its dimension. Multivariate division proves a product-of-degrees
bound for pure-power leading systems and for higher-power perturbations of
arbitrary systems. Transferring this bound to the original critical witnesses
requires a separate persistence argument; compactness alone does not supply it.
-/
@[expose] public section
namespace Papers.TbsNeuralCausalPi
noncomputable section

-- @node: polynomialIdealZeroSet
/-- For [an ideal of multivariate real polynomials](hyp:J), its [common real
zero set](goal) consists of the points at which every polynomial in the ideal vanishes. -/
def polynomialIdealZeroSet {V : Type*} (J : Ideal (MvPolynomial V ℝ)) :
    Set (V → ℝ) := {a | ∀ p ∈ J, MvPolynomial.eval a p = 0}

-- @node: polynomialQuotientEvaluation
/-- For [a polynomial ideal](hyp:J) and [a common real zero of that ideal](hyp:a),
the [evaluation map on the quotient algebra](goal) sends each polynomial class
to its value at that point. -/
def polynomialQuotientEvaluation {V : Type*} (J : Ideal (MvPolynomial V ℝ))
    (a : polynomialIdealZeroSet J) : (MvPolynomial V ℝ ⧸ J) →ₐ[ℝ] ℝ :=
  Ideal.Quotient.liftₐ J (MvPolynomial.aeval a.val)
    (fun p hp => by simpa using a.property p hp)

-- @node: polynomialQuotientEvaluation_mk
/-- [Evaluating the class of a polynomial in the quotient by an ideal at a common
zero of that ideal gives the value of the original polynomial at that point](goal). -/
lemma polynomialQuotientEvaluation_mk {V : Type*} (J : Ideal (MvPolynomial V ℝ))
    (a : polynomialIdealZeroSet J) (p : MvPolynomial V ℝ) :
    polynomialQuotientEvaluation J a (Ideal.Quotient.mk J p) = MvPolynomial.eval a.val p := by
  simp [polynomialQuotientEvaluation]

-- @node: polynomialQuotientEvaluation_injective
/-- [Distinct common real zeros of a polynomial ideal induce distinct evaluation
maps from its quotient algebra to the real numbers](goal). -/
lemma polynomialQuotientEvaluation_injective {V : Type*} (J : Ideal (MvPolynomial V ℝ)) :
    Function.Injective (polynomialQuotientEvaluation J) := by
  intro a b hab
  apply Subtype.ext
  funext v
  have hv := congrArg (fun f : (MvPolynomial V ℝ ⧸ J) →ₐ[ℝ] ℝ =>
    f (Ideal.Quotient.mk J (MvPolynomial.X v))) hab
  simpa [polynomialQuotientEvaluation_mk] using hv

-- @node: polynomialIdealZeroSet_finite
/-- For a polynomial ideal whose quotient algebra is finite-dimensional over the
real numbers, [the common real zero set is finite](goal). -/
lemma polynomialIdealZeroSet_finite {V : Type*} (J : Ideal (MvPolynomial V ℝ))
    [Module.Finite ℝ (MvPolynomial V ℝ ⧸ J)] :
    (polynomialIdealZeroSet J).Finite := by
  let : Finite (polynomialIdealZeroSet J) :=
    Finite.of_injective _ (polynomialQuotientEvaluation_injective J)
  exact Set.toFinite (polynomialIdealZeroSet J)

-- @node: polynomialIdealZeroSet_encard_le_finrank
/-- For a polynomial ideal whose quotient algebra is finite-dimensional over the
real numbers, [the number of common real zeros is at most the dimension of that
quotient algebra](goal). -/
lemma polynomialIdealZeroSet_encard_le_finrank {V : Type*}
    (J : Ideal (MvPolynomial V ℝ)) [Module.Finite ℝ (MvPolynomial V ℝ ⧸ J)] :
    (polynomialIdealZeroSet J).encard ≤ (Module.finrank ℝ (MvPolynomial V ℝ ⧸ J) : ℕ) := by
  let : Finite (polynomialIdealZeroSet J) :=
    Finite.of_injective _ (polynomialQuotientEvaluation_injective J)
  have hcard := (Nat.card_le_card_of_injective _
    (polynomialQuotientEvaluation_injective J)).trans
      (card_algHom_le_finrank ℝ (MvPolynomial V ℝ ⧸ J) ℝ)
  change ENat.card (polynomialIdealZeroSet J) ≤ _
  rw [ENat.card_eq_coe_natCard]
  exact_mod_cast hcard

-- @node: polynomialIdealZeroSet_span
/-- [The common real zero set of the ideal generated by a polynomial family
equals the set of points at which every member of the family vanishes](goal). -/
lemma polynomialIdealZeroSet_span {I V : Type*} (p : I → MvPolynomial V ℝ) :
    polynomialIdealZeroSet (Ideal.span (Set.range p)) =
      {a | ∀ i, MvPolynomial.eval a (p i) = 0} := by
  ext a
  constructor
  · intro ha i
    exact ha _ (Ideal.subset_span (Set.mem_range_self i))
  · intro ha
    have hj : Ideal.span (Set.range p) ≤ RingHom.ker (MvPolynomial.eval a) := by
      apply Ideal.span_le.mpr
      rintro _ ⟨i, rfl⟩
      exact ha i
    exact fun q hq => hj hq

-- @node: polynomial_common_roots_encard_le_finrank
/-- For a polynomial family whose generated ideal has a finite-dimensional real
quotient algebra, [the number of common real roots is at most the dimension of
that quotient algebra](goal). -/
lemma polynomial_common_roots_encard_le_finrank {I V : Type*}
    (p : I → MvPolynomial V ℝ)
    [Module.Finite ℝ (MvPolynomial V ℝ ⧸ Ideal.span (Set.range p))] :
    {a | ∀ i, MvPolynomial.eval a (p i) = 0}.encard ≤
      (Module.finrank ℝ (MvPolynomial V ℝ ⧸ Ideal.span (Set.range p)) : ℕ) := by
  rw [← polynomialIdealZeroSet_span]
  exact polynomialIdealZeroSet_encard_le_finrank _

-- @node: polynomial_critical_encard_le_finrank
/-- If the quotient algebra defined by a polynomial and its partial derivatives
in all but one chosen coordinate is finite-dimensional, [the number of real
points where the polynomial and those derivatives vanish is at most the real
dimension of that quotient algebra](goal). -/
lemma polynomial_critical_encard_le_finrank {V : Type*} [DecidableEq V]
    (Q : MvPolynomial V ℝ) (v : V)
    [Module.Finite ℝ (MvPolynomial V ℝ ⧸
      Ideal.span (Set.range (polynomialCriticalEquations Q v)))] :
    (polynomialCoordinateCriticalSet Q v).encard ≤
      (Module.finrank ℝ (MvPolynomial V ℝ ⧸
        Ideal.span (Set.range (polynomialCriticalEquations Q v))) : ℕ) := by
  rw [← polynomialCriticalEquations_zero_set]
  exact polynomial_common_roots_encard_le_finrank _


open MvPolynomial

-- @node: polynomialBoxExponent
/-- Given [a natural-number bound for each of finitely many coordinates](hyp:D)
and [a choice of natural-number exponent strictly below each bound](hyp:e), the
[box exponent vector](goal) records those exponents as a finitely supported vector. -/
def polynomialBoxExponent {V : Type*} [Fintype V] (D : V → ℕ)
    (e : ∀ v, Fin (D v)) : V →₀ ℕ :=
  Finsupp.equivFunOnFinite.symm (fun v => (e v).val)

-- @node: polynomialBoxExponent_apply
/-- Given [a choice of exponent strictly below the prescribed bound at each coordinate](hyp:e),
[the box exponent vector at any coordinate equals the natural-number exponent chosen there](goal). -/
lemma polynomialBoxExponent_apply {V : Type*} [Fintype V] (D : V → ℕ)
    (e : ∀ v, Fin (D v)) (v : V) : polynomialBoxExponent D e v = (e v).val := by
  simp [polynomialBoxExponent]

-- @node: polynomialQuotientBoxMonomial
/-- For [a polynomial ideal](hyp:J), [natural-number bounds on the finitely many
coordinate exponents](hyp:D), and [an exponent choice strictly below each
bound](hyp:e), the [quotient box monomial](goal) is the class modulo the ideal
of the monomial with these exponents and coefficient one. -/
def polynomialQuotientBoxMonomial {V : Type*} [Fintype V]
    (J : Ideal (MvPolynomial V ℝ)) (D : V → ℕ) (e : ∀ v, Fin (D v)) :
    MvPolynomial V ℝ ⧸ J :=
  Ideal.Quotient.mk J (monomial (polynomialBoxExponent D e) 1)

-- @node: polynomial_remainder_exponent_lt
/-- If [an exponent vector is not coordinatewise greater than or equal to any
vector having the prescribed bound in one coordinate and zero elsewhere](hyp:hc),
then [each of its coordinate exponents is strictly below its prescribed bound](goal). -/
lemma polynomial_remainder_exponent_lt {V : Type*}
    (D : V → ℕ) (c : V →₀ ℕ)
    (hc : ∀ v, ¬ Finsupp.single v (D v) ≤ c) : ∀ v, c v < D v := by
  classical
  intro v
  by_contra h
  apply hc v
  exact Finsupp.single_le_iff.mpr (Nat.le_of_not_gt h)

-- @node: polynomialQuotient_box_spans
/-- For finitely many variables and a chosen monomial order, suppose [each
polynomial in a family indexed by the variables belongs to an ideal](hyp:hp),
[each has an invertible leading coefficient](hyp:hunit), and [the leading
monomial of each is the pure power of its indexing variable with prescribed
exponent](hyp:hdegree). Then [the classes of monomials with each exponent
strictly below its prescribed bound span the entire real quotient algebra](goal). -/
lemma polynomialQuotient_box_spans {V : Type*} [Fintype V]
    (J : Ideal (MvPolynomial V ℝ)) (D : V → ℕ) (m : MonomialOrder V)
    (p : V → MvPolynomial V ℝ) (hp : ∀ v, p v ∈ J)
    (hunit : ∀ v, IsUnit (m.leadingCoeff (p v)))
    (hdegree : ∀ v, m.degree (p v) = Finsupp.single v (D v)) :
    Submodule.span ℝ (Set.range (polynomialQuotientBoxMonomial J D)) = ⊤ := by
  classical
  apply top_unique
  intro z _
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective z
  obtain ⟨g, r, heq, _, hr⟩ := m.div hunit f
  have hg : Finsupp.linearCombination (MvPolynomial V ℝ) p g ∈ J := by
    rw [Finsupp.linearCombination_apply, Finsupp.sum]
    exact J.sum_mem (fun v hv => J.mul_mem_left _ (hp v))
  have hquot : Ideal.Quotient.mk J f = Ideal.Quotient.mk J r := by
    rw [heq, map_add, Ideal.Quotient.eq_zero_iff_mem.mpr hg, zero_add]
  rw [hquot, r.as_sum, map_sum]
  apply Submodule.sum_mem
  intro c hc
  have hbound : ∀ v, c v < D v :=
    polynomial_remainder_exponent_lt D c (by simpa only [hdegree] using hr c hc)
  let e : ∀ v, Fin (D v) := fun v => ⟨c v, hbound v⟩
  have he : polynomialBoxExponent D e = c := by ext v; simp [e, polynomialBoxExponent_apply]
  have hmem := Submodule.subset_span (R := ℝ)
    (Set.mem_range_self (f := polynomialQuotientBoxMonomial J D) e)
  have hm : Ideal.Quotient.mk J (monomial c (coeff c r)) =
      (coeff c r) • polynomialQuotientBoxMonomial J D e := by
    change (Ideal.Quotient.mkₐ ℝ J) _ =
      (coeff c r) • (Ideal.Quotient.mkₐ ℝ J) (monomial (polynomialBoxExponent D e) 1)
    rw [he, ← map_smul]
    congr 1
    simp [smul_monomial]
  rw [hm]
  exact Submodule.smul_mem _ _ hmem

-- @node: polynomialQuotient_finite_of_pure_powers
/-- For finitely many variables and a chosen monomial order, suppose [each
polynomial in a family indexed by the variables belongs to an ideal](hyp:hp),
[each has an invertible leading coefficient](hyp:hunit), and [each leading
monomial is a pure power of its indexing variable with the prescribed
exponent](hyp:hdegree). Then [the quotient algebra by the ideal is
finite-dimensional over the real numbers](goal). -/
lemma polynomialQuotient_finite_of_pure_powers {V : Type*} [Finite V]
    (J : Ideal (MvPolynomial V ℝ)) (D : V → ℕ) (m : MonomialOrder V)
    (p : V → MvPolynomial V ℝ) (hp : ∀ v, p v ∈ J)
    (hunit : ∀ v, IsUnit (m.leadingCoeff (p v)))
    (hdegree : ∀ v, m.degree (p v) = Finsupp.single v (D v)) :
    Module.Finite ℝ (MvPolynomial V ℝ ⧸ J) := by
  classical
  let := Fintype.ofFinite V
  apply Module.Finite.of_fg_top
  rw [← polynomialQuotient_box_spans J D m p hp hunit hdegree]
  exact Submodule.fg_span (Set.finite_range _)

-- @node: polynomialQuotient_finrank_le_box
/-- For finitely many variables and a chosen monomial order, suppose [each
polynomial in a family indexed by the variables belongs to an ideal](hyp:hp),
[each has an invertible leading coefficient](hyp:hunit), and [each leading
monomial is a pure power of its indexing variable with the prescribed
exponent](hyp:hdegree). Then [the real dimension of the quotient algebra is at
most the product of the prescribed exponents](goal). -/
lemma polynomialQuotient_finrank_le_box {V : Type*} [Fintype V]
    (J : Ideal (MvPolynomial V ℝ)) (D : V → ℕ) (m : MonomialOrder V)
    (p : V → MvPolynomial V ℝ) (hp : ∀ v, p v ∈ J)
    (hunit : ∀ v, IsUnit (m.leadingCoeff (p v)))
    (hdegree : ∀ v, m.degree (p v) = Finsupp.single v (D v)) :
    Module.finrank ℝ (MvPolynomial V ℝ ⧸ J) ≤ ∏ v, D v := by
  classical
  have h := finrank_le_of_span_eq_top
    (polynomialQuotient_box_spans J D m p hp hunit hdegree)
  simpa using h

-- @node: polynomial_roots_encard_le_box
/-- For finitely many variables and a chosen monomial order, suppose [each
polynomial in a family indexed by the variables belongs to an ideal](hyp:hp),
[each has an invertible leading coefficient](hyp:hunit), and [each leading
monomial is a pure power of its indexing variable with the prescribed
exponent](hyp:hdegree). Then [the number of common real zeros of the ideal is
at most the product of the prescribed exponents](goal).

This includes zero variables and zero exponents: the empty product is one,
and a unit equation leaves no roots. -/
lemma polynomial_roots_encard_le_box {V : Type*} [Fintype V]
    (J : Ideal (MvPolynomial V ℝ)) (D : V → ℕ) (m : MonomialOrder V)
    (p : V → MvPolynomial V ℝ) (hp : ∀ v, p v ∈ J)
    (hunit : ∀ v, IsUnit (m.leadingCoeff (p v)))
    (hdegree : ∀ v, m.degree (p v) = Finsupp.single v (D v)) :
    (polynomialIdealZeroSet J).encard ≤ (∏ v, D v : ℕ) := by
  classical
  let := polynomialQuotient_finite_of_pure_powers J D m p hp hunit hdegree
  exact (polynomialIdealZeroSet_encard_le_finrank J).trans
    (by exact_mod_cast polynomialQuotient_finrank_le_box J D m p hp hunit hdegree)

-- @node: polynomial_system_roots_encard_le_box
/-- For a polynomial system indexed by finitely many variables and a chosen
monomial order, if [every leading coefficient is invertible](hyp:hunit) and
[each leading monomial is the pure power of its indexing variable with the
prescribed exponent](hyp:hdegree), then [the number of common real roots is at
most the product of the prescribed exponents](goal). -/
lemma polynomial_system_roots_encard_le_box {V : Type*} [Fintype V]
    (D : V → ℕ) (m : MonomialOrder V) (p : V → MvPolynomial V ℝ)
    (hunit : ∀ v, IsUnit (m.leadingCoeff (p v)))
    (hdegree : ∀ v, m.degree (p v) = Finsupp.single v (D v)) :
    {a | ∀ v, MvPolynomial.eval a (p v) = 0}.encard ≤ (∏ v, D v : ℕ) := by
  classical
  rw [← polynomialIdealZeroSet_span]
  exact polynomial_roots_encard_le_box _ D m p
    (fun v => Ideal.subset_span (Set.mem_range_self v)) hunit hdegree


-- @node: polynomial_high_power_leading_term
/-- If [a real coefficient is nonzero](hyp:hε) and [a polynomial has total degree
strictly below D](hyp:hp), then [adding that coefficient times the D-th power of
a chosen variable gives, in graded lexicographic order, that pure power as the
leading monomial and that coefficient as the leading coefficient](goal). -/
lemma polynomial_high_power_leading_term {V : Type*} [LinearOrder V] [WellFoundedGT V]
    (p : MvPolynomial V ℝ) (v : V) (D : ℕ) (ε : ℝ) (hε : ε ≠ 0)
    (hp : p.totalDegree < D) :
    MonomialOrder.degLex.degree (monomial (Finsupp.single v D) ε + p) =
      Finsupp.single v D ∧
    MonomialOrder.degLex.leadingCoeff (monomial (Finsupp.single v D) ε + p) = ε := by
  classical
  have hlt : MonomialOrder.degLex.toSyn (MonomialOrder.degLex.degree p) <
      MonomialOrder.degLex.toSyn (MonomialOrder.degLex.degree
        (monomial (Finsupp.single v D) ε : MvPolynomial V ℝ)) := by
    rw [MonomialOrder.degree_monomial, if_neg hε, MonomialOrder.degLex_lt_iff,
      Finsupp.DegLex.lt_iff]
    exact Or.inl (by simpa [MvPolynomial.degree_degLexDegree] using hp)
  constructor
  · rw [MonomialOrder.degree_add_of_lt hlt, MonomialOrder.degree_monomial, if_neg hε]
  · rw [MonomialOrder.leadingCoeff_add_of_lt hlt, MonomialOrder.leadingCoeff_monomial]

-- @node: polynomial_perturbed_system_roots_encard_le
/-- For a polynomial system indexed by finitely many ordered variables, if
[every perturbation coefficient is nonzero](hyp:hε) and [each original
polynomial has total degree strictly below its prescribed exponent](hyp:hp),
then [adding to each equation its coefficient times the prescribed power of its
indexing variable yields at most the product of those exponents common real
roots](goal).

This asserts no persistence of the original roots under perturbation. -/
lemma polynomial_perturbed_system_roots_encard_le {V : Type*} [Fintype V]
    [LinearOrder V] [WellFoundedGT V] (p : V → MvPolynomial V ℝ)
    (D : V → ℕ) (ε : V → ℝ) (hε : ∀ v, ε v ≠ 0)
    (hp : ∀ v, (p v).totalDegree < D v) :
    {a | ∀ v, MvPolynomial.eval a
      (monomial (Finsupp.single v (D v)) (ε v) + p v) = 0}.encard ≤
        (∏ v, D v : ℕ) := by
  apply polynomial_system_roots_encard_le_box D MonomialOrder.degLex
  · intro v
    rw [(polynomial_high_power_leading_term (p v) v (D v) (ε v) (hε v) (hp v)).2]
    exact isUnit_iff_ne_zero.mpr (hε v)
  · intro v
    exact (polynomial_high_power_leading_term (p v) v (D v) (ε v) (hε v) (hp v)).1


-- @node: polynomial_perturbed_critical_encard_le
/-- For a polynomial Q in finitely many ordered variables and a chosen coordinate,
if [every perturbation coefficient is nonzero](hyp:hε), then [adding to each
critical equation its coefficient times the power of its indexing variable with
exponent one plus the total degree of Q yields at most that exponent raised to
the number of variables common real roots](goal).

The critical equation for the chosen coordinate is Q itself; the others are
the respective partial derivatives of Q. -/
lemma polynomial_perturbed_critical_encard_le {V : Type*} [Fintype V]
    [LinearOrder V] [WellFoundedGT V] (Q : MvPolynomial V ℝ) (v : V)
    (ε : V → ℝ) (hε : ∀ i, ε i ≠ 0) :
    {a | ∀ i, MvPolynomial.eval a
      (monomial (Finsupp.single i (Q.totalDegree + 1)) (ε i) +
        polynomialCriticalEquations Q v i) = 0}.encard ≤
          ((Q.totalDegree + 1) ^ Fintype.card V : ℕ) := by
  simpa using polynomial_perturbed_system_roots_encard_le
    (polynomialCriticalEquations Q v) (fun _ => Q.totalDegree + 1) ε hε
    (fun i => Nat.lt_succ_of_le (polynomialCriticalEquations_degree Q v i))

end
end Papers.TbsNeuralCausalPi
