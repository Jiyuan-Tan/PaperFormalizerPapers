module
public import Papers.TbsNeuralCausalPi.Helpers.SimulationFiniteParameters
/-! # Successive polynomial sign counts for simulation layers

At each layer the comparison polynomials may depend on all preceding signs.
Counting separately on each preceding region multiplies the degree-dependent
sign bound once per layer. The same parameter assignment is retained throughout;
zero evaluations are recorded with both weak and strict comparisons.
-/
@[expose] public section
namespace Papers.TbsNeuralCausalPi
noncomputable section

-- @node: simulationPolynomialPatternFinset
/-- For [a finite indexed family of real polynomials](hyp:p), the [finite set of
attainable comparison patterns](goal) consists of all joint weak and strict
sign comparisons obtained by varying the real parameter vector. -/
def simulationPolynomialPatternFinset {I V : Type*} [Fintype I]
    (p : I → MvPolynomial V ℝ) : Finset (I → Bool × Bool) := by
  classical
  exact Finset.univ.filter (fun s => s ∈ Set.range (polynomialComparisonPattern p))

-- @node: simulationPolynomialPatternFinset_mem
/-- [A comparison pattern belongs to the finite pattern set exactly when some
real parameter vector produces it](goal). -/
lemma simulationPolynomialPatternFinset_mem {I V : Type*} [Fintype I]
    (p : I → MvPolynomial V ℝ) (s : I → Bool × Bool) :
    s ∈ simulationPolynomialPatternFinset p ↔
      s ∈ Set.range (polynomialComparisonPattern p) := by
  classical
  simp [simulationPolynomialPatternFinset]

-- @node: simulationPolynomialPatternFinset_card_le
/-- If [every polynomial has total degree at most d](hyp:hd), then [the number
of attainable weak and strict comparison patterns is at most
(8 times the number of polynomials times the larger of d and one, plus 5),
raised to the number of variables plus one](goal). -/
lemma simulationPolynomialPatternFinset_card_le {I V : Type*}
    [Fintype I] [Fintype V] (p : I → MvPolynomial V ℝ)
    (d : ℕ) (hd : ∀ i, (p i).totalDegree ≤ d) :
    (simulationPolynomialPatternFinset p).card ≤
      (8 * Fintype.card I * max d 1 + 5) ^ (Fintype.card V + 1) := by
  have heq : (↑(simulationPolynomialPatternFinset p) : Set (I → Bool × Bool)) =
      Set.range (polynomialComparisonPattern p) := by
    ext s
    exact simulationPolynomialPatternFinset_mem p s
  have h := polynomialComparisonPattern_encard_le_degree_power p d hd
  rw [← heq, Set.encard_coe_eq_coe_finsetCard] at h
  exact_mod_cast h

-- @node: simulationLayerPatternEnvelope
/-- For [polynomials selected by the layer number and preceding comparison
history](hyp:p), the [finite envelope of possible histories](goal) starts with
[only the empty history at depth zero](step:1), and [extends each preceding
history by every comparison pattern attainable at the next layer](step:2).

Parameters may vary independently between layers in this envelope. -/
def simulationLayerPatternEnvelope {I V : Type*} [Fintype I]
    (p : ℕ → List (I → Bool × Bool) → I → MvPolynomial V ℝ) :
    ℕ → Finset (List (I → Bool × Bool))
  | 0 => {[]}
  | t + 1 => by
      classical
      exact (simulationLayerPatternEnvelope p t).biUnion (fun s =>
        (simulationPolynomialPatternFinset (p t s)).image (fun a => a :: s))

-- @node: simulationLayerPatternHistory
/-- For [polynomials selected by the layer number and preceding comparison
history](hyp:p) and [one shared real parameter vector](hyp:theta), the
[actual comparison history](goal) is [empty at depth zero](step:1) and
[prepends the next layer's weak and strict comparison pattern, evaluated at
that same vector, to the preceding history](step:2). -/
def simulationLayerPatternHistory {I V : Type*}
    (p : ℕ → List (I → Bool × Bool) → I → MvPolynomial V ℝ)
    (theta : V → ℝ) : ℕ → List (I → Bool × Bool)
  | 0 => []
  | t + 1 => polynomialComparisonPattern (p t (simulationLayerPatternHistory p theta t))
      theta :: simulationLayerPatternHistory p theta t

-- @node: simulationLayerPatternHistory_mem
/-- [The comparison history generated by one shared parameter vector through
any number of layers belongs to the finite envelope at that depth](goal). -/
lemma simulationLayerPatternHistory_mem {I V : Type*} [Fintype I]
    (p : ℕ → List (I → Bool × Bool) → I → MvPolynomial V ℝ)
    (theta : V → ℝ) (t : ℕ) :
    simulationLayerPatternHistory p theta t ∈ simulationLayerPatternEnvelope p t := by
  classical
  induction t with
  | zero => simp [simulationLayerPatternHistory, simulationLayerPatternEnvelope]
  | succ t ih =>
    apply Finset.mem_biUnion.mpr
    refine ⟨_, ih, Finset.mem_image.mpr ⟨_, ?_, rfl⟩⟩
    exact (simulationPolynomialPatternFinset_mem _ _).mpr ⟨theta, rfl⟩

-- @node: simulationLayerPatternEnvelope_card_le
/-- If [all polynomials in every history before depth t have total degree at
most d](hyp:hd), then [the history envelope has size at most
(8 times the number of comparisons per layer times the larger of d and one,
plus 5), raised to t times the number of variables plus one](goal). -/
lemma simulationLayerPatternEnvelope_card_le {I V : Type*}
    [Fintype I] [Fintype V]
    (p : ℕ → List (I → Bool × Bool) → I → MvPolynomial V ℝ)
    (d t : ℕ) (hd : ∀ k < t, ∀ s i, (p k s i).totalDegree ≤ d) :
    (simulationLayerPatternEnvelope p t).card ≤
      (8 * Fintype.card I * max d 1 + 5) ^ ((Fintype.card V + 1) * t) := by
  classical
  induction t with
  | zero => simp [simulationLayerPatternEnvelope]
  | succ t ih =>
    have hprev := ih (fun k hk => hd k (by omega))
    calc
      _ ≤ ∑ s ∈ simulationLayerPatternEnvelope p t,
          ((simulationPolynomialPatternFinset (p t s)).image (fun a => a :: s)).card :=
        Finset.card_biUnion_le
      _ ≤ ∑ _s ∈ simulationLayerPatternEnvelope p t,
          (8 * Fintype.card I * max d 1 + 5) ^ (Fintype.card V + 1) := by
        apply Finset.sum_le_sum
        intro s _
        exact Finset.card_image_le.trans
          (simulationPolynomialPatternFinset_card_le (p t s) d (hd t (by omega) s))
      _ = (simulationLayerPatternEnvelope p t).card *
          (8 * Fintype.card I * max d 1 + 5) ^ (Fintype.card V + 1) := by simp
      _ ≤ (8 * Fintype.card I * max d 1 + 5) ^ ((Fintype.card V + 1) * t) *
          (8 * Fintype.card I * max d 1 + 5) ^ (Fintype.card V + 1) :=
        Nat.mul_le_mul_right _ hprev
      _ = _ := by rw [← pow_add, Nat.mul_succ]

-- @node: simulationLayerPatternHistory_encard_le
/-- If [every polynomial selected before depth t has total degree at most
d](hyp:hd), then [the number of histories attainable using a shared parameter
vector is at most (8 times the number of comparisons per layer times the
larger of d and one, plus 5), raised to t times the number of variables plus
one](goal). -/
lemma simulationLayerPatternHistory_encard_le {I V : Type*}
    [Fintype I] [Fintype V]
    (p : ℕ → List (I → Bool × Bool) → I → MvPolynomial V ℝ)
    (d t : ℕ) (hd : ∀ k < t, ∀ s i, (p k s i).totalDegree ≤ d) :
    (Set.range (fun theta => simulationLayerPatternHistory p theta t)).encard ≤
      ((8 * Fintype.card I * max d 1 + 5) ^ ((Fintype.card V + 1) * t) : ℕ) := by
  apply (Set.encard_mono (b := (↑(simulationLayerPatternEnvelope p t) : Set _)) ?_).trans
    (by exact_mod_cast simulationLayerPatternEnvelope_card_le p d t hd)
  rintro _ ⟨theta, rfl⟩
  exact simulationLayerPatternHistory_mem p theta t

-- @node: simulationLayerPatternHistory_finite_parameters
/-- If [every polynomial selected at every layer and history uses only
variables in the finite set S](hyp:hp), then [restricting the polynomials and
the parameter assignment to the finite parameter representation leaves the
entire comparison history unchanged at every depth](goal). -/
lemma simulationLayerPatternHistory_finite_parameters {I V : Type*}
    (S : Finset V)
    (p : ℕ → List (I → Bool × Bool) → I → MvPolynomial V ℝ)
    (hp : ∀ k s i, (p k s i).vars ⊆ S) (theta : V → ℝ) (t : ℕ) :
    simulationLayerPatternHistory
      (fun k s i => simulationFinitePolynomial S (p k s i))
      (simulationFiniteAssignment S theta) t =
        simulationLayerPatternHistory p theta t := by
  induction t with
  | zero => rfl
  | succ t ih =>
    simp only [simulationLayerPatternHistory, ih]
    congr 1
    funext i
    simp only [polynomialComparisonPattern,
      simulationFinitePolynomial_eval S _ (hp _ _ _) theta]

-- @node: simulationLayerPatternHistory_supported_encard_le
/-- If [all selected polynomials use only variables in the finite set
S](hyp:hp) and [those selected before depth t have total degree at most
d](hyp:hd), then [the number of attainable shared-parameter histories is at
most (8 times the number of comparisons per layer times the larger of d and
one, plus 5), raised to t times the size of S plus two](goal). -/
lemma simulationLayerPatternHistory_supported_encard_le {I V : Type*} [Fintype I]
    (S : Finset V)
    (p : ℕ → List (I → Bool × Bool) → I → MvPolynomial V ℝ)
    (hp : ∀ k s i, (p k s i).vars ⊆ S)
    (d t : ℕ) (hd : ∀ k < t, ∀ s i, (p k s i).totalDegree ≤ d) :
    (Set.range (fun theta => simulationLayerPatternHistory p theta t)).encard ≤
      ((8 * Fintype.card I * max d 1 + 5) ^ ((S.card + 2) * t) : ℕ) := by
  have hsub : Set.range (fun theta => simulationLayerPatternHistory p theta t) ⊆
      Set.range (fun theta => simulationLayerPatternHistory
        (fun k s i => simulationFinitePolynomial S (p k s i)) theta t) := by
    rintro _ ⟨theta, rfl⟩
    exact ⟨simulationFiniteAssignment S theta,
      simulationLayerPatternHistory_finite_parameters S p hp theta t⟩
  have hcount := simulationLayerPatternHistory_encard_le
    (fun k s i => simulationFinitePolynomial S (p k s i)) d t
    (fun k hk s i => (simulationFinitePolynomial_degree S _).trans (hd k hk s i))
  exact (Set.encard_mono hsub).trans (by
    simpa only [simulationFinitePolynomial_card, Nat.add_assoc] using hcount)

-- @node: simulationLayerPatternHistory_growth_card_le
/-- Suppose [all selected polynomials use only variables in S](hyp:hp),
[their total degrees before depth t are at most d](hyp:hd), and [decoding each
class member's parameter history gives exactly its Boolean pattern on the
sample](hyp:hdecode). Then [the number of sample patterns is at most
(8 times the number of comparisons per layer times the larger of d and one,
plus 5), raised to t times the size of S plus two](goal). -/
lemma simulationLayerPatternHistory_growth_card_le {I V X A : Type*} [Fintype I]
    (S : Finset V)
    (p : ℕ → List (I → Bool × Bool) → I → MvPolynomial V ℝ)
    (hp : ∀ k s i, (p k s i).vars ⊆ S)
    (d t : ℕ) (hd : ∀ k < t, ∀ s i, (p k s i).totalDegree ≤ d)
    (B : A → X → Bool) (theta : A → V → ℝ)
    {m : ℕ} (sample : Fin m → X)
    (decode : List (I → Bool × Bool) → Finset (Fin m))
    (hdecode : ∀ a, decode (simulationLayerPatternHistory p (theta a) t) =
      Causalean.Stat.Concentration.restrictionPattern (B a) sample) :
    (Causalean.Stat.Concentration.growthFamily B sample).card ≤
      (8 * Fintype.card I * max d 1 + 5) ^ ((S.card + 2) * t) := by
  have hsub : (↑(Causalean.Stat.Concentration.growthFamily B sample) :
      Set (Finset (Fin m))) ⊆ decode ''
        Set.range (fun theta => simulationLayerPatternHistory p theta t) := by
    intro s hs
    obtain ⟨a, rfl⟩ := Causalean.Stat.Concentration.mem_growthFamily_iff.mp hs
    exact ⟨_, ⟨theta a, rfl⟩, hdecode a⟩
  have h := (Set.encard_mono hsub).trans ((Set.encard_image_le _ _).trans
    (simulationLayerPatternHistory_supported_encard_le S p hp d t hd))
  simpa only [Set.encard_coe_eq_coe_finsetCard, Nat.cast_le] using h

-- @node: simulationAffine_activation_patterns_encard_le
/-- If [the affine layer's weight and bias variables lie in S](hyp:hvariables),
[all input polynomials use only variables in S](hyp:hz), and [their total
degrees are at most d](hyp:hdegree), then [the number of nonnegative
preactivation patterns across m sample points and w output coordinates is at
most (8mw(d + 1) + 5) raised to the size of S plus two](goal). -/
lemma simulationAffine_activation_patterns_encard_le
    (l : AffineLayer) (k m w d : ℕ) (S : Finset (ℕ × ℕ × ℕ))
    (z : Fin m → ℕ → MvPolynomial (ℕ × ℕ × ℕ) ℝ)
    (hvariables : simulationLayerVariables k l.input l.output ⊆ S)
    (hz : ∀ a j, (z a j).vars ⊆ S)
    (hdegree : ∀ a j, (z a j).totalDegree ≤ d) :
    (Set.range (fun theta : (ℕ × ℕ × ℕ) → ℝ =>
      fun aj : Fin m × Fin w => decide (0 ≤ MvPolynomial.eval theta
        (simulationAffinePolynomial l k (z aj.1) aj.2.val)))).encard ≤
      ((8 * (m * w) * (d + 1) + 5) ^ (S.card + 2) : ℕ) := by
  let p : Fin m × Fin w → MvPolynomial (ℕ × ℕ × ℕ) ℝ :=
    fun aj => -simulationAffinePolynomial l k (z aj.1) aj.2.val
  have hp : ∀ aj, (p aj).vars ⊆ S := by
    intro aj
    simp only [p, MvPolynomial.vars_neg]
    exact (simulationAffinePolynomial_vars l k _ S (hz aj.1) _).trans
      (Finset.union_subset hvariables Finset.Subset.rfl)
  have hd : ∀ aj, (p aj).totalDegree ≤ d + 1 := by
    intro aj
    simp only [p, MvPolynomial.totalDegree_neg]
    exact simulationAffinePolynomial_degree l k d _ (hdegree aj.1) _
  let decode : (Fin m × Fin w → Bool × Bool) → (Fin m × Fin w → Bool) :=
    fun s aj => (s aj).1
  have hsub : Set.range (fun theta : (ℕ × ℕ × ℕ) → ℝ =>
      fun aj : Fin m × Fin w => decide (0 ≤ MvPolynomial.eval theta
        (simulationAffinePolynomial l k (z aj.1) aj.2.val))) ⊆
      decode '' Set.range (polynomialComparisonPattern p) := by
    rintro _ ⟨theta, rfl⟩
    refine ⟨_, ⟨theta, rfl⟩, ?_⟩
    funext aj
    simp [decode, polynomialComparisonPattern, p]
  have h := (Set.encard_mono hsub).trans ((Set.encard_image_le _ _).trans
    (simulationFinitePolynomial_comparison_encard_le S p hp (d + 1) hd))
  simpa only [Fintype.card_prod, Fintype.card_fin, max_eq_left (by omega : 1 ≤ d + 1)]
    using h

-- @node: simulation_table_layer_patterns_card_le
/-- Suppose [all polynomials selected before depth t have degree at most
d](hyp:hd) and [each pattern in the family is encoded by an allowed table and
a shared-parameter history, either with a subset of types or as an ambiguity
pattern](hyp:hencode). Then [the family size is at most the number of tables
times (8 times the number of comparisons per layer times the larger of d and
one, plus 5) raised to t times the number of variables plus one, times
two to the number of types plus one](goal). -/
lemma simulation_table_layer_patterns_card_le
    {I V T J : Type*} [Fintype I] [Fintype V] [Fintype J]
    (p : ℕ → List (I → Bool × Bool) → I → MvPolynomial V ℝ)
    (d t : ℕ) (hd : ∀ k < t, ∀ s i, (p k s i).totalDegree ≤ d)
    {m : ℕ} (tables : Finset T) (family : Finset (Finset (Fin m)))
    (indicator : T → List (I → Bool × Bool) → Finset J → Finset (Fin m))
    (ambiguity : T → List (I → Bool × Bool) → Finset (Fin m))
    (hencode : ∀ a ∈ family, ∃ table ∈ tables, ∃ theta : V → ℝ,
      (∃ s, indicator table (simulationLayerPatternHistory p theta t) s = a) ∨
        ambiguity table (simulationLayerPatternHistory p theta t) = a) :
    family.card ≤ tables.card *
      (8 * Fintype.card I * max d 1 + 5) ^ ((Fintype.card V + 1) * t) *
        (2 ^ Fintype.card J + 1) := by
  have hcount := simulation_table_patterns_card_le tables
    (simulationLayerPatternEnvelope p t) family indicator ambiguity (by
      intro a ha
      obtain ⟨table, ht, theta, h⟩ := hencode a ha
      exact ⟨table, ht, _, simulationLayerPatternHistory_mem p theta t, h⟩)
  exact hcount.trans (Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _
    (simulationLayerPatternEnvelope_card_le p d t hd)))

end
end Papers.TbsNeuralCausalPi
