-- @node: contDMLRegime_remainder_on_recovery_of_scoreLabels_eq
/-- Suppose [the observations are divided into equal training and evaluation halves](hyp:hSplit),
[the policy is admissible](hyp:hphi), [its derivative is the specified derivative map](hyp:hd), and
[that derivative is bounded and Lipschitz](hyp:hDerivative).
Under [the structural model assumptions](hyp:hStruct), [known outcome endpoints](hyp:hend),
[a positive number of baseline intervals](hyp:hK), [covariate-invariant level ordering](hyp:hOrder),
[measurable baseline levels](hyp:hlev), [baseline overlap with the specified lower bound](hyp:hov),
and [policy overlap with that bound](hyp:hpol), assume [the given gap separates distinct propensity levels](hyp:hgap)
and [continuous nuisance estimates indexed by sample size and realization on the recovered level structure](hyp:eHat)
[satisfy dynamic fitting, finite component error rates, bounded boundary densities, and no lower-endpoint atom](hyp:hr).
If [the complements of the recovery events have probability tending to zero](hyp:hG) and
[recovered score labels agree with population labels on those events](hyp:hLabels), then
[the difference between the fitted continuous DML estimate and its true-nuisance counterpart, multiplied by the square root of the evaluation-half size, converges to zero in probability along even sample sizes](goal). -/
lemma contDMLRegime_remainder_on_recovery_of_scoreLabels_eq
    (M : LatentIVModel Ω X Z) (μ : Measure A) [IsProbabilityMeasure μ]
    (S : ObservedSample M μ) (I₁ I₂ : SampleSplit A)
    (hSplit : EqualHalfSplit M μ S I₁ I₂)
    (phi dphi : Z → X → ℝ → ℝ) (hphi : IsPolicyMap phi)
    (hd : PolicyDifferentiable phi dphi)
    (hDerivative : PolicyDerivativeBoundedLipschitz dphi)
    (hStruct : StructuralAssumptions M) (hend : OutcomeEndpointsKnown M)
    (L : LevelData Z X) (hK : LevelCountPos L.K)
    (hOrder : LevelOrderInvariant M.prop (policyProp phi M.prop) L)
    (hlev : ∀ k, Measurable (L.pLev k))
    (cpi : ℝ) (hov : BaselineOverlapWitness M L cpi) (hpol : PolicyOverlap M L cpi)
    (pHat : ℕ → A → Z → X → ℝ) (rho : ℕ → ℝ) (gap ch : ℝ)
    (hgap : PropensityGapSeparationWitness M.prop (policyProp phi M.prop) gap)
    (eHat : ∀ n a, NuisanceCont (recoveredData M S I₁ I₂ pHat phi rho gap n a))
    (hr : FiniteContDMLRegime M μ S I₁ I₂ pHat phi rho gap cpi L ch eHat)
    (G : ℕ → Set A) (hG : Tendsto (fun n => μ (G n)ᶜ) atTop (𝓝 0))
    (hLabels : ∀ n a, a ∈ G n →
      scoreRecoveryLabels (recoveredData M S I₁ I₂ pHat phi rho gap (2 * (n + 1)) a) =
        scoreRecoveryLabels L) :
    Causalean.Stat.Modes.TendstoInProbability (fun _ => μ)
      (fun n a => Real.sqrt ((n + 1 : ℕ) : ℝ) *
        (dmlRV M S I₂ (fittedContScore M S I₁ I₂ pHat phi dphi rho gap eHat)
            (2 * (n + 1)) a -
          dmlRV M S I₂ (fun _ _ o => psiCont M phi dphi L hK o (trueNuisance M L))
            (2 * (n + 1)) a)) atTop (fun _ _ => 0) := by
  cases Subsingleton.elim ‹DecidableEq Z› (fun a b => Classical.propDecidable (a = b))
  haveI : IsFiniteMeasure (observationLaw M) := by unfold observationLaw; infer_instance
  have hq := population_policyProp_measurable M hStruct.2.2.2.1 phi hphi
  have he0 := population_continuous_nuisance_admissible M hStruct hend
    (policyProp phi M.prop) hq L hOrder hlev cpi hov hpol
  obtain ⟨oracle, hm, hc, ha, heq, hrate⟩ :=
    contDMLRegime_regular_oracle_nuisance_records_of_scoreLabels_eq
      M μ S I₁ I₂ pHat phi rho gap cpi L ch hK hend eHat hr G hG hLabels
  have hfluct := encoded_continuous_centered_oracle_remainder_negligible
    M μ S I₁ I₂ hSplit phi dphi hphi hd hDerivative hStruct hend L hK hOrder
    he0 cpi hov hpol oracle hm hc ha hrate hr.2.2.1
  have hpos : 0 < cpi / 2 := by linarith [hov.1]
  have hpi n a (i : PositiveIndex L.K) :
      ∀ᵐ x ∂xLaw M, cpi / 2 ≤ (oracle n a).piLev i x :=
    Eventually.of_forall (fun x => (hc n a).2.2.1 i x |>.1)
  have htau n a (r : RegularIndex L) :
      ∀ᵐ x ∂xLaw M, cpi / 2 ≤ (oracle n a).tauLev r x :=
    Eventually.of_forall (fun x => ((hc n a).2.2.2 r x
      (contFittedSharesSimplex_policy_nonempty L _ (hc n a).2.1 r)).1)
  have hbias := encoded_continuous_total_score_bias_root_n_negligible
    M hStruct hend μ phi dphi hphi hd hDerivative L hK hOrder cpi gap hov hpol hgap
    oracle he0 ha hr.2.2.1 hr.2.2.2 hrate (cpi / 2) hpos hpi htau
  have hfitLp n a := fitted_continuous_total_score_memLp
    M phi dphi hphi hd hDerivative L hK (oracle n a) (ha n a)
      hStruct.1 hStruct.2.1 hend (cpi / 2) hpos (hpi n a) (htau n a)
  have htrueLp := true_continuous_total_score_memLp_of_overlap
    M phi dphi hphi hd hDerivative L hK he0 hStruct.1 hStruct.2.1 hend cpi hov hpol
  have hi n a :
      (∫ o, psiCont M phi dphi L hK o (oracle (2 * (n + 1)) a) -
        psiCont M phi dphi L hK o (trueNuisance M L) ∂observationLaw M) =
      (∫ o, psiCont M phi dphi L hK o (oracle (2 * (n + 1)) a) ∂observationLaw M) -
        (∫ o, psiCont M phi dphi L hK o (trueNuisance M L) ∂observationLaw M) :=
    integral_sub ((hfitLp _ a).integrable (by norm_num))
      (htrueLp.integrable (by norm_num))
  dsimp only at hfluct
  have hs := (show TendstoInMeasure μ _ atTop (fun _ => (0 : ℝ)) from hfluct).add_zero
    (show TendstoInMeasure μ _ atTop (fun _ => (0 : ℝ)) from hbias)
  have hrem : Causalean.Stat.Modes.TendstoInProbability (fun _ => μ)
      (fun n a => Real.sqrt ((n + 1 : ℕ) : ℝ) *
        (dmlRV M S I₂ (fun n a o => psiCont M phi dphi L hK o (oracle n a))
          (2 * (n + 1)) a -
        dmlRV M S I₂ (fun _ _ o => psiCont M phi dphi L hK o (trueNuisance M L))
          (2 * (n + 1)) a)) atTop (fun _ _ => 0) := by
    change TendstoInMeasure μ _ atTop (fun _ => (0 : ℝ))
    convert hs using 1
    funext n a
    rw [hi]
    ring
  apply probability_limit_transfer_on_recovery μ G _ _ 0 hG _ hrem
  intro n a hna
  rw [dmlRV_eq_of_score_eq_on_sample M S I₂ _
    (fun n a o => psiCont M phi dphi L hK o (oracle n a)) (2 * (n + 1)) a]
  intro i hi
  exact fittedContScore_eq_oracle_of_scoreLabels_eq M S I₁ I₂ pHat phi dphi
    rho gap L hK eHat oracle _ a (hLabels n a hna) (heq n a hna) (S.Z i a)

-- @node: contDMLRegime_clt
/-- Suppose [the observations are divided into equal training and evaluation halves](hyp:hSplit),
[the policy is admissible](hyp:hphi), [it has the specified derivative](hyp:hd), and
[its derivative is bounded and Lipschitz](hyp:hDerivative).
Under [the structural model assumptions](hyp:hStruct), [known outcome endpoints](hyp:hend),
[separation of distinct baseline and policy propensity levels](hyp:hGap), [a finite discrete instrument domain](hyp:hFinite),
[a positive number of baseline intervals](hyp:hK), [covariate-invariant level ordering](hyp:hOrder),
[baseline overlap with the specified lower bound](hyp:hov), and [policy overlap with that bound](hyp:hpol),
assume [the propensity learner satisfies the finite first-stage rate](hyp:hRate),
[policy levels avoid baseline boundaries](hyp:hOff), [the specified gap witnesses level separation](hyp:hgap), and
[continuous nuisance estimates indexed by sample size and realization on the recovered level structure](hyp:eHat)
[satisfy dynamic fitting, finite component error rates, bounded boundary densities, and no lower-endpoint atom](hyp:hr).
Then [the continuous DML lower-bound estimation error, scaled by the square root of the evaluation-half size, converges in distribution along even sample sizes to a centered Gaussian with variance equal to the population variance of the true continuous score around the sharp lower bound](goal). -/
lemma contDMLRegime_clt
    (M : LatentIVModel Ω X Z) {A : Type*} [MeasurableSpace A]
    (μ : Measure A) [IsProbabilityMeasure μ] (S : ObservedSample M μ)
    (I₁ I₂ : SampleSplit A) (hSplit : EqualHalfSplit M μ S I₁ I₂)
    (phi dphi : Z → X → ℝ → ℝ) (hphi : IsPolicyMap phi)
    (hd : PolicyDifferentiable phi dphi)
    (hDerivative : PolicyDerivativeBoundedLipschitz dphi)
    (hStruct : StructuralAssumptions M) (hend : OutcomeEndpointsKnown M)
    (x0 : X) (hGap : PropensityGapSeparation M.prop (policyProp phi M.prop))
    (hFinite : InstrumentFiniteReduction Z)
    (hK : LevelCountPos (LevelStructure M.prop (policyProp phi M.prop) x0).K)
    (hOrder : LevelOrderInvariant M.prop (policyProp phi M.prop)
      (LevelStructure M.prop (policyProp phi M.prop) x0))
    (cpi : ℝ)
    (hov : BaselineOverlapWitness M (LevelStructure M.prop (policyProp phi M.prop) x0) cpi)
    (hpol : PolicyOverlap M (LevelStructure M.prop (policyProp phi M.prop) x0) cpi)
    (pHat : ℕ → A → Z → X → ℝ) (hRate : FiniteFirstStageRate M μ pHat)
    (rho : ℕ → ℝ) (gap ch : ℝ)
    (hOff : PolicyLevelOffBoundary (LevelStructure M.prop (policyProp phi M.prop) x0))
    (hgap : PropensityGapSeparationWitness M.prop (policyProp phi M.prop) gap)
    (eHat : ∀ n a, NuisanceCont (recoveredData M S I₁ I₂ pHat phi rho gap n a))
    (hr : FiniteContDMLRegime M μ S I₁ I₂ pHat phi rho gap cpi
      (LevelStructure M.prop (policyProp phi M.prop) x0) ch eHat) :
    let L := LevelStructure M.prop (policyProp phi M.prop) x0
    let score := fittedContScore M S I₁ I₂ pHat phi dphi rho gap eHat
    let truth := fun o => psiCont M phi dphi L hK o (trueNuisance M L)
    let theta := thetaLower1 (transportData M) (policyWeight M (policyProp phi M.prop))
    Causalean.Stat.Modes.TendstoInLaw (fun _ => μ)
      (fun n a => Real.sqrt ((n + 1 : ℕ) : ℝ) *
        (dmlRV M S I₂ score (2 * (n + 1)) a - theta)) atTop
      (ProbabilityTheory.gaussianReal 0
        (Real.toNNReal (populationVariance M truth theta))) := by
  cases Subsingleton.elim ‹DecidableEq Z› (fun a b => Classical.propDecidable (a = b))
  have hlev := population_LevelStructure_baseline_measurable M hStruct.2.2.2.1
    (policyProp phi M.prop) x0 hOrder
  have hq := population_policyProp_measurable M hStruct.2.2.2.1 phi hphi
  have he0 := population_continuous_nuisance_admissible M hStruct hend
    (policyProp phi M.prop) hq _ hOrder hlev cpi hov hpol
  have hG := contDMLRegime_recoveryEvent_compl_tendsto_zero M μ S I₁ I₂ hStruct.2.2.2.1
    pHat hRate phi dphi hphi hd hDerivative x0 gap cpi rho hOrder hOff hgap hK ch eHat hr
  have hrem := contDMLRegime_remainder_on_recovery_of_scoreLabels_eq
    M μ S I₁ I₂ hSplit phi dphi hphi hd hDerivative hStruct hend _ hK hOrder hlev
    cpi hov hpol pHat rho gap ch hgap eHat hr
    (fun n => recoveryEvent M S I₁ I₂ pHat phi rho gap
      (LevelStructure M.prop (policyProp phi M.prop) x0) (2 * (n + 1))) hG
    (fun n a ha => (mem_recoveryEvent_iff_scoreRecoveryLabels_eq
      M S I₁ I₂ pHat phi rho gap _ _ a).mp ha)
  have hlaw := equalHalfSplit_true_continuous_lower_bound_clt M μ S I₁ I₂ hSplit
    phi dphi hphi hd hDerivative hStruct hend x0 hGap hOrder hFinite hK
    he0 cpi hov hpol hr.2.2.1 hr.2.2.2
  dsimp only at hlaw ⊢
  apply tendstoInDistribution_of_tendstoInMeasure_sub _ id hlaw
  · change TendstoInMeasure μ _ atTop (fun _ => (0 : ℝ)) at hrem
    convert hrem using 1
    · funext n a
      dsimp only [Pi.sub_apply]
      ring
    · rfl
  · intro n
    have hm := dynamicContFit_aemeasurable_dmlRV M S I₁ I₂ pHat phi dphi
      hphi hd rho gap cpi eHat hr.1 n
    fun_prop

-- @node: contDMLRegime_rootn_consistent
/-- With [equal training and evaluation halves](hyp:hSplit), [an admissible policy](hyp:hphi)
that [has the specified derivative](hyp:hd), and [a bounded Lipschitz derivative](hyp:hDerivative), assume
[the structural model conditions](hyp:hStruct), [known outcome endpoints](hyp:hend),
[separated baseline and policy propensity levels](hyp:hGap), [a finite discrete instrument domain](hyp:hFinite),
[a positive baseline interval count](hyp:hK), [covariate-invariant level ordering](hyp:hOrder),
[baseline overlap with the given lower bound](hyp:hov), and [policy overlap with that bound](hyp:hpol).
If [the finite first-stage rate holds](hyp:hRate), [policy levels avoid baseline boundaries](hyp:hOff),
[the specified gap witnesses level separation](hyp:hgap), and
[continuous nuisance estimates indexed by sample size and realization on the recovered level structure](hyp:eHat)
[satisfy dynamic fitting, finite component error rates, bounded boundary densities, and no lower-endpoint atom](hyp:hr), then
[the continuous DML lower-bound estimation error is of order the inverse square root of total sample size in probability along even sample sizes](goal). -/
lemma contDMLRegime_rootn_consistent
    (M : LatentIVModel Ω X Z) {A : Type*} [MeasurableSpace A]
    (μ : Measure A) [IsProbabilityMeasure μ] (S : ObservedSample M μ)
    (I₁ I₂ : SampleSplit A) (hSplit : EqualHalfSplit M μ S I₁ I₂)
    (phi dphi : Z → X → ℝ → ℝ) (hphi : IsPolicyMap phi)
    (hd : PolicyDifferentiable phi dphi)
    (hDerivative : PolicyDerivativeBoundedLipschitz dphi)
    (hStruct : StructuralAssumptions M) (hend : OutcomeEndpointsKnown M)
    (x0 : X) (hGap : PropensityGapSeparation M.prop (policyProp phi M.prop))
    (hFinite : InstrumentFiniteReduction Z)
    (hK : LevelCountPos (LevelStructure M.prop (policyProp phi M.prop) x0).K)
    (hOrder : LevelOrderInvariant M.prop (policyProp phi M.prop)
      (LevelStructure M.prop (policyProp phi M.prop) x0))
    (cpi : ℝ)
    (hov : BaselineOverlapWitness M (LevelStructure M.prop (policyProp phi M.prop) x0) cpi)
    (hpol : PolicyOverlap M (LevelStructure M.prop (policyProp phi M.prop) x0) cpi)
    (pHat : ℕ → A → Z → X → ℝ) (hRate : FiniteFirstStageRate M μ pHat)
    (rho : ℕ → ℝ) (gap ch : ℝ)
    (hOff : PolicyLevelOffBoundary (LevelStructure M.prop (policyProp phi M.prop) x0))
    (hgap : PropensityGapSeparationWitness M.prop (policyProp phi M.prop) gap)
    (eHat : ∀ n a, NuisanceCont (recoveredData M S I₁ I₂ pHat phi rho gap n a))
    (hr : FiniteContDMLRegime M μ S I₁ I₂ pHat phi rho gap cpi
      (LevelStructure M.prop (policyProp phi M.prop) x0) ch eHat) :
    let score := fittedContScore M S I₁ I₂ pHat phi dphi rho gap eHat
    let theta := thetaLower1 (transportData M) (policyWeight M (policyProp phi M.prop))
    Causalean.Stat.IsBigOp
      (fun n a => dmlRV M S I₂ score (2 * (n + 1)) a - theta)
      (fun n => (((2 * (n + 1) : ℕ) : ℝ) ^ (-1 / 2 : ℝ))) μ := by
  have hlaw := contDMLRegime_clt M μ S I₁ I₂ hSplit phi dphi hphi hd hDerivative
    hStruct hend x0 hGap hFinite hK hOrder cpi hov hpol pHat hRate rho gap ch
    hOff hgap eHat hr
  exact dml_rootn_consistent_of_normal_limit μ _ _ _ hlaw

-- @node: thm:dml-normality
/-- Assume [compact Borel domains](hyp:hDomains), [known outcome endpoints](hyp:hEndpoints),
[supported potential outcomes](hyp:hPotential), [consistency](hyp:hConsistency),
[instrument exogeneity](hyp:hExogeneity), [threshold crossing](hyp:hThreshold),
[uniform resistance](hyp:hUniform), and [common instrument support](hyp:hSupport).
For [an admissible policy](hyp:hPolicy) with [the specified derivative](hyp:hDifferentiable)
that [is bounded and Lipschitz](hyp:hDerivative), suppose [distinct baseline and policy levels are separated](hyp:hSeparation)
with [the specified separation gap](hyp:hGapWitness), [level ordering is invariant across covariates](hyp:hOrder),
[policy levels avoid baseline boundaries](hyp:hOffBoundary), [baseline overlap holds](hyp:hBaseline)
with [the specified positive lower bound](hyp:hOverlapWitness), and [policy overlap holds with that bound](hyp:hPolicyOverlap).
If [the instrument satisfies the finite-instrument DML conditions](hyp:hFinite) and [finite discrete reduction conditions](hyp:hFiniteReduction),
[the sample splits are equal halves](hyp:hSplit), [the propensity learner satisfies the first-stage rate](hyp:hFirstStage),
[the recovery thresholds satisfy the structural-zero restrictions](hyp:hThresholds), and
[the population has a positive number of baseline intervals](hyp:hK), then
[for every continuous or binary nuisance learner satisfying its corresponding DML regime, the lower-bound estimator is root-sample-size consistent, its error scaled by the square root of the evaluation-half size converges to a centered Gaussian with the true score's population variance, and its empirical score variance converges in probability to that variance](goal). -/
theorem dml_asymptotic_normality
    (hDomains : DomainsCompactBorel M) (hEndpoints : OutcomeEndpointsKnown M)
    (hPotential : PotentialSupport M) (hConsistency : Consistency M)
    (hExogeneity : InstrumentExogeneity M) (hThreshold : ThresholdCrossing M)
    (hUniform : UniformResistance M) (hSupport : CommonInstrumentSupport M)
    (phi dphi : Z → X → ℝ → ℝ) (hPolicy : IsPolicyMap phi)
    (hDifferentiable : PolicyDifferentiable phi dphi)
    (hDerivative : PolicyDerivativeBoundedLipschitz dphi)
    (x0 : X) (gap cpi : ℝ)
    (hSeparation : PropensityGapSeparation M.prop (policyProp phi M.prop))
    (hGapWitness : PropensityGapSeparationWitness M.prop (policyProp phi M.prop) gap)
    (hOrder : LevelOrderInvariant M.prop (policyProp phi M.prop) (LevelStructure M.prop (policyProp phi M.prop) x0))
    (hOffBoundary : PolicyLevelOffBoundary (LevelStructure M.prop (policyProp phi M.prop) x0))
    (hBaseline : BaselineOverlap M (LevelStructure M.prop (policyProp phi M.prop) x0))
    (hOverlapWitness : BaselineOverlapWitness M (LevelStructure M.prop (policyProp phi M.prop) x0) cpi)
    (hPolicyOverlap : PolicyOverlap M (LevelStructure M.prop (policyProp phi M.prop) x0) cpi)
    (hFinite : InstrumentFiniteDML Z)
    (hFiniteReduction : InstrumentFiniteReduction Z)
    (I₁ I₂ : SampleSplit A) (hSplit : EqualHalfSplit M μ S I₁ I₂)
    (pHat : ℕ → A → Z → X → ℝ) (hFirstStage : FirstStageRate M μ pHat)
    (rho : ℕ → ℝ)
    (hThresholds : StructuralZeroThreshold rho (pBar M S I₂ pHat)
      (fun n a => (recoverLevelsAt (pBar M S I₂ pHat n a)
        (pBar M S I₂ (fun n a => policyProp phi (pHat n a)) n a) (rho n) gap : LevelData Z X).S 0))
    (hK : LevelCountPos' (LevelStructure M.prop (policyProp phi M.prop) x0).K)
    (ch : ℝ) :
    let L := LevelStructure M.prop (policyProp phi M.prop) x0
    let theta := thetaLower1 (transportData M) (policyWeight M (policyProp phi M.prop))
    (∀ eHat : ∀ n a, NuisanceCont (recoveredData M S I₁ I₂ pHat phi rho gap n a),
      ContDMLRegime M μ S I₁ I₂ pHat phi rho gap cpi L ch eHat →
      let fitted := fittedContScore M S I₁ I₂ pHat phi dphi rho gap eHat
      let sigmaSq := populationVariance M (fun o => psiCont M phi dphi L hK o (trueNuisance M L)) theta
      Causalean.Stat.IsBigOp
        (fun n a => dmlRV M S I₂ fitted (2*(n+1)) a - theta)
        (fun n => ((2*(n+1) : ℕ) : ℝ)^(-1/2 : ℝ)) μ ∧
      Causalean.Stat.Modes.TendstoInLaw (fun _ : ℕ => μ)
        (fun n a => Real.sqrt ((n+1 : ℕ) : ℝ) * (dmlRV M S I₂ fitted (2*(n+1)) a - theta)) atTop
        (gaussianReal 0 (Real.toNNReal sigmaSq)) ∧
      Causalean.Stat.Modes.TendstoInProbability (fun _ : ℕ => μ)
        (fun n a => varianceRV M S I₂ fitted (2*(n+1)) a) atTop (fun _ _ => sigmaSq)) ∧
    (∀ eHat : ∀ n a, NuisanceBin (recoveredData M S I₁ I₂ pHat phi rho gap n a),
      BinDMLRegime M μ S I₁ I₂ pHat phi rho gap cpi L ch eHat →
      let fitted := fittedBinScore M S I₁ I₂ pHat phi dphi rho gap eHat
      let sigmaSq := populationVariance M (fun o => psiBin M phi dphi L hK o (eta0Bin M L)) theta
      Causalean.Stat.IsBigOp
        (fun n a => dmlRV M S I₂ fitted (2*(n+1)) a - theta)
        (fun n => ((2*(n+1) : ℕ) : ℝ)^(-1/2 : ℝ)) μ ∧
      Causalean.Stat.Modes.TendstoInLaw (fun _ : ℕ => μ)
        (fun n a => Real.sqrt ((n+1 : ℕ) : ℝ) * (dmlRV M S I₂ fitted (2*(n+1)) a - theta)) atTop
        (gaussianReal 0 (Real.toNNReal sigmaSq)) ∧
      Causalean.Stat.Modes.TendstoInProbability (fun _ : ℕ => μ)
        (fun n a => varianceRV M S I₂ fitted (2*(n+1)) a) atTop (fun _ _ => sigmaSq)) := by
  have hFirstStage := FirstStageRate.finite M μ pHat hFirstStage
  dsimp only
  constructor
  · intro eHat hr
    have hr := ContDMLRegime.finite M μ S I₁ I₂ pHat phi rho gap cpi _ ch eHat hr
    refine ⟨?_, ?_, ?_⟩
    · exact contDMLRegime_rootn_consistent M μ S I₁ I₂ hSplit phi dphi hPolicy
        hDifferentiable hDerivative
        ⟨hPotential, hConsistency, hExogeneity, hThreshold, hUniform, hSupport, hDomains⟩
        hEndpoints x0 hSeparation hFiniteReduction hK hOrder cpi
        hOverlapWitness hPolicyOverlap pHat hFirstStage rho gap ch hOffBoundary
        hGapWitness eHat hr
    · exact contDMLRegime_clt M μ S I₁ I₂ hSplit phi dphi hPolicy
        hDifferentiable hDerivative
        ⟨hPotential, hConsistency, hExogeneity, hThreshold, hUniform, hSupport, hDomains⟩
        hEndpoints x0 hSeparation hFiniteReduction hK hOrder cpi
        hOverlapWitness hPolicyOverlap pHat hFirstStage rho gap ch hOffBoundary
        hGapWitness eHat hr
    · exact contDMLRegime_variance_consistent M μ S I₁ I₂ hSplit phi dphi hPolicy
        hDifferentiable hDerivative
        ⟨hPotential, hConsistency, hExogeneity, hThreshold, hUniform, hSupport, hDomains⟩
        hEndpoints x0 hSeparation hFiniteReduction hK hOrder cpi
        hOverlapWitness hPolicyOverlap pHat hFirstStage rho gap ch hOffBoundary
        hGapWitness eHat hr
  · intro eHat hr
    have hr := BinDMLRegime.finite M μ S I₁ I₂ pHat phi rho gap cpi _ ch eHat hr
    refine ⟨?_, ?_, ?_⟩
    · exact binDMLRegime_rootn_consistent M μ S I₁ I₂ hSplit phi dphi hPolicy
        hDifferentiable hDerivative
        ⟨hPotential, hConsistency, hExogeneity, hThreshold, hUniform, hSupport, hDomains⟩
        hEndpoints x0 hSeparation hFiniteReduction hK hOrder cpi
        hOverlapWitness hPolicyOverlap pHat hFirstStage rho gap ch hOffBoundary
        hGapWitness eHat hr
    · exact binDMLRegime_clt M μ S I₁ I₂ hSplit phi dphi hPolicy
        hDifferentiable hDerivative
        ⟨hPotential, hConsistency, hExogeneity, hThreshold, hUniform, hSupport, hDomains⟩
        hEndpoints x0 hSeparation hFiniteReduction hK hOrder cpi
        hOverlapWitness hPolicyOverlap pHat hFirstStage rho gap ch hOffBoundary
        hGapWitness eHat hr
    · exact binDMLRegime_variance_consistent M μ S I₁ I₂ hSplit phi dphi hPolicy
        hDifferentiable hDerivative
        ⟨hPotential, hConsistency, hExogeneity, hThreshold, hUniform, hSupport, hDomains⟩
        hEndpoints x0 hSeparation hFiniteReduction hK hOrder cpi
        hOverlapWitness hPolicyOverlap pHat hFirstStage rho gap ch hOffBoundary
        hGapWitness eHat hr

end Papers.TbsPrteOptimalTransport
