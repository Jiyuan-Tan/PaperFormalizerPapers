/-! The discrete score moment and orthogonality statement, assembled after population helpers. -/
public section
set_option linter.style.emptyLine false
set_option linter.unusedSectionVars false
set_option linter.style.longLine false
set_option linter.style.openClassical false
set_option linter.unusedVariables false
namespace Papers.TbsPrteOptimalTransport
open MeasureTheory ProbabilityTheory Set Filter
open scoped Classical Topology
universe u v
variable {Ω : Type u} {X Z : Type v} [MeasurableSpace Ω]
  [MeasurableSpace X] [MeasurableSpace Z] [TopologicalSpace X] [TopologicalSpace Z]
  [BorelSpace X] [BorelSpace Z] [StandardBorelSpace X] [StandardBorelSpace Z]
  [Nonempty X] [Nonempty Z]
variable (M : LatentIVModel Ω X Z)
variable {A : Type*} [MeasurableSpace A] (μ : Measure A) [IsProbabilityMeasure μ]
variable (S : ObservedSample M μ) [Fintype Z] [DecidableEq Z]
-- @node: lem:orthogonality-discrete
/-- Assume [compact Borel domains](hyp:hDomains), [known outcome endpoints](hyp:hEndpoints),
[potential outcomes within their support](hyp:hPotential), [consistency](hyp:hConsistency),
[instrument exogeneity](hyp:hExogeneity), [threshold crossing](hyp:hThreshold),
[uniform resistance](hyp:hUniform), and [common instrument support](hyp:hSupport).
For [an admissible policy](hyp:hPolicy) with [derivative dphi](hyp:hDifferentiable) that
[is bounded and Lipschitz](hyp:hDerivative), suppose [the propensity and policy levels
are separated](hyp:hSeparation), [gap witnesses that separation](hyp:hGapWitness),
[the level ordering determined at x0 is invariant](hyp:hOrder), [policy levels avoid
the boundaries](hyp:hOffBoundary), [baseline overlap holds](hyp:hBaseline),
[cpi witnesses baseline overlap](hyp:hOverlapWitness), and [policy overlap holds with
the same constant](hyp:hPolicyOverlap). Under [the finite-instrument DML condition](hyp:hFinite),
[finite-instrument reduction](hyp:hFiniteReduction), [an equal-half sample split](hyp:hSplit),
[the first-stage propensity rate](hyp:hFirstStage), and [a positive number of treatment
levels](hyp:hK), [for each continuous or binary nuisance learner satisfying its
respective DML regime, the corresponding score at the true nuisance has mean equal to
the discrete policy target, and its population mean has derivative zero at zero along
every admissible nuisance direction](goal). -/
lemma score_mean_and_orthogonality
    (hDomains : DomainsCompactBorel M) (hEndpoints : OutcomeEndpointsKnown M)
    (hPotential : PotentialSupport M) (hConsistency : Consistency M)
    (hExogeneity : InstrumentExogeneity M) (hThreshold : ThresholdCrossing M)
    (hUniform : UniformResistance M) (hSupport : CommonInstrumentSupport M)
    (phi dphi : Z → X → ℝ → ℝ) (hPolicy : IsPolicyMap phi)
    (hDifferentiable : PolicyDifferentiable phi dphi)
    (hDerivative : PolicyDerivativeBoundedLipschitz dphi)
    (x0 : X) (gap cpi : ℝ)
    (hSeparation : PropensityGapSeparation M.prop (policyProp phi M.prop))
    (hGapWitness : PropensityGapSeparationWitness M.prop (policyProp phi M.prop) gap)
    (hOrder : LevelOrderInvariant M.prop (policyProp phi M.prop) (LevelStructure M.prop (policyProp phi M.prop) x0))
    (hOffBoundary : PolicyLevelOffBoundary (LevelStructure M.prop (policyProp phi M.prop) x0))
    (hBaseline : BaselineOverlap M (LevelStructure M.prop (policyProp phi M.prop) x0))
    (hOverlapWitness : BaselineOverlapWitness M (LevelStructure M.prop (policyProp phi M.prop) x0) cpi)
    (hPolicyOverlap : PolicyOverlap M (LevelStructure M.prop (policyProp phi M.prop) x0) cpi)
    (hFinite : InstrumentFiniteDML Z)
    (hFiniteReduction : InstrumentFiniteReduction Z)
    (I₁ I₂ : SampleSplit A) (hSplit : EqualHalfSplit M μ S I₁ I₂)
    (pHat : ℕ → A → Z → X → ℝ) (hFirstStage : FirstStageRate M μ pHat)
    (rho : ℕ → ℝ)
    (hK : LevelCountPos (LevelStructure M.prop (policyProp phi M.prop) x0).K)
    (ch : ℝ) :
    let L := LevelStructure M.prop (policyProp phi M.prop) x0
    (∀ eHat : ∀ n a, NuisanceCont (recoveredData M S I₁ I₂ pHat phi rho gap n a),
      ContDMLRegime M μ S I₁ I₂ pHat phi rho gap cpi L ch eHat →
      (∫ o, psiCont M phi dphi L hK o (trueNuisance M L) ∂observationLaw M) =
        discreteTarget M false L (policyProp phi M.prop) ∧
      ∀ del : NuisanceCont L,
        IsAdmissibleDirection M L (.inl (trueNuisance M L)) (.inl del) →
        HasDerivAt (fun t : ℝ => ∫ o, psiCont M phi dphi L hK o (trueNuisance M L + t • del)
          ∂observationLaw M) 0 0) ∧
    (∀ eHat : ∀ n a, NuisanceBin (recoveredData M S I₁ I₂ pHat phi rho gap n a),
      BinDMLRegime M μ S I₁ I₂ pHat phi rho gap cpi L ch eHat →
      (∫ o, psiBin M phi dphi L hK o (eta0Bin M L) ∂observationLaw M) =
        discreteTarget M false L (policyProp phi M.prop) ∧
      ∀ del : NuisanceBin L,
        IsAdmissibleDirection M L (.inr (eta0Bin M L)) (.inr del) →
        HasDerivAt (fun t : ℝ => ∫ o, psiBin M phi dphi L hK o (eta0Bin M L + t • del)
          ∂observationLaw M) 0 0) := by
  dsimp only
  constructor
  · intro eHat hreg
    constructor
    · have hstr : StructuralAssumptions M :=
        ⟨hPotential, hConsistency, hExogeneity, hThreshold, hUniform, hSupport, hDomains⟩
      have hlev := population_LevelStructure_baseline_measurable M hThreshold
        (policyProp phi M.prop) x0 hOrder
      have hq := population_policyProp_measurable M hThreshold phi hPolicy
      have hb := population_bandBoundary_measurable M (policyProp phi M.prop) hq
        _ hOrder hlev
      have hdphi := policy_derivative_graph_measurable phi dphi hPolicy
        hDifferentiable M.prop hThreshold.2.1 M.rangeProp
      exact (population_continuous_score_mean_eq_target M hstr hEndpoints
        phi dphi hPolicy hdphi hDerivative _ hK hOrder hlev cpi
        hOverlapWitness hPolicyOverlap (fun k hk j hj => hb k j hk hj)
        hreg.2.2.1 hreg.2.2.2).2
    · intro del hd
      have hstr : StructuralAssumptions M :=
        ⟨hPotential, hConsistency, hExogeneity, hThreshold, hUniform, hSupport, hDomains⟩
      have hlev := population_LevelStructure_baseline_measurable M hThreshold
        (policyProp phi M.prop) x0 hOrder
      have hq := population_policyProp_measurable M hThreshold phi hPolicy
      have hb := population_bandBoundary_measurable M (policyProp phi M.prop) hq
        _ hOrder hlev
      exact (population_continuous_total_joint_orthogonality_of_admissible M hstr hEndpoints
        phi dphi hPolicy hDifferentiable hDerivative _ hK hOrder hOffBoundary gap
        hGapWitness cpi hOverlapWitness hPolicyOverlap hreg.2.2.1 hreg.2.2.2 del hd
        (fun k j hk hj => hb k j hk hj)).1

  · intro eHat hreg
    constructor
    · have hstr : StructuralAssumptions M :=
        ⟨hPotential, hConsistency, hExogeneity, hThreshold, hUniform, hSupport, hDomains⟩
      have hlev := population_LevelStructure_baseline_measurable M hThreshold
        (policyProp phi M.prop) x0 hOrder
      have he := population_binary_nuisance_admissible M hThreshold hreg.2.2.1
        (policyProp phi M.prop) _ hOrder hlev cpi hPolicyOverlap
      have hdphi := policy_derivative_graph_measurable phi dphi hPolicy
        hDifferentiable M.prop hThreshold.2.1 M.rangeProp
      exact (population_binary_score_mean_eq_target M hstr hEndpoints hFiniteReduction
        phi dphi hPolicy hdphi hDerivative _ hK hOrder hlev cpi
        hOverlapWitness hPolicyOverlap hreg.2.2.1 he).2
    · intro del hd
      have hstr : StructuralAssumptions M :=
        ⟨hPotential, hConsistency, hExogeneity, hThreshold, hUniform, hSupport, hDomains⟩
      exact population_binary_total_joint_orthogonality_of_gap M hstr hEndpoints
        hFiniteReduction hreg.2.2.1 phi dphi hPolicy hDifferentiable hDerivative
        _ hK hOrder hOffBoundary gap hGapWitness cpi hOverlapWitness hPolicyOverlap
        hreg.2.2.2 del hd

end Papers.TbsPrteOptimalTransport
