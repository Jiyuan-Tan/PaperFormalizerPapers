/-!
# The distributional transform

Randomizing uniformly across each jump of a real probability law's cumulative
distribution function produces a uniform rank, and the lower quantile at that
rank recovers the outcome almost surely. No atomlessness or moment assumption
is needed, and the original random variable may be measurable only up to null sets.

The module defines the left cumulative distribution function `leftCDF` of a real
law (the mass strictly below a threshold) and the randomized rank
`distributionalTransform`, proves their measurability, order and jump lemmas, and
concludes with `map_distributionalTransform_eq_unifOI_and_ae_eq_quantile`.

The lower quantile and the uniform law on the open unit interval are those of
Causalean. The result is Rüschendorf (2009), Proposition 2.1, also stated in
Mathematical Risk Analysis (2013), Proposition 1.3.

Reference: https://doi.org/10.1016/j.jspi.2009.05.030
-/

@[expose] public section

open MeasureTheory ProbabilityTheory Set Filter
open scoped ENNReal Topology

namespace Toolkit.Tricks.Probability.Distributions
/-- For [a measure on the real line](hyp:ν) and [a real threshold](hyp:y),
the [left cumulative distribution value](goal) is the real-valued mass strictly
below that threshold. -/
noncomputable def leftCDF (ν : Measure ℝ) (y : ℝ) : ℝ := ν.real (Iio y)
/-- For [a real law](hyp:ν) and [an outcome paired with a randomization value](hyp:a),
the [distributional transform](goal) is the mass strictly below the outcome plus
the randomization value times the difference between its cumulative probability
and that strictly lower mass. -/
noncomputable def distributionalTransform (ν : Measure ℝ) (a : ℝ × ℝ) : ℝ :=
  leftCDF ν a.1 + a.2 * (cdf ν a.1 - leftCDF ν a.1)

/-- For [a real probability law](hyp:ν,hprob), [the mass strictly below a threshold
is nondecreasing as the threshold increases](goal). -/
lemma leftCDF_mono (ν : Measure ℝ) [hprob : IsProbabilityMeasure ν] : Monotone (leftCDF ν) := by
  intro a b hab
  exact measureReal_mono (Iio_subset_Iio hab)

/-- For [a real probability law](hyp:ν,hprob), [its left cumulative distribution
function is measurable](goal). -/
@[fun_prop] lemma measurable_leftCDF (ν : Measure ℝ) [hprob : IsProbabilityMeasure ν] :
    Measurable (leftCDF ν) := by
  exact (leftCDF_mono ν).measurable

/-- For [a real probability law](hyp:ν,hprob), [the distributional transform is
measurable jointly in the outcome and the randomization value](goal). -/
@[fun_prop] lemma measurable_distributionalTransform (ν : Measure ℝ)
    [hprob : IsProbabilityMeasure ν] :
    Measurable (distributionalTransform ν) := by
  have hc : Measurable (cdf ν) := (monotone_cdf ν).measurable
  unfold distributionalTransform
  fun_prop

/-- For [a real probability law](hyp:ν,hprob) at [a threshold](hyp:y), [the mass
strictly below the threshold does not exceed its cumulative probability](goal). -/
lemma leftCDF_le_cdf (ν : Measure ℝ) [hprob : IsProbabilityMeasure ν] (y : ℝ) :
    leftCDF ν y ≤ cdf ν y := by
  rw [cdf_eq_real]
  exact measureReal_mono Iio_subset_Iic_self

/-- For [a real probability law](hyp:ν,hprob), if [one threshold is strictly below
another](hyp:hab), then [the cumulative probability at the lower threshold does
not exceed the mass strictly below the upper threshold](goal). -/
lemma cdf_le_leftCDF (ν : Measure ℝ) [hprob : IsProbabilityMeasure ν] {a b : ℝ} (hab : a < b) :
    cdf ν a ≤ leftCDF ν b := by
  rw [cdf_eq_real]
  exact measureReal_mono (Iic_subset_Iio.mpr hab)

/-- For [a real probability law](hyp:ν,hprob) and [a threshold](hyp:y), [the mass
strictly below that threshold equals the left limit of the cumulative
distribution function there](goal). -/
lemma leftCDF_eq_leftLim (ν : Measure ℝ) [hprob : IsProbabilityMeasure ν] (y : ℝ) :
    leftCDF ν y = Function.leftLim (cdf ν) y := by
  have hn : 0 ≤ Function.leftLim (cdf ν) y :=
    (cdf_nonneg ν (y - 1)).trans ((monotone_cdf ν).le_leftLim (sub_lt_self y one_pos))
  have he : ν (Iio y) = ENNReal.ofReal (Function.leftLim (cdf ν) y) := by
    calc
      ν (Iio y) = (cdf ν).measure (Iio y) := by rw [measure_cdf]
      _ = _ := by rw [(cdf ν).measure_Iio (tendsto_cdf_atBot ν), sub_zero]
  change (ν (Iio y)).toReal = _
  rw [he, ENNReal.toReal_ofReal hn]

/-- For [a real probability law](hyp:ν,hprob) and [a positive quantile level](hyp:ht0),
[the mass strictly below the lower quantile does not exceed that level](goal). -/
lemma leftCDF_quantile_le (ν : Measure ℝ) [hprob : IsProbabilityMeasure ν]
    {t : ℝ} (ht0 : 0 < t) :
    leftCDF ν (Causalean.Stat.quantile ν t) ≤ t := by
  rw [leftCDF_eq_leftLim]
  apply le_of_tendsto ((monotone_cdf ν).tendsto_leftLim _)
  filter_upwards [self_mem_nhdsWithin] with y hy
  exact (lt_of_not_ge (fun h =>
    (not_le_of_gt hy) (Causalean.Stat.quantile_le_of_le_cdf ht0 h))).le

/-- For [a real probability law](hyp:ν,hprob), [an outcome](hyp:y) and [a
randomization value](hyp:s), if [the randomization value lies between zero and one
inclusive](hyp:hs), then [the distributional transform lies between the mass
strictly below the outcome and its cumulative probability](goal). -/
lemma distributionalTransform_bounds (ν : Measure ℝ) [hprob : IsProbabilityMeasure ν] (y s : ℝ)
    (hs : s ∈ Icc (0 : ℝ) 1) :
    leftCDF ν y ≤ distributionalTransform ν (y, s) ∧
      distributionalTransform ν (y, s) ≤ cdf ν y := by
  have hd := sub_nonneg.mpr (leftCDF_le_cdf ν y)
  dsimp [distributionalTransform]
  constructor
  · nlinarith [mul_nonneg hs.1 hd]
  · nlinarith [mul_nonneg (sub_nonneg.mpr hs.2) hd]

/-- If [a threshold is at most one](hyp:ht1), then [a uniform draw on the open
unit interval is strictly below it with probability equal to the nonnegative
part of the threshold](goal). -/
lemma unifOI_Iio {t : ℝ} (ht1 : t ≤ 1) :
    Causalean.Stat.unifOI (Iio t) = ENNReal.ofReal t := by
  rw [Causalean.Stat.unifOI, Measure.restrict_apply measurableSet_Iio]
  have he : Iio t ∩ Ioo (0 : ℝ) 1 = Ioo 0 t := by
    ext s
    simp only [mem_inter_iff, mem_Iio, mem_Ioo]
    constructor
    · exact fun h => ⟨h.2.1, h.1⟩
    · exact fun h => ⟨h.2, h.1, h.2.trans_le ht1⟩
  rw [he, Real.volume_Ioo, sub_zero]

/-- Under [a real probability law](hyp:ν,hprob) paired independently with the
uniform law on the open unit interval, [the second coordinate lies strictly
between zero and one almost surely](goal). -/
lemma ae_snd_mem_Ioo_prod_unifOI (ν : Measure ℝ) [hprob : IsProbabilityMeasure ν] :
    ∀ᵐ a ∂ν.prod Causalean.Stat.unifOI, a.2 ∈ Ioo (0 : ℝ) 1 := by
  exact (measurePreserving_snd (μ := ν) (ν := Causalean.Stat.unifOI)).quasiMeasurePreserving.ae
    (ae_restrict_mem measurableSet_Ioo)

/-- For [a real probability law](hyp:ν,hprob) and [a point](hyp:q), [the mass at
that point is its cumulative probability minus the mass strictly below it](goal). -/
lemma measureReal_singleton_eq_cdf_sub_leftCDF (ν : Measure ℝ) [hprob : IsProbabilityMeasure ν]
    (q : ℝ) :
    ν.real {q} = cdf ν q - leftCDF ν q := by
  have he := measureReal_union (μ := ν)
    (show Disjoint (Iio q) {q} by
      simp only [disjoint_left, mem_Iio, mem_singleton_iff]
      exact fun a ha he => ha.ne he) (measurableSet_singleton q)
  rw [Iio_union_right, ← cdf_eq_real] at he
  dsimp [leftCDF]
  linarith

/-- For [a real probability law](hyp:ν,hprob), suppose [the quantile level is
positive](hyp:ht0) and [less than one](hyp:ht1), [the randomization value is in the
open unit interval](hyp:hs), and [the lower quantile has positive mass](hyp:hd).
Then [the transform is below the level exactly when the outcome is below that
quantile, or equals it with randomization below the fraction of the atom needed
to reach the level](goal). -/
lemma distributionalTransform_lt_quantile_iff (ν : Measure ℝ) [hprob : IsProbabilityMeasure ν]
    {t y s : ℝ} (ht0 : 0 < t) (ht1 : t < 1) (hs : s ∈ Ioo (0 : ℝ) 1)
    (hd : 0 < cdf ν (Causalean.Stat.quantile ν t) - leftCDF ν (Causalean.Stat.quantile ν t)) :
    distributionalTransform ν (y,s) < t ↔ y < Causalean.Stat.quantile ν t ∨
      y = Causalean.Stat.quantile ν t ∧
        s < (t - leftCDF ν (Causalean.Stat.quantile ν t)) /
          (cdf ν (Causalean.Stat.quantile ν t) - leftCDF ν (Causalean.Stat.quantile ν t)) := by
  have hb := distributionalTransform_bounds ν y s ⟨hs.1.le, hs.2.le⟩
  rcases lt_trichotomy y (Causalean.Stat.quantile ν t) with hy | hy | hy
  · have hc : cdf ν y < t := lt_of_not_ge (fun hc =>
      (not_le_of_gt hy) (Causalean.Stat.quantile_le_of_le_cdf ht0 hc))
    exact iff_of_true (hb.2.trans_lt hc) (Or.inl hy)
  · subst y
    simp only [lt_self_iff_false, false_or, true_and]
    rw [lt_div_iff₀ hd]
    dsimp [distributionalTransform]
    constructor <;> intro hh <;> linarith
  · have hl := cdf_le_leftCDF ν hy
    have ht := Causalean.Stat.le_cdf_quantile (μ := ν) ht1
    have hn : ¬ distributionalTransform ν (y,s) < t := not_lt.mpr (ht.trans (hl.trans hb.1))
    simp only [hn, false_iff, not_or, not_and]
    exact ⟨not_lt.mpr hy.le, fun he => (ne_of_gt hy) he |>.elim⟩

-- Strict left rays avoid assigning positive mass to the ends of CDF plateaus.
-- The event splits into the lower ray and a fraction of the quantile's atom.
/-- For [a real probability law](hyp:ν,hprob), if [a threshold is positive](hyp:ht0)
and [less than one](hyp:ht1), then [the probability that the distributional
transform is strictly below the threshold equals the threshold](goal), using an
independent outcome draw and uniform randomization. -/
lemma distributionalTransform_Iio_interior (ν : Measure ℝ) [hprob : IsProbabilityMeasure ν]
    {t : ℝ} (ht0 : 0 < t) (ht1 : t < 1) :
    (ν.prod Causalean.Stat.unifOI) ((distributionalTransform ν) ⁻¹' Iio t) = ENNReal.ofReal t := by
  let q := Causalean.Stat.quantile ν t
  let A := leftCDF ν q
  let B := cdf ν q
  have hA : A ≤ t := leftCDF_quantile_le ν ht0
  have hB : t ≤ B := Causalean.Stat.le_cdf_quantile ht1
  have hAB : A ≤ B := leftCDF_le_cdf ν q
  have hAn : 0 ≤ A := measureReal_nonneg
  have hBn : B ≤ 1 := cdf_le_one ν q
  have hnull := ae_snd_mem_Ioo_prod_unifOI ν
  rcases lt_or_eq_of_le hAB with hd | hd
  · let r := (t - A) / (B - A)
    have hd' : 0 < B - A := sub_pos.mpr hd
    have hr0 : 0 ≤ r := div_nonneg (sub_nonneg.mpr hA) hd'.le
    have hr1 : r ≤ 1 := (div_le_one hd').mpr (by linarith)
    have he : (distributionalTransform ν ⁻¹' Iio t) =ᵐ[ν.prod Causalean.Stat.unifOI]
        (((Iio q ×ˢ univ) ∪ ({q} ×ˢ Iio r)) : Set (ℝ × ℝ)) := by
      filter_upwards [hnull] with a ha
      apply propext
      change distributionalTransform ν a < t ↔ (a.1 < q ∧ True) ∨ (a.1 = q ∧ a.2 < r)
      simpa only [and_true] using
        (distributionalTransform_lt_quantile_iff ν (y := a.1) ht0 ht1 ha hd')
    rw [measure_congr he, measure_union]
    · rw [Measure.prod_prod, Measure.prod_prod, measure_univ, mul_one,
        unifOI_Iio hr1, ← ofReal_measureReal (μ := ν) (s := Iio q),
        ← ofReal_measureReal (μ := ν) (s := {q}), measureReal_singleton_eq_cdf_sub_leftCDF]
      change ENNReal.ofReal A + ENNReal.ofReal (B - A) * ENNReal.ofReal r = _
      rw [← ENNReal.ofReal_mul hd'.le, ← ENNReal.ofReal_add hAn (mul_nonneg hd'.le hr0)]
      congr 1
      dsimp [r]
      rw [mul_div_cancel₀ _ (ne_of_gt hd')]
      ring
    · apply Set.disjoint_prod.mpr
      apply Or.inl
      simp only [disjoint_left, mem_Iio, mem_singleton_iff]
      exact fun y hy he => hy.ne he
    · exact (measurableSet_singleton q).prod measurableSet_Iio
  · have hAt : A = t := le_antisymm hA (by simpa [← hd] using hB)
    have he : (distributionalTransform ν ⁻¹' Iio t) =ᵐ[ν.prod Causalean.Stat.unifOI]
        (Iio q ×ˢ univ : Set (ℝ × ℝ)) := by
      filter_upwards [hnull] with a ha
      apply propext
      change distributionalTransform ν a < t ↔ (a.1 < q ∧ True)
      simp only [and_true]
      rcases lt_trichotomy a.1 q with hy | hy | hy
      · have hc : cdf ν a.1 < t := lt_of_not_ge (fun hc =>
          (not_le_of_gt hy) (Causalean.Stat.quantile_le_of_le_cdf ht0 hc))
        exact iff_of_true
          ((distributionalTransform_bounds ν a.1 a.2 ⟨ha.1.le, ha.2.le⟩).2.trans_lt hc) hy
      · have hr : distributionalTransform ν a = t := by
          change leftCDF ν a.1 + a.2 * (cdf ν a.1 - leftCDF ν a.1) = t
          rw [hy]
          change A + a.2 * (B - A) = t
          rw [← hd, sub_self, mul_zero, add_zero, hAt]
        simp [hr, hy]
      · have hl := cdf_le_leftCDF ν hy
        have hb := (distributionalTransform_bounds ν a.1 a.2 ⟨ha.1.le, ha.2.le⟩).1
        exact iff_of_false (not_lt.mpr (hB.trans (hl.trans hb))) (not_lt.mpr hy.le)
    rw [measure_congr he, Measure.prod_prod, measure_univ, mul_one,
      ← ofReal_measureReal (μ := ν) (s := Iio q)]
    change ENNReal.ofReal A = _
    rw [hAt]

/-- For [a real probability law](hyp:ν,hprob), [the distributional transform of
an outcome draw and an independent uniform randomization has the uniform law
on the open unit interval](goal), including when the outcome law has atoms. -/
lemma map_distributionalTransform_eq_unifOI (ν : Measure ℝ) [hprob : IsProbabilityMeasure ν] :
    (ν.prod Causalean.Stat.unifOI).map (distributionalTransform ν) = Causalean.Stat.unifOI := by
  let ρ := (ν.prod Causalean.Stat.unifOI).map (distributionalTransform ν)
  have hm := measurable_distributionalTransform ν
  have : IsProbabilityMeasure ρ := Measure.isProbabilityMeasure_map hm.aemeasurable
  have hmid {t : ℝ} (ht0 : 0 < t) (ht1 : t < 1) : ρ (Iio t) = ENNReal.ofReal t := by
    rw [Measure.map_apply hm measurableSet_Iio]
    exact distributionalTransform_Iio_interior ν ht0 ht1
  have hlow {t : ℝ} (ht : t ≤ 0) : ρ (Iio t) = 0 := by
    rw [Measure.map_apply hm measurableSet_Iio]
    have he : (distributionalTransform ν ⁻¹' Iio t) =ᵐ[ν.prod Causalean.Stat.unifOI]
        (∅ : Set (ℝ × ℝ)) := by
      filter_upwards [ae_snd_mem_Ioo_prod_unifOI ν] with a ha
      apply propext
      change distributionalTransform ν a < t ↔ False
      have hb := (distributionalTransform_bounds ν a.1 a.2 ⟨ha.1.le, ha.2.le⟩).1
      have hn : 0 ≤ leftCDF ν a.1 := measureReal_nonneg
      exact iff_false_intro (not_lt.mpr (ht.trans (hn.trans hb)))
    rw [measure_congr he, measure_empty]
  have hhigh {t : ℝ} (ht : 1 ≤ t) : ρ (Iio t) = 1 := by
    have hr : 1 ≤ ρ.real (Iio t) := by
      apply le_of_forall_lt_imp_le_of_dense
      intro r hr
      by_cases hr0 : 0 < r
      · have he : ρ.real (Iio r) = r := by
          rw [measureReal_def, hmid hr0 hr, ENNReal.toReal_ofReal hr0.le]
        rw [← he]
        exact measureReal_mono (μ := ρ) (Iio_subset_Iio (hr.le.trans ht))
      · exact (le_of_not_gt hr0).trans measureReal_nonneg
    have he : ρ.real (Iio t) = 1 := le_antisymm (by
      calc
        ρ.real (Iio t) ≤ ρ.real univ := measureReal_mono (subset_univ _)
        _ = 1 := by simp) hr
    rw [← ofReal_measureReal (μ := ρ) (s := Iio t), he, ENNReal.ofReal_one]
  have hrays (t : ℝ) : ρ (Iio t) = Causalean.Stat.unifOI (Iio t) := by
    by_cases ht0 : 0 < t
    · by_cases ht1 : t < 1
      · rw [hmid ht0 ht1, unifOI_Iio ht1.le]
      · rw [hhigh (le_of_not_gt ht1)]
        have he : Iio t ∩ Ioo (0 : ℝ) 1 = Ioo 0 1 := by
          ext s
          constructor
          · exact fun h => h.2
          · exact fun h => ⟨h.2.trans_le (le_of_not_gt ht1), h⟩
        rw [Causalean.Stat.unifOI, Measure.restrict_apply measurableSet_Iio,
          he, Real.volume_Ioo]
        norm_num
    · rw [hlow (le_of_not_gt ht0)]
      have he : Iio t ∩ Ioo (0 : ℝ) 1 = ∅ := by
        ext s
        simp only [mem_inter_iff, mem_Iio, mem_Ioo, mem_empty_iff_false, iff_false, not_and]
        exact fun h hs _ => (not_lt_of_ge (le_of_not_gt ht0)) (hs.trans h)
      rw [Causalean.Stat.unifOI, Measure.restrict_apply measurableSet_Iio, he, measure_empty]
  apply Measure.ext_of_Ici ρ Causalean.Stat.unifOI
  intro t
  rw [← compl_Iio, measure_compl measurableSet_Iio (by finiteness),
    measure_compl measurableSet_Iio (by finiteness), hrays, measure_univ, measure_univ]

-- A bounded strictly increasing transform makes the order argument integrable
-- without any moment assumption on either of the original random variables.
/-- Under [a finite measure](hyp:μ,hfinite), if [a first real variable is measurable
up to null sets](hyp:f,hf), [a second is also measurable up to null sets](hyp:g,hg),
[their laws coincide](hyp:hmap), and [the first is almost surely no greater than
the second](hyp:hle), then [the two variables agree almost surely](goal).

Applying the bounded strictly increasing arctangent makes the comparison
integrable without assuming moments of either original variable. -/
lemma ae_eq_of_ae_le_of_map_eq {A : Type*} [MeasurableSpace A]
    (μ : Measure A) [hfinite : IsFiniteMeasure μ] (f g : A → ℝ)
    (hf : AEMeasurable f μ) (hg : AEMeasurable g μ)
    (hmap : μ.map f = μ.map g) (hle : f ≤ᵐ[μ] g) : f =ᵐ[μ] g := by
  have hi (z : A → ℝ) (hz : AEMeasurable z μ) :
      Integrable (fun a => Real.arctan (z a)) μ := by
    refine ⟨(Real.continuous_arctan.measurable.comp_aemeasurable hz).aestronglyMeasurable, ?_⟩
    apply HasFiniteIntegral.of_bounded (C := Real.pi / 2)
    filter_upwards [] with a
    rw [Real.norm_eq_abs, abs_le]
    exact ⟨(Real.arctan_mem_Ioo (z a)).1.le, (Real.arctan_mem_Ioo (z a)).2.le⟩
  have hint : (∫ a, Real.arctan (f a) ∂μ) = ∫ a, Real.arctan (g a) ∂μ := by
    rw [← integral_map hf Real.continuous_arctan.measurable.aestronglyMeasurable,
      ← integral_map hg Real.continuous_arctan.measurable.aestronglyMeasurable, hmap]
  have he := (integral_eq_iff_of_ae_le (hi f hf) (hi g hg)
    (hle.mono fun a ha => Real.arctan_mono ha)).mp hint
  exact he.mono fun a ha => Real.arctan_injective ha

-- The quantile order characterization gives Q(rank) ≤ y. Both sides have law ν,
-- so the preceding order lemma upgrades this inequality to almost-sure equality.
/-- For [a real probability law](hyp:ν,hprob), [its lower quantile at the
distributional transform equals the original outcome almost surely](goal),
under an outcome draw and independent uniform randomization.

The quantile is bounded above by the outcome and both have the same law;
the preceding order lemma gives equality without any moment assumption. -/
lemma ae_quantile_distributionalTransform_eq (ν : Measure ℝ) [hprob : IsProbabilityMeasure ν] :
    ∀ᵐ a ∂ν.prod Causalean.Stat.unifOI,
      Causalean.Stat.quantile ν (distributionalTransform ν a) = a.1 := by
  let μ := ν.prod Causalean.Stat.unifOI
  have hm : AEMeasurable (distributionalTransform ν) μ :=
    (measurable_distributionalTransform ν).aemeasurable
  have hU := map_distributionalTransform_eq_unifOI ν
  have hQ : AEMeasurable (Causalean.Stat.quantile ν) (μ.map (distributionalTransform ν)) := by
    rw [hU]
    exact Causalean.Stat.aemeasurable_quantile_unifOI ν
  have hQcomp := hQ.comp_aemeasurable hm
  have hmap : μ.map (fun a => Causalean.Stat.quantile ν (distributionalTransform ν a)) =
      μ.map Prod.fst := by
    change μ.map (Causalean.Stat.quantile ν ∘ distributionalTransform ν) = μ.map Prod.fst
    rw [← AEMeasurable.map_map_of_aemeasurable hQ hm]
    change ((ν.prod Causalean.Stat.unifOI).map (distributionalTransform ν)).map _ = _
    rw [hU, Causalean.Stat.quantile_map_uniform]
    simp [μ]
  apply ae_eq_of_ae_le_of_map_eq μ _ Prod.fst hQcomp measurable_fst.aemeasurable hmap
  have hmem : ∀ᵐ a ∂μ, distributionalTransform ν a ∈ Ioo (0 : ℝ) 1 := by
    apply ae_of_ae_map hm
    rw [hU]
    exact ae_restrict_mem measurableSet_Ioo
  filter_upwards [hmem, ae_snd_mem_Ioo_prod_unifOI ν] with a ha hs
  exact Causalean.Stat.quantile_le_of_le_cdf ha.1
    (distributionalTransform_bounds ν a.1 a.2 ⟨hs.1.le, hs.2.le⟩).2

-- Pull the single-law result back along the measured variable. Measurable
-- representatives are used only to justify the product pushforward identity.
/-- On [a probability space](hyp:μ,hprob), if [a real random variable is measurable
up to null sets](hyp:f,hf), then [its randomized rank is uniform on the open unit
interval and the lower quantile of its law at that rank recovers the variable
almost surely](goal), even when its law has atoms.

The rank is the mass strictly below the observed value plus an independent
uniform fraction of the mass at that value. This is Rüschendorf's distributional
transform, Proposition 2.1 (2009), or Proposition 1.3 (2013). -/
theorem map_distributionalTransform_eq_unifOI_and_ae_eq_quantile {A : Type*} [MeasurableSpace A]
    (μ : Measure A) [hprob : IsProbabilityMeasure μ] (f : A → ℝ) (hf : AEMeasurable f μ) :
    (μ.prod Causalean.Stat.unifOI).map (fun a => distributionalTransform (μ.map f) (f a.1, a.2)) =
      Causalean.Stat.unifOI ∧
    (∀ᵐ a ∂μ.prod Causalean.Stat.unifOI,
      f a.1 = Causalean.Stat.quantile (μ.map f)
        (distributionalTransform (μ.map f) (f a.1, a.2))) := by
  have : IsProbabilityMeasure (μ.map f) := Measure.isProbabilityMeasure_map hf
  let g : A × ℝ → ℝ × ℝ := fun a => (f a.1, a.2)
  have he : g =ᵐ[μ.prod Causalean.Stat.unifOI] Prod.map (hf.mk f) id := by
    have hfst :=
      (measurePreserving_fst (μ := μ) (ν := Causalean.Stat.unifOI)).quasiMeasurePreserving.ae
        hf.ae_eq_mk
    filter_upwards [hfst] with a ha
    exact congrArg (fun y => (y, a.2)) ha
  have hg : AEMeasurable g (μ.prod Causalean.Stat.unifOI) := by
    exact (hf.measurable_mk.prodMap measurable_id).aemeasurable.congr he.symm
  have hmap : (μ.prod Causalean.Stat.unifOI).map g = (μ.map f).prod Causalean.Stat.unifOI := by
    rw [Measure.map_congr he, ← Measure.map_prod_map μ Causalean.Stat.unifOI
      hf.measurable_mk measurable_id, Measure.map_id, ← Measure.map_congr hf.ae_eq_mk]
  constructor
  · change (μ.prod Causalean.Stat.unifOI).map (distributionalTransform (μ.map f) ∘ g) = _
    rw [← AEMeasurable.map_map_of_aemeasurable
      ((measurable_distributionalTransform (μ.map f)).aemeasurable) hg, hmap]
    exact map_distributionalTransform_eq_unifOI (μ.map f)
  · have hr : ∀ᵐ b ∂(μ.prod Causalean.Stat.unifOI).map g,
        b.1 = Causalean.Stat.quantile (μ.map f) (distributionalTransform (μ.map f) b) := by
      rw [hmap]
      exact (ae_quantile_distributionalTransform_eq (μ.map f)).mono fun b hb => hb.symm
    exact ae_of_ae_map hg hr

end Toolkit.Tricks.Probability.Distributions
