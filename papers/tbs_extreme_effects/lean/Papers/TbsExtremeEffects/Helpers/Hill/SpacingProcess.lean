module
public import Papers.TbsExtremeEffects.Helpers.Hill.IncrementLaw

/-! The stopped centered partial-sum process of independent exponential spacings,
with the filtration generated by the spacings already revealed. -/

@[expose] public section
namespace Papers.TbsExtremeEffects
open MeasureTheory ProbabilityTheory
open scoped ENNReal
variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {n : ℕ}

/-- Given [a sample size](hyp:n), [spacing variables](hyp:S) with [measurable coordinates](hyp:hS), the [spacing filtration](goal)
at each time reveals exactly the spacings with smaller indices. -/
-- @node: hillSpacingFiltration
def hillSpacingFiltration (S : Fin n → Ω → ℝ) (hS : ∀ j, Measurable (S j)) :
    Filtration ℕ mΩ where
  seq i := ⨆ j : Fin n, ⨆ (_ : (j : ℕ) < i), MeasurableSpace.comap (S j) inferInstance
  mono' := by
    intro i k hik
    exact iSup_le fun j => iSup_le fun hj =>
      le_iSup_of_le j (le_iSup_of_le (hj.trans_le hik) le_rfl)
  le' i := iSup_le fun j => iSup_le fun _ => (hS j).comap_le

/-- Given [spacing variables](hyp:S), [measurable coordinates](hyp:hS), and [a time](hyp:i), the [centered sum of spacings revealed before that time is measurable](goal). -/
@[fun_prop]
-- @node: hill_spacing_sum_measurable
lemma hill_spacing_sum_measurable (S : Fin n → Ω → ℝ)
    (hS : ∀ j, Measurable (S j)) (i : ℕ) :
    Measurable (fun w => ∑ j : Fin n, if (j : ℕ) < i then S j w - 1 else 0) := by
  apply Finset.measurable_sum
  intro j _
  split_ifs <;> fun_prop

/-- Given [spacing variables](hyp:S) with [measurable coordinates](hyp:hS), the [centered cumulative-spacing process is strongly adapted to its spacing filtration](goal). -/
-- @node: hill_spacing_sum_stronglyAdapted
lemma hill_spacing_sum_stronglyAdapted (S : Fin n → Ω → ℝ)
    (hS : ∀ j, Measurable (S j)) :
    StronglyAdapted (hillSpacingFiltration S hS)
      (fun i w => ∑ j : Fin n, if (j : ℕ) < i then S j w - 1 else 0) := by
  intro i
  apply Measurable.stronglyMeasurable
  apply Finset.measurable_sum
  intro j _
  by_cases hj : (j : ℕ) < i
  · simp only [if_pos hj]
    have hm : Measurable[hillSpacingFiltration S hS i] (S j) :=
      (comap_measurable (S j)).mono
        (le_iSup_of_le j (le_iSup_of_le hj le_rfl)) le_rfl
    fun_prop
  · simp only [if_neg hj]
    fun_prop

omit mΩ in
/-- Given [spacing variables](hyp:S), [a time](hyp:i) before the sample end [as certified by](hyp:hi), and [an outcome](hyp:w), the [next increment of the centered cumulative sum, shifted by one, is the corresponding spacing](goal). -/
-- @node: hill_spacing_sum_increment
lemma hill_spacing_sum_increment (S : Fin n → Ω → ℝ) (i : ℕ) (hi : i < n) (w : Ω) :
    (∑ j : Fin n, if (j : ℕ) < i + 1 then S j w - 1 else 0) -
      (∑ j : Fin n, if (j : ℕ) < i then S j w - 1 else 0) + 1 = S ⟨i, hi⟩ w := by
  rw [← Finset.sum_sub_distrib]
  have heq : ∀ j : Fin n,
      (if (j : ℕ) < i + 1 then S j w - 1 else 0) -
        (if (j : ℕ) < i then S j w - 1 else 0) =
        if j = ⟨i, hi⟩ then S j w - 1 else 0 := by
    intro j
    by_cases hj : j = ⟨i, hi⟩
    · subst j; simp
    · have hne : (j : ℕ) ≠ i := by intro he; apply hj; exact Fin.ext he
      have hiff : (j : ℕ) < i + 1 ↔ (j : ℕ) < i := by omega
      simp only [hiff, if_neg hj]
      split_ifs <;> ring
  simp_rw [heq]
  simp

/-- If [the spacing variables are measurable](hyp:hS) and [mutually independent under the measure](hyp:hInd), then [the spacing at a time before the sample end](hyp:hi) is [independent of the past spacing filtration](goal).
Here [the probability measure](hyp:P), [the spacing variables](hyp:S), and [the time](hyp:i) identify the random variable and its past. -/
-- @node: hill_spacing_indep_past
lemma hill_spacing_indep_past (P : Measure Ω) (S : Fin n → Ω → ℝ)
    (hS : ∀ j, Measurable (S j)) (hInd : iIndepFun S P) (i : ℕ) (hi : i < n) :
    Indep (MeasurableSpace.comap (S ⟨i, hi⟩) inferInstance)
      (hillSpacingFiltration S hS i) P := by
  have h := indep_iSup_of_disjoint (fun j => (hS j).comap_le) hInd
    (S := {⟨i, hi⟩}) (T := {j : Fin n | (j : ℕ) < i}) (by
      apply Set.disjoint_left.mpr
      intro j hj ht
      simp only [Set.mem_singleton_iff] at hj
      subst j
      exact (lt_irrefl i) ht)
  simpa only [Set.mem_singleton_iff, iSup_iSup_eq_left, Set.mem_ofPred_eq,
    hillSpacingFiltration] using h

/-- If [the spacing variables are measurable](hyp:hS), [independent](hyp:hInd), and [each has the standard exponential law](hyp:hLaw), and [a process](hyp:B) is [their stated centered cumulative sum](hyp:hB), then [there is a filtration under which that process is measurable, adapted, eventually constant, and has independent standard-exponential shifted increments](goal).
Here [the probability measure](hyp:P) and [the spacing variables](hyp:S) describe the experiment. -/
-- @node: hill_spacing_process_data
lemma hill_spacing_process_data (P : Measure Ω) (S : Fin n → Ω → ℝ)
    (hS : ∀ j, Measurable (S j)) (hInd : iIndepFun S P)
    (hLaw : ∀ j, P.map (S j) = expMeasure 1) (B : ℕ → Ω → ℝ)
    (hB : ∀ i w, B i w = ∑ j : Fin n, if (j : ℕ) < i then S j w - 1 else 0) :
    ∃ ℱ : Filtration ℕ mΩ,
      (∀ i, Measurable (B i)) ∧ StronglyAdapted ℱ B ∧
      (∀ i, n ≤ i → ∀ w, B i w = B n w) ∧
      (∀ i < n,
        P.map (fun w => B (i + 1) w - B i w + 1) = expMeasure 1 ∧
        Indep (MeasurableSpace.comap (fun w => B (i + 1) w - B i w + 1)
          inferInstance) (ℱ i) P) := by
  have hfun : B = fun i w => ∑ j : Fin n, if (j : ℕ) < i then S j w - 1 else 0 :=
    funext fun i => funext (hB i)
  refine ⟨hillSpacingFiltration S hS, ?_, ?_, ?_, ?_⟩
  · rw [hfun]
    exact hill_spacing_sum_measurable S hS
  · rw [hfun]
    exact hill_spacing_sum_stronglyAdapted S hS
  · intro i hi w
    simp only [hB]
    apply Finset.sum_congr rfl
    intro j _
    rw [if_pos (j.isLt.trans_le hi), if_pos j.isLt]
  · intro i hi
    have heq : (fun w => B (i + 1) w - B i w + 1) = S ⟨i, hi⟩ := by
      funext w
      simp only [hB]
      exact hill_spacing_sum_increment S i hi w
    rw [heq]
    exact ⟨hLaw _, hill_spacing_indep_past P S hS hInd i hi⟩

end Papers.TbsExtremeEffects
