module
public import Papers.TbsExtremeEffects.Helpers.ScoreSampling
public import Papers.TbsExtremeEffects.Helpers.Count
public import Mathlib.MeasureTheory.Integral.Prod

/-! Measurability of fitted score means, moments, and evaluation events. -/

public section
namespace Papers.TbsExtremeEffects
open MeasureTheory ProbabilityTheory Filter
open scoped ENNReal Classical
variable {q d : ℕ} {M : ExtremeModel q d}

-- @node: trainSigma_le
/-- [The sigma-field generated by the training data](goal) is contained in the experiment's ambient measurable space. -/
lemma trainSigma_le (E : NeteExperiment M) (n : ℕ) :
    trainSigma E n ≤ E.measurableSpace := by
  apply Measurable.comap_le
  unfold trainingMap
  have hobs := measurable_obs_tuple M E n
  have htuple : Measurable (fun (w : E.Om) (i : Fin n) =>
      if i.val < n / 2 then obs E n w i else (0, false, 0, 0)) := by
    apply measurable_pi_lambda
    intro i
    split_ifs
    · exact (measurable_pi_apply i).comp hobs
    · exact measurable_const
  exact htuple.prodMk ((E.measurable_train n).prodMk E.measurable_aux)

-- @node: measurable_score_joint
/-- If [the fitted exponent is training-measurable](hyp:hTraining), then [the score as a joint function of the experiment outcome and one observation is measurable](goal). -/
@[fun_prop] lemma measurable_score_joint (E : NeteExperiment M)
    (kind : EstimatorKind) {n : ℕ} (hTraining : ExponentTraining E n) :
    Measurable (fun z : E.Om × Obs q d => score E kind n z.1 z.2) := by
  first | fun_prop | skip
  have halpha := hTraining.mono (trainSigma_le E n) le_rfl
  have hpTrain := (E.pHat_training n).mono
    (sup_le_sup (MeasurableSpace.comap_mono (trainSigma_le E n)) le_rfl) le_rfl
  have hgSigma : MeasurableSpace.comap
      (fun w => (trainingMap E.Zraw E.trainSet E.aux n w, E.alphaHat n w))
        inferInstance ≤ E.measurableSpace := by
    apply Measurable.comap_le
    exact (measurable_iff_comap_le.mpr (trainSigma_le E n)).prodMk halpha
  have hgTrain := (E.gHat_training n).mono
    (sup_le_sup (MeasurableSpace.comap_mono hgSigma) le_rfl) le_rfl
  have hdir : Measurable (fun z : E.Om × Obs q d => obsDirection z.2) := by
    unfold obsDirection
    fun_prop
  have hp : Measurable (fun z : E.Om × Obs q d => E.pHat n z.1 z.2.1) :=
    hpTrain.comp (measurable_fst.prodMk measurable_snd.fst)
  have hg (a : E.Om × Obs q d → Bool) (ha : Measurable a) :
      Measurable (fun z => E.gHat n z.1 z.2.1 (a z) (obsDirection z.2)) :=
    hgTrain.comp (measurable_fst.prodMk (measurable_snd.fst.prodMk (ha.prodMk hdir)))
  have hY : Measurable (fun z : E.Om × Obs q d => pseudoOutcome E n z.1 z.2) := by
    unfold pseudoOutcome
    fun_prop
  have hD1 : Measurable (fun z : E.Om × Obs q d => if z.2.2.1 then (1 : ℝ) else 0) :=
    (measurable_of_finite (fun b : Bool => if b then (1 : ℝ) else 0)).comp
      measurable_snd.snd.fst
  have hD0 : Measurable (fun z : E.Om × Obs q d => if z.2.2.1 then (0 : ℝ) else 1) :=
    (measurable_of_finite (fun b : Bool => if b then (0 : ℝ) else 1)).comp
      measurable_snd.snd.fst
  cases kind
  · exact hY.mul ((hD1.div hp).sub (hD0.div (measurable_const.sub hp)))
  · exact ((hg (fun _ => true) measurable_const).sub (hg (fun _ => false) measurable_const)).add
      (((hD1.sub hp).div (hp.mul (measurable_const.sub hp))).mul
        (hY.sub (hg (fun z => z.2.2.1) measurable_snd.snd.fst)))

-- @node: measurable_score_mean
/-- If [the noise is regularly varying](hyp:hRV) and [the fitted exponent is training-measurable](hyp:hTraining), then [the tail-law mean of the score is measurable as a function of the experiment outcome](goal). -/
@[fun_prop] lemma measurable_score_mean (E : NeteExperiment M) (kind : EstimatorKind)
    (hRV : NoiseRegularlyVarying M) {n : ℕ} (hTraining : ExponentTraining E n) (t : ℝ) :
    Measurable (fun w => ∫ z, score E kind n w z ∂obsTailLaw M t) := by
  first | fun_prop | skip
  let := obsTailLaw_probability M hRV t
  exact (measurable_score_joint E kind hTraining).stronglyMeasurable.integral_prod_right'.measurable

-- @node: measurable_etaEstimate
/-- If [the fitted exponent is training-measurable](hyp:hTraining), then [the estimated target based on the evaluation sample is measurable](goal). -/
@[fun_prop] lemma measurable_etaEstimate (E : NeteExperiment M) (kind : EstimatorKind)
    {n : ℕ} (hTraining : ExponentTraining E n) (t : ℝ) :
    Measurable (etaEstimate E kind n t) := by
  classical
  first | fun_prop | skip
  have hs := measurable_score_joint E kind hTraining
  have hobs (i : Fin n) : Measurable (fun w => obs E n w i) :=
    (measurable_pi_apply i).comp (measurable_obs_tuple M E n)
  have hsum : Measurable (fun w => ∑ i ∈ evalSet E n t w,
      score E kind n w (obs E n w i)) := by
    simp only [evalSet, Finset.sum_filter]
    apply Finset.measurable_fun_sum
    intro i _
    apply Measurable.ite (measurableSet_lt measurable_const ?_)
      (hs.comp (measurable_id.prodMk (hobs i))) measurable_const
    exact measurable_l1Norm.comp (hobs i).snd.snd.snd
  have hc := measurable_evalCount_real E n t
  have hzero : MeasurableSet {w | evalCount E n t w = 0} := by
    simpa only [Nat.cast_eq_zero] using (measurableSet_eq_fun hc
      (measurable_const : Measurable (fun _ : E.Om => (0 : ℝ))))
  have hmean : Measurable (fun w => if evalCount E n t w = 0 then (0 : ℝ) else
      (evalCount E n t w : ℝ)⁻¹ * ∑ i ∈ evalSet E n t w,
        score E kind n w (obs E n w i)) :=
    Measurable.ite hzero measurable_const (hc.inv.mul hsum)
  cases kind <;> exact hmean

-- @node: measurable_truncatedSecondMoment
/-- If [the noise is regularly varying](hyp:hRV), [the fitted exponent is training-measurable](hyp:hTraining), and [the truncation level is measurable](hyp:hB), then [the truncated second moment of the score is measurable](goal). -/
@[fun_prop] lemma measurable_truncatedSecondMoment (E : NeteExperiment M)
    (kind : EstimatorKind) (hRV : NoiseRegularlyVarying M) {n : ℕ}
    (hTraining : ExponentTraining E n) (t : ℝ) (B : E.Om → ℝ) (hB : Measurable B) :
    Measurable (truncatedSecondMoment E kind n t B) := by
  first | fun_prop | skip
  let := obsTailLaw_probability M hRV t
  have hs := measurable_score_joint E kind hTraining
  have habs : Measurable (fun z : E.Om × Obs q d => |score E kind n z.1 z.2|) := by
    fun_prop
  have hf : Measurable (fun z : E.Om × Obs q d =>
      if |score E kind n z.1 z.2| ≤ B z.1 then (score E kind n z.1 z.2)^2 else 0) := by
    first | fun_prop | skip
    exact (hs.pow_const 2).ite (measurableSet_le habs (hB.comp measurable_fst)) measurable_const
  exact hf.stronglyMeasurable.integral_prod_right'.measurable

-- @node: measurable_scoreTailMoment
/-- If [the noise is regularly varying](hyp:hRV), [the fitted exponent is training-measurable](hyp:hTraining), and [the cutoff is measurable](hyp:hB), then [the score's tail moment beyond that cutoff is measurable](goal). -/
@[fun_prop] lemma measurable_scoreTailMoment (E : NeteExperiment M)
    (kind : EstimatorKind) (hRV : NoiseRegularlyVarying M) {n : ℕ}
    (hTraining : ExponentTraining E n) (t : ℝ) (B : E.Om → ℝ) (hB : Measurable B) :
    Measurable (scoreTailMoment E kind n t B) := by
  first | fun_prop | skip
  let := obsTailLaw_probability M hRV t
  have hs := measurable_score_joint E kind hTraining
  have habs : Measurable (fun z : E.Om × Obs q d => |score E kind n z.1 z.2|) := by
    fun_prop
  have hf : Measurable (fun z : E.Om × Obs q d =>
      if B z.1 < |score E kind n z.1 z.2| then |score E kind n z.1 z.2| else 0) := by
    first | fun_prop | skip
    exact habs.ite (measurableSet_lt (hB.comp measurable_fst) habs) measurable_const
  exact hf.stronglyMeasurable.integral_prod_right'.measurable

-- @node: measurable_scoreVariance
/-- If [the noise is regularly varying](hyp:hRV) and [the fitted exponent is training-measurable](hyp:hTraining), then [the tail-law variance of the score is measurable](goal). -/
@[fun_prop] lemma measurable_scoreVariance (E : NeteExperiment M)
    (kind : EstimatorKind) (hRV : NoiseRegularlyVarying M) {n : ℕ}
    (hTraining : ExponentTraining E n) (t : ℝ) :
    Measurable (scoreVariance E kind n t) := by
  first | fun_prop | skip
  let := obsTailLaw_probability M hRV t
  change Measurable (fun w => evariance (score E kind n w) (obsTailLaw M t))
  simp_rw [evariance_eq_lintegral_ofReal]
  have hs := measurable_score_joint E kind hTraining
  have hm : Measurable (fun z : E.Om × Obs q d =>
      ∫ x, score E kind n z.1 x ∂obsTailLaw M t) :=
    (measurable_score_mean E kind hRV hTraining t).comp measurable_fst
  exact ((hs.sub hm).pow_const 2).ennreal_ofReal.lintegral_prod_right'

-- @node: measurableSet_score_truncation_event
/-- If [the noise is regularly varying](hyp:hRV), [the fitted exponent is training-measurable](hyp:hTraining), and [the truncation level is measurable](hyp:hB), then [the event that the estimation error is within the truncation-based sampling radius is measurable](goal). -/
lemma measurableSet_score_truncation_event (E : NeteExperiment M)
    (kind : EstimatorKind) (hRV : NoiseRegularlyVarying M) {n : ℕ}
    (hTraining : ExponentTraining E n) (t delta : ℝ) (B : E.Om → ℝ)
    (hB : Measurable B) :
    MeasurableSet {w | |etaEstimate E kind n t w -
      ∫ z, score E kind n w z ∂obsTailLaw M t| ≤
        scoreSamplingRadius (obsTailLaw M t) (score E kind n w)
          (evalCount E n t w) (B w) delta} := by
  first | fun_prop | skip
  have hmean := measurable_score_mean E kind hRV hTraining t
  have hestimate := measurable_etaEstimate E kind hTraining t
  have hv := measurable_truncatedSecondMoment E kind hRV hTraining t B hB
  have ha := measurable_scoreTailMoment E kind hRV hTraining t B hB
  have hc := measurable_evalCount_real E n t
  have herror : Measurable (fun w => |etaEstimate E kind n t w -
      ∫ z, score E kind n w z ∂obsTailLaw M t|) := by fun_prop
  exact measurableSet_le herror
    (((measurable_const.mul hv).div (measurable_const.mul hc)).sqrt.add
      (measurable_const.mul ha))

-- @node: measurableSet_score_variance_event
/-- If [the noise is regularly varying](hyp:hRV) and [the fitted exponent is training-measurable](hyp:hTraining), then [the event that the estimation error is within the variance-based sampling radius is measurable](goal). -/
lemma measurableSet_score_variance_event (E : NeteExperiment M)
    (kind : EstimatorKind) (hRV : NoiseRegularlyVarying M) {n : ℕ}
    (hTraining : ExponentTraining E n) (t delta : ℝ) :
    MeasurableSet {w | |etaEstimate E kind n t w -
      ∫ z, score E kind n w z ∂obsTailLaw M t| ≤
        Real.sqrt (4 * (scoreVariance E kind n t w).toReal /
          (delta * evalCount E n t w))} := by
  first | fun_prop | skip
  have hmean := measurable_score_mean E kind hRV hTraining t
  have hestimate := measurable_etaEstimate E kind hTraining t
  have hv := (measurable_scoreVariance E kind hRV hTraining t).ennreal_toReal
  have hc := measurable_evalCount_real E n t
  have herror : Measurable (fun w => |etaEstimate E kind n t w -
      ∫ z, score E kind n w z ∂obsTailLaw M t|) := by fun_prop
  exact measurableSet_le herror
    (((measurable_const.mul hv).div (measurable_const.mul hc)).sqrt)

end Papers.TbsExtremeEffects
