@article{albrecherHigherorderExpansionsCompound2010,
  title = {Higher-Order Expansions for Compound Distributions and Ruin Probabilities with Subexponential Claims},
  author = {Albrecher, Hansj{\"o}rg and , Christian, Hipp and {and Kortschak}, Dominik},
  year = {2010},
  month = jun,
  journal = {Scandinavian Actuarial Journal},
  volume = {2010},
  number = {2},
  pages = {105--135},
  publisher = {Taylor \& Francis},
  issn = {0346-1238},
  doi = {10.1080/03461230902722726},
  urldate = {2025-04-03},
  abstract = {Let X i (i=1,2, {\dots}) be a sequence of subexponential positive independent and identically distributed random variables. In this paper, we offer two alternative approaches to obtain higher-order expansions of the tail of and subsequently for ruin probabilities in renewal risk models with claim sizes X i . In particular, these emphasize the importance of the term for the accuracy of the resulting asymptotic expansion of . Furthermore, we present a more rigorous approach to the often suggested technique of using approximations with shifted arguments. The cases of a Pareto type, Weibull and Lognormal distribution for X i are discussed in more detail and numerical investigations of the increase in accuracy by including higher-order terms in the approximation of ruin probabilities for finite realistic ranges of s are given.},
  keywords = {Asymptotic expansions,compound sums,ruin theory,subexponential distributions}
}

@misc{carpentierAdaptiveMinimaxOptimal2014,
  title = {Adaptive and Minimax Optimal Estimation of the Tail Coefficient},
  author = {Carpentier, Alexandra and Kim, Arlene K. H.},
  year = {2014},
  month = jul,
  number = {arXiv:1309.2585},
  eprint = {1309.2585},
  primaryclass = {math},
  publisher = {arXiv},
  doi = {10.48550/arXiv.1309.2585},
  urldate = {2025-03-30},
  abstract = {We consider the problem of estimating the tail index \${\textbackslash}alpha\$ of a distribution satisfying a \$({\textbackslash}alpha, {\textbackslash}beta)\$ second-order Pareto-type condition, where {\textbackslash}beta is the second-order coefficient. When \${\textbackslash}beta\$ is available, it was previously proved that \${\textbackslash}alpha\$ can be estimated with the oracle rate \$n{\textasciicircum}\{-{\textbackslash}beta/(2{\textbackslash}beta+1)\}\$. On the contrary, when \${\textbackslash}beta\$ is not available, estimating \${\textbackslash}alpha\$ with the oracle rate is challenging; so additional assumptions that imply the estimability of \${\textbackslash}beta\$ are usually made. In this paper, we propose an adaptive estimator of \${\textbackslash}alpha\$, and show that this estimator attains the rate \$(n/{\textbackslash}log{\textbackslash}log n){\textasciicircum}\{-{\textbackslash}beta/(2{\textbackslash}beta+1)\}\$ without a priori knowledge of \${\textbackslash}beta\$ and any additional assumptions. Moreover, we prove that this \$({\textbackslash}log{\textbackslash}log n){\textasciicircum}\{{\textbackslash}beta/(2{\textbackslash}beta+1)\}\$ factor is unavoidable by obtaining the companion lower bound.},
  archiveprefix = {arXiv},
  keywords = {Mathematics - Statistics Theory,Statistics - Statistics Theory}
}

