module
public import Papers.TsAdaptiveEstimationInference.Helpers.RDIVPreliminaryEvent
public import Causalean.Mathlib.Probability.IdentDistrib.CenteredSum
/-! Thawing the frozen preliminary experiment and allocating the fitting grid budget. -/
public section
set_option maxHeartbeats 600000

namespace Papers.TsAdaptiveEstimationInference
open MeasureTheory ProbabilityTheory

variable {𝒲 𝒳 𝒵 Ω : Type*} [MeasurableSpace 𝒲] [MeasurableSpace 𝒳]
  [MeasurableSpace 𝒵] [mΩ : MeasurableSpace Ω]
  (V : IVWorld 𝒲 𝒳 𝒵) (P : Measure Ω) [IsProbabilityMeasure P]
  (sample : AnalysisSample V P) (split : SampleSplit)

/-- [The information generated by the fitting observations is contained in the
ambient sample information](goal). -/
-- @node: rdiv_fittingSigma_le
lemma rdiv_fittingSigma_le (n : ℕ) :
    (⨆ i ∈ split.fit n, MeasurableSpace.comap (sample.Z i) inferInstance) ≤
      mΩ := by
  apply iSup_le
  intro i
  apply iSup_le
  intro _
  exact (sample.meas i).comap_le

/-- [The information generated by the preliminary observations is independent
of the information generated by the fitting observations](goal). -/
-- @node: rdiv_preliminary_indep_fitting
lemma rdiv_preliminary_indep_fitting (n : ℕ) :
    Indep (preliminarySigma V P sample split n)
      (⨆ i ∈ split.fit n, MeasurableSpace.comap (sample.Z i) inferInstance) P := by
  have hd : Disjoint (split.pre n) (split.fit n) :=
    (List.pairwise_cons.mp (split.disjoint n)).1 _ (by simp)
  exact indep_iSup_of_disjoint (fun i => (sample.meas i).comap_le)
    sample.indep.iIndep (by exact_mod_cast hd)

/-- If [a success relation is jointly measurable for preliminary and fitting
information](hyp:hR), [ζ lies strictly between zero and one](hyp:hζ), and [almost
every fixed preliminary sample gives fitting success probability at least
1 − ζ](hyp:hsections), then [success with both arguments evaluated on the observed
sample is a measurable event with probability at least 1 − ζ](goal). -/
-- @node: rdiv_fitting_event_of_frozen_sections
lemma rdiv_fitting_event_of_frozen_sections (n : ℕ) (R : Ω → Ω → Prop)
    (hR : MeasurableSet[(preliminarySigma V P sample split n).prod
      (⨆ i ∈ split.fit n, MeasurableSpace.comap (sample.Z i) inferInstance)]
      {p : Ω × Ω | R p.1 p.2})
    (ζ : ℝ) (hζ : ζ ∈ Set.Ioo (0 : ℝ) 1)
    (hsections : ∀ᵐ preliminary ∂P, 1 - ζ ≤ P.real {ω | R preliminary ω}) :
    MeasurableSet {ω | R ω ω} ∧ 1 - ζ ≤ P.real {ω | R ω ω} := by
  let mp := preliminarySigma V P sample split n
  letI : MeasurableSpace Ω := mΩ
  let mf := ⨆ i ∈ split.fit n, MeasurableSpace.comap (sample.Z i) inferInstance
  letI : MeasurableSpace Ω := mΩ
  have hp : mp ≤ mΩ := rdiv_preliminarySigma_le V P sample split n
  have hf : mf ≤ mΩ := rdiv_fittingSigma_le V P sample split n
  have hdiag : @Measurable Ω (Ω × Ω) mΩ (mp.prod mf)
      (fun ω => (ω, ω)) := (measurable_id'' hp).prodMk (measurable_id'' hf)
  refine ⟨hdiag hR, ?_⟩
  have hmap : @Measure.map Ω Ω mΩ mf id P = P.trim hf := by
    apply @Measure.ext Ω mf
    intro s hs
    rw [@Measure.map_apply Ω Ω mΩ mf P id (measurable_id'' hf) s hs]
    exact (trim_measurableSet_eq hf hs).symm
  have hjoint := Causalean.Mathlib.indep_trim_prod_map_eq
    (mΩ := mΩ) (mβ := mf) (μ := P) mp hp (Z := id) (by
      letI : MeasurableSpace Ω := mf
      exact (measurable_id'' hf).aemeasurable)
    (by simpa only [MeasurableSpace.comap_id] using
      rdiv_preliminary_indep_fitting V P sample split n)
  rw [hmap] at hjoint
  have hsec (ω : Ω) : @MeasurableSet Ω mf {ω' | R ω ω'} := hR.preimage
    (measurable_const.prodMk measurable_id)
  have hbound : ∀ᵐ ω ∂P,
      ENNReal.ofReal (1 - ζ) ≤ (P.trim hf) {ω' | R ω ω'} := by
    filter_upwards [hsections] with ω hω
    rw [trim_measurableSet_eq hf (hsec ω)]
    exact (ENNReal.ofReal_le_ofReal hω).trans_eq
      (ENNReal.ofReal_toReal (measure_ne_top P _))
  have hbmeas : @MeasurableSet Ω mp
      {ω | ENNReal.ofReal (1 - ζ) ≤ (P.trim hf) {ω' | R ω ω'}} :=
    by
      letI : MeasurableSpace Ω := mp
      exact measurableSet_le measurable_const
        (@measurable_measure_prodMk_left Ω Ω mp mf (P.trim hf) inferInstance _ hR)
  have hbtrim : ∀ᵐ ω ∂P.trim hp,
      ENNReal.ofReal (1 - ζ) ≤ (P.trim hf) {ω' | R ω ω'} := by
    rw [ae_iff] at hbound ⊢
    exact (@trim_measurableSet_eq Ω mp mΩ P _ hp hbmeas.compl).trans hbound
  have hprob : ENNReal.ofReal (1 - ζ) ≤ P {ω | R ω ω} := by
    calc
      _ = ∫⁻ _ω, ENNReal.ofReal (1 - ζ) ∂P.trim hp := by
        rw [lintegral_const, trim_measurableSet_eq hp (@MeasurableSet.univ Ω mp)]
        simp
      _ ≤ ∫⁻ ω, (P.trim hf) {ω' | R ω ω'} ∂P.trim hp :=
        lintegral_mono_ae hbtrim
      _ = @Measure.prod Ω Ω mp mf (P.trim hp) (P.trim hf) {p | R p.1 p.2} :=
        (by
          letI : MeasurableSpace Ω := mp
          exact (@Measure.prod_apply Ω Ω mp mf (P.trim hp) (P.trim hf) inferInstance _ hR).symm)
      _ = P {ω | R ω ω} := by
        rw [← hjoint]
        exact @Measure.map_apply Ω (Ω × Ω) mΩ (mp.prod mf) P
          (fun ω => (ω, ω)) hdiag _ hR
  have ht := ENNReal.toReal_mono (measure_ne_top P _) hprob
  rwa [ENNReal.toReal_ofReal (by linarith [hζ.2])] at ht

omit V sample split in
/-- If [ξ is nonnegative](hyp:hξ), [each grid-point event is measurable](hyp:hE),
and [each has probability at least one minus a quarter of the grid confidence
budget](hyp:hprob), then [their intersection over the regularization grid is
measurable and has probability at least 1 − ξ/4](goal). -/
-- @node: rdiv_fitting_grid_event_budget
lemma rdiv_fitting_grid_event_budget (ρ ξ : ℝ) (hξ : 0 ≤ ξ) (n : ℕ)
    (E : ℝ → Set Ω)
    (hE : ∀ lam ∈ regGrid ρ n, MeasurableSet (E lam))
    (hprob : ∀ lam ∈ regGrid ρ n,
      1 - gridConfidence ρ ξ n / 4 ≤ P.real (E lam)) :
    MeasurableSet (⋂ lam ∈ regGrid ρ n, E lam) ∧
      1 - ξ / 4 ≤ P.real (⋂ lam ∈ regGrid ρ n, E lam) := by
  classical
  have hm : MeasurableSet (⋂ lam ∈ regGrid ρ n, E lam) :=
    MeasurableSet.biInter (regGrid ρ n).countable_toSet hE
  refine ⟨hm, ?_⟩
  have hcard : (regGrid ρ n).card ≤ terminalIndex ρ n + 1 := by
    exact (Finset.card_image_le).trans_eq (Finset.card_range _)
  have hη : 0 ≤ gridConfidence ρ ξ n / 4 := by
    unfold gridConfidence
    positivity
  have hbad : P.real (⋂ lam ∈ regGrid ρ n, E lam)ᶜ ≤ ξ / 4 := by
    rw [Set.compl_iInter₂]
    calc
      _ ≤ ∑ lam ∈ regGrid ρ n, P.real (E lam)ᶜ :=
        measureReal_biUnion_finset_le _ _
      _ ≤ ∑ _lam ∈ regGrid ρ n, gridConfidence ρ ξ n / 4 := by
        apply Finset.sum_le_sum
        intro lam hlam
        linarith only [probReal_add_probReal_compl (μ := P) (hE lam hlam), hprob lam hlam]
      _ = (regGrid ρ n).card * (gridConfidence ρ ξ n / 4) := by simp
      _ ≤ (terminalIndex ρ n + 1 : ℕ) * (gridConfidence ρ ξ n / 4) :=
        mul_le_mul_of_nonneg_right (by exact_mod_cast hcard) hη
      _ = ξ / 4 := by
        unfold gridConfidence
        have hne : (terminalIndex ρ n + 1 : ℝ) ≠ 0 := by positivity
        push_cast
        field_simp
  linarith only [probReal_add_probReal_compl (μ := P) hm, hbad]

/-- If [ξ lies strictly between zero and one](hyp:hξ), [every grid-point success
relation is jointly measurable for preliminary and fitting information](hyp:hR),
and [at each grid point almost every fixed preliminary sample gives success
probability at least one minus a quarter of the grid confidence budget](hyp:hsections),
then [there is a measurable event of probability at least 1 − ξ/4 on which all
grid-point relations hold with both arguments evaluated on the observed sample](goal). -/
-- @node: rdiv_fitting_grid_event_of_frozen_sections
lemma rdiv_fitting_grid_event_of_frozen_sections (n : ℕ) (ρ ξ : ℝ)
    (hξ : ξ ∈ Set.Ioo (0 : ℝ) 1) (R : ℝ → Ω → Ω → Prop)
    (hR : ∀ lam ∈ regGrid ρ n,
      MeasurableSet[(preliminarySigma V P sample split n).prod
        (⨆ i ∈ split.fit n, MeasurableSpace.comap (sample.Z i) inferInstance)]
        {p : Ω × Ω | R lam p.1 p.2})
    (hsections : ∀ lam ∈ regGrid ρ n, ∀ᵐ preliminary ∂P,
      1 - gridConfidence ρ ξ n / 4 ≤ P.real {ω | R lam preliminary ω}) :
    ∃ E : Set Ω, MeasurableSet E ∧ 1 - ξ / 4 ≤ P.real E ∧
      ∀ ω ∈ E, ∀ lam ∈ regGrid ρ n, R lam ω ω := by
  have hη : gridConfidence ρ ξ n / 4 ∈ Set.Ioo (0 : ℝ) 1 := by
    have hk : (1 : ℝ) ≤ (terminalIndex ρ n + 1 : ℕ) := by exact_mod_cast Nat.succ_le_succ (Nat.zero_le _)
    have hηle : gridConfidence ρ ξ n ≤ ξ := by
      unfold gridConfidence
      exact (div_le_iff₀ (by positivity)).2 (by nlinarith only [hk, hξ.1])
    constructor
    · have hx := hξ.1
      unfold gridConfidence
      positivity
    · linarith only [hηle, hξ.2]
  have hlocal (lam : ℝ) (hlam : lam ∈ regGrid ρ n) :=
    rdiv_fitting_event_of_frozen_sections V P sample split n (R lam)
      (hR lam hlam) _ hη (hsections lam hlam)
  obtain ⟨hm, hp⟩ := rdiv_fitting_grid_event_budget P ρ ξ hξ.1.le n
    (fun lam => {ω | R lam ω ω}) (fun lam hlam => (hlocal lam hlam).1)
    (fun lam hlam => (hlocal lam hlam).2)
  refine ⟨⋂ lam ∈ regGrid ρ n, {ω | R lam ω ω}, hm, hp, ?_⟩
  intro ω hω lam hlam
  exact Set.mem_iInter₂.mp hω lam hlam

/-- If [all localization radii are nonnegative](hyp:hradius), [a is nonnegative](hyp:ha),
and [b is nonnegative](hyp:hb), then [every indexed value is at most a times its
radius plus b if and only if, for every positive rational q, the supremum of
the nonnegative parts of the values with radius at most q is at most aq + b](goal). -/
-- @node: rdiv_uniform_bound_iff_rational_localizations
lemma rdiv_uniform_bound_iff_rational_localizations {I : Type*}
    (radius value : I → ℝ) (a b : ℝ)
    (hradius : ∀ i, 0 ≤ radius i) (ha : 0 ≤ a) (hb : 0 ≤ b) :
    (∀ i, value i ≤ a * radius i + b) ↔
      ∀ q : ℚ, 0 < (q : ℝ) →
        (⨆ i : {i // radius i ≤ (q : ℝ)}, ENNReal.ofReal (value i.1)) ≤
          ENNReal.ofReal (a * (q : ℝ) + b) := by
  constructor
  · intro h q hq
    apply iSup_le
    intro i
    exact ENNReal.ofReal_le_ofReal ((h i.1).trans
      (add_le_add (mul_le_mul_of_nonneg_left i.2 ha) le_rfl))
  · intro h i
    apply le_of_forall_pos_le_add
    intro ε hε
    obtain ⟨q, hlow, hhigh⟩ := exists_rat_btwn
      (show radius i < radius i + ε / (a + 1) from
        lt_add_of_pos_right _ (div_pos hε (by positivity)))
    have hq : 0 < (q : ℝ) := (hradius i).trans_lt hlow
    have hval : ENNReal.ofReal (value i) ≤ ENNReal.ofReal (a * (q : ℝ) + b) :=
      (le_iSup_of_le ⟨i, hlow.le⟩ le_rfl).trans (h q hq)
    have hreal : value i ≤ a * (q : ℝ) + b :=
      (ENNReal.ofReal_le_ofReal_iff (by positivity : 0 ≤ a * (q : ℝ) + b)).mp hval
    have hgap : (q : ℝ) - radius i < ε / (a + 1) := by linarith
    have hgap' := (lt_div_iff₀ (by positivity : 0 < a + 1)).mp hgap
    nlinarith only [hreal, hgap', hlow]

/-- If [all localization radii are nonnegative](hyp:hradius), [a is nonnegative](hyp:ha),
[b is nonnegative](hyp:hb), and [for every positive rational q the supremum of the
nonnegative parts of the values with radius at most q is a measurable function
of the sample](hyp:hlocal), then [the event that every indexed value is at most
a times its radius plus b is measurable](goal). -/
-- @node: rdiv_uniform_bound_measurable_of_localizations
lemma rdiv_uniform_bound_measurable_of_localizations {I A : Type*}
    [MeasurableSpace A] (radius : I → ℝ) (value : A → I → ℝ) (a b : ℝ)
    (hradius : ∀ i, 0 ≤ radius i) (ha : 0 ≤ a) (hb : 0 ≤ b)
    (hlocal : ∀ q : ℚ, 0 < (q : ℝ) → Measurable
      (fun ω => ⨆ i : {i // radius i ≤ (q : ℝ)}, ENNReal.ofReal (value ω i.1))) :
    MeasurableSet {ω | ∀ i, value ω i ≤ a * radius i + b} := by
  have heq : {ω | ∀ i, value ω i ≤ a * radius i + b} =
      ⋂ q : ℚ, ⋂ (_hq : 0 < (q : ℝ)),
        {ω | (⨆ i : {i // radius i ≤ (q : ℝ)}, ENNReal.ofReal (value ω i.1)) ≤
          ENNReal.ofReal (a * (q : ℝ) + b)} := by
    ext ω
    simp only [Set.mem_setOf_eq, Set.mem_iInter]
    exact rdiv_uniform_bound_iff_rational_localizations radius (value ω) a b hradius ha hb
  rw [heq]
  exact MeasurableSet.iInter fun q => MeasurableSet.iInter fun hq =>
    measurableSet_le (hlocal q hq) measurable_const

/-- [The empirical supremum over functions represented by indices with radius
at most r equals the supremum over those indices of the absolute difference
between each function's sample average and its population integral](goal). -/
-- @node: rdiv_empiricalSupremum_localized_reindex
lemma rdiv_empiricalSupremum_localized_reindex {A I : Type*}
    [MeasurableSpace A] (law : Measure A) (F : I → A → ℝ)
    (radius : I → ℝ) (r : ℝ) (n : ℕ) (x : Fin n → A) :
    empiricalSupremum law {f | ∃ i, radius i ≤ r ∧ f = F i} n x =
      ⨆ i : {i // radius i ≤ r},
        ENNReal.ofReal |(n : ℝ)⁻¹ * ∑ j, F i.1 (x j) - ∫ y, F i.1 y ∂law| := by
  apply le_antisymm
  · apply iSup_le
    intro f
    obtain ⟨i, hi, heq⟩ := f.2
    exact le_iSup_of_le ⟨i, hi⟩ (by simp only [heq]; exact le_rfl)
  · apply iSup_le
    intro i
    exact le_iSup_of_le ⟨F i.1, ⟨i.1, i.2, rfl⟩⟩ le_rfl

/-- Suppose [ξ lies strictly between zero and one](hyp:hξ), [all localization
radii are nonnegative](hyp:hradius), [a is nonnegative](hyp:ha), and [b is
nonnegative](hyp:hb). If [at each grid point and positive rational radius the
supremum of the nonnegative parts of localized values is jointly measurable for
preliminary and fitting information](hyp:hlocal), and [at each grid point almost
every fixed preliminary sample satisfies all bounds of a times radius plus b
with failure probability at most a quarter of the grid confidence budget](hyp:hsections),
then [there is a measurable event of probability at least 1 − ξ/4 on which these
bounds hold for every grid point and every index on the observed sample](goal). -/
-- @node: rdiv_fitting_grid_event_of_localized_suprema
lemma rdiv_fitting_grid_event_of_localized_suprema {I : Type*}
    (n : ℕ) (ρ ξ a b : ℝ) (hξ : ξ ∈ Set.Ioo (0 : ℝ) 1)
    (radius : I → ℝ) (value : ℝ → Ω → Ω → I → ℝ)
    (hradius : ∀ i, 0 ≤ radius i) (ha : 0 ≤ a) (hb : 0 ≤ b)
    (hlocal : ∀ lam ∈ regGrid ρ n, ∀ q : ℚ, 0 < (q : ℝ) →
      @Measurable (Ω × Ω) ENNReal
        ((preliminarySigma V P sample split n).prod
          (⨆ i ∈ split.fit n, MeasurableSpace.comap (sample.Z i) inferInstance))
        inferInstance (fun p =>
          ⨆ i : {i // radius i ≤ (q : ℝ)}, ENNReal.ofReal (value lam p.1 p.2 i.1)))
    (hsections : ∀ lam ∈ regGrid ρ n, ∀ᵐ preliminary ∂P,
      1 - gridConfidence ρ ξ n / 4 ≤
        P.real {ω | ∀ i, value lam preliminary ω i ≤ a * radius i + b}) :
    ∃ E : Set Ω, MeasurableSet E ∧ 1 - ξ / 4 ≤ P.real E ∧
      ∀ ω ∈ E, ∀ lam ∈ regGrid ρ n, ∀ i,
        value lam ω ω i ≤ a * radius i + b := by
  apply rdiv_fitting_grid_event_of_frozen_sections V P sample split n ρ ξ hξ
    (fun lam preliminary ω => ∀ i, value lam preliminary ω i ≤ a * radius i + b)
    _ hsections
  intro lam hlam
  exact @rdiv_uniform_bound_measurable_of_localizations I (Ω × Ω)
    ((preliminarySigma V P sample split n).prod
      (⨆ i ∈ split.fit n, MeasurableSpace.comap (sample.Z i) inferInstance))
    radius (fun p i => value lam p.1 p.2 i) a b hradius ha hb (hlocal lam hlam)

end Papers.TsAdaptiveEstimationInference
