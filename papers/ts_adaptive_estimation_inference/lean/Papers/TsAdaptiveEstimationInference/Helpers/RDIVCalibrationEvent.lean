module
public import Papers.TsAdaptiveEstimationInference.Helpers.RDIVPreliminaryEvent
public import Causalean.Mathlib.Probability.IdentDistrib.CenteredSum
/-! Transfer preliminary-data almost-everywhere bounds to calibration observations.

The transfer uses independence of the entire preliminary sigma algebra, rather
than independence of a particular estimator. No assumptions on the observation
spaces beyond their measurable structures are required.
-/
public section

namespace Papers.TsAdaptiveEstimationInference
open MeasureTheory ProbabilityTheory

variable {𝒲 𝒳 𝒵 Ω : Type*} [MeasurableSpace 𝒲] [MeasurableSpace 𝒳]
  [MeasurableSpace 𝒵] [MeasurableSpace Ω]
  {pilotInputSupport : Set 𝒵}
  (V : IVWorld 𝒲 𝒳 𝒵) (P : Measure Ω) [IsProbabilityMeasure P]
  (sample : AnalysisSample V P) (split : SampleSplit)

omit [IsProbabilityMeasure P] in
/-- If [index i belongs to the calibration block](hyp:hi), [the observation at
i is independent of the information generated by the preliminary observations](goal). -/
-- @node: rdiv_preliminary_indep_calibration
lemma rdiv_preliminary_indep_calibration (n i : ℕ) (hi : i ∈ split.cal n) :
    Indep (preliminarySigma V P sample split n)
      (MeasurableSpace.comap (sample.Z i) inferInstance) P := by
  have hpc : Disjoint (split.pre n) (split.cal n) :=
    (List.pairwise_cons.mp (split.disjoint n)).1 _ (by simp)
  have hd : Disjoint (↑(split.pre n) : Set ℕ) {i} := by
    rw [Set.disjoint_singleton_right]
    exact fun hpre => Finset.disjoint_left.mp hpc hpre hi
  have hind := indep_iSup_of_disjoint
    (fun j => (sample.meas j).comap_le) sample.indep.iIndep hd
  simpa [preliminarySigma] using hind

/-- If [R is jointly measurable with respect to the preliminary information
and a fresh observation](hyp:hR) and [R holds for almost every fresh observation
for almost every preliminary outcome](hyp:hsections), [almost surely R holds
at every actual calibration observation](goal). -/
-- @node: rdiv_calibration_ae_of_preliminary_sections
lemma rdiv_calibration_ae_of_preliminary_sections (n : ℕ)
    (R : Ω → 𝒲 → Prop)
    (hR : MeasurableSet[(preliminarySigma V P sample split n).prod
      ‹MeasurableSpace 𝒲›] {p : Ω × 𝒲 | R p.1 p.2})
    (hsections : ∀ᵐ ω ∂P, ∀ᵐ w ∂V.law, R ω w) :
    ∀ᵐ ω ∂P, ∀ i ∈ split.cal n, R ω (sample.Z i ω) := by
  have hle := rdiv_preliminarySigma_le V P sample split n
  have hsectionMeas : MeasurableSet[preliminarySigma V P sample split n]
      {ω | ∀ᵐ w ∂V.law, R ω w} := by
    let : MeasurableSpace Ω := preliminarySigma V P sample split n
    simp only [ae_iff]
    exact measurableSet_eq_fun (measurable_measure_prodMk_left hR.compl) measurable_const
  have htrim : ∀ᵐ ω ∂P.trim hle, ∀ᵐ w ∂V.law, R ω w := by
    rw [ae_iff]
    change (P.trim hle) {ω | ∀ᵐ w ∂V.law, R ω w}ᶜ = 0
    rw [trim_measurableSet_eq hle hsectionMeas.compl]
    exact hsections
  have hprod : ∀ᵐ p ∂(@Measure.prod Ω 𝒲
      (preliminarySigma V P sample split n) _ (P.trim hle) V.law), R p.1 p.2 := by
    let : MeasurableSpace Ω := preliminarySigma V P sample split n
    exact (Measure.ae_prod_iff_ae_ae hR).2 htrim
  have hi (i : ℕ) (hi : i ∈ split.cal n) : ∀ᵐ ω ∂P, R ω (sample.Z i ω) := by
    have hmap := Causalean.Mathlib.indep_trim_prod_map_eq
      (μ := P) (preliminarySigma V P sample split n) hle
      (sample.meas i).aemeasurable
      (rdiv_preliminary_indep_calibration V P sample split n i hi)
    have hlaw : P.map (sample.Z i) = V.law := by
      rw [← (sample.identDist i).map_eq, sample.law]
    rw [hlaw] at hmap
    have hjoined : @Measurable Ω (Ω × 𝒲) ‹MeasurableSpace Ω›
        ((preliminarySigma V P sample split n).prod ‹MeasurableSpace 𝒲›)
        (fun ω => (ω, sample.Z i ω)) :=
      (measurable_id'' hle).prodMk (sample.meas i)
    rw [← hmap] at hprod
    rw [ae_iff] at hprod ⊢
    change P ((fun ω => (ω, sample.Z i ω)) ⁻¹' {p : Ω × 𝒲 | ¬ R p.1 p.2}) = 0
    rw [← @Measure.map_apply Ω (Ω × 𝒲) _
      ((preliminarySigma V P sample split n).prod ‹MeasurableSpace 𝒲›) P
      (fun ω => (ω, sample.Z i ω)) hjoined _ hR.compl]
    exact hprod
  exact (ae_all_iff).2 fun i => (ae_all_iff).2 fun hi' => hi i hi'

omit [IsProbabilityMeasure P] in
/-- If [the selected pilot has a coherent preliminary-measurable version](hyp:hVersion),
[the pilot is bounded by B on the pilot input support](hyp:hBound), and [the
sample size is positive](hyp:hn), [there is a jointly preliminary-and-input
measurable pilot version and a measurable probability-one set on which it
agrees with the selected pilot almost everywhere under the input law, is
bounded by B almost everywhere, and agrees with the selected pilot at every
calibration observation](goal). -/
lemma rdiv_pilot_calibration_version (rHat : ℕ → Ω → 𝒵 → ℝ) (B : ℝ)
    (hVersion : RDIVSelectedPilotVersion V P sample split rHat)
    (hBound : PilotBounded V P rHat pilotInputSupport B) (n : ℕ) (hn : 0 < n) :
    ∃ rBar : Ω × 𝒵 → ℝ,
      @Measurable (Ω × 𝒵) ℝ
        ((preliminarySigma V P sample split n).prod inferInstance) inferInstance rBar ∧
      ∃ N : Set Ω, MeasurableSet N ∧ (∀ᵐ ω ∂P, ω ∈ N) ∧
        ∀ ω ∈ N,
          ((fun z => rBar (ω, z)) =ᵐ[V.law.map V.zOf] rHat n ω) ∧
          (∀ᵐ z ∂V.law.map V.zOf, |rBar (ω, z)| ≤ B) ∧
          (∀ i ∈ split.cal n,
            rBar (ω, V.zOf (sample.Z i ω)) = rHat n ω (V.zOf (sample.Z i ω))) := by
  obtain ⟨rBar, hm, hsections, hactual⟩ := hVersion n hn
  have hae : ∀ᵐ ω ∂P,
      ((fun z => rBar (ω, z)) =ᵐ[V.law.map V.zOf] rHat n ω) ∧
      (∀ᵐ z ∂V.law.map V.zOf, |rBar (ω, z)| ≤ B) ∧
      (∀ i ∈ split.cal n,
        rBar (ω, V.zOf (sample.Z i ω)) = rHat n ω (V.zOf (sample.Z i ω))) := by
    filter_upwards [hsections, hBound.2 n hn, hactual] with ω hω hb ha
    refine ⟨hω, ?_, ha⟩
    filter_upwards [hω, hBound.1] with z hz hzSupport
    simpa only [hz] using hb z hzSupport
  obtain ⟨N, hsub, hN, hnull⟩ := exists_measurable_superset_of_null (ae_iff.mp hae)
  refine ⟨rBar, hm, Nᶜ, hN.compl, ?_, ?_⟩
  · exact ae_iff.mpr (by simpa using hnull)
  · intro ω hω
    by_contra hbad
    exact hω (hsub hbad)

/-- If [the pilot satisfies its regression rate](hyp:_hPilot), [the selected
pilot has a coherent preliminary-measurable version](hyp:hSelectedPilotVersion),
[the pilot is bounded by B on the pilot input support](hyp:hBound), and [the
sample size is positive](hyp:hn), [almost surely the selected pilot is bounded
in absolute value by B at every calibration observation](goal). -/
-- @node: rdiv_pilot_calibration_ae
lemma rdiv_pilot_calibration_ae (rHat : ℕ → Ω → 𝒵 → ℝ)
    (δr : ℕ → ℝ → ℝ) (B : ℝ)
    (_hPilot : PilotRegressionRate V P sample split rHat δr)
    (hSelectedPilotVersion : RDIVSelectedPilotVersion V P sample split rHat)
    (hBound : PilotBounded V P rHat pilotInputSupport B) (n : ℕ) (hn : 0 < n) :
    ∀ᵐ ω ∂P, ∀ i ∈ split.cal n, |rHat n ω (V.zOf (sample.Z i ω))| ≤ B := by
  obtain ⟨rBar, hm, N, hN, hNae, hcoh⟩ :=
    rdiv_pilot_calibration_version V P sample split rHat B hSelectedPilotVersion hBound n hn
  have hrelation : MeasurableSet[(preliminarySigma V P sample split n).prod
      ‹MeasurableSpace 𝒲›] {p : Ω × 𝒲 | |rBar (p.1, V.zOf p.2)| ≤ B} := by
    let : MeasurableSpace Ω := preliminarySigma V P sample split n
    exact measurableSet_le (hm.comp
      (measurable_fst.prodMk (V.measurable_z.comp measurable_snd))).abs measurable_const
  have htransport := rdiv_calibration_ae_of_preliminary_sections V P sample split n
    (fun ω w => |rBar (ω, V.zOf w)| ≤ B) hrelation
    (by
      filter_upwards [hNae] with ω hω
      exact ae_of_ae_map V.measurable_z.aemeasurable (hcoh ω hω).2.1)
  filter_upwards [hNae, htransport] with ω hω ht
  intro i hi
  simpa only [(hcoh ω hω).2.2 i hi] using ht i hi

/-- If [the pilot satisfies its regression rate](hyp:hPilot), [the selected
pilot has a coherent preliminary-measurable version](hyp:hSelectedPilotVersion),
[the pilot is bounded by B on the pilot input support](hyp:hBound), and [the
sample size is positive](hyp:hn), [there is a measurable probability-one event
on which the selected pilot is bounded in absolute value by B at every
calibration observation](goal). -/
-- @node: rdiv_pilot_calibration_event (hSelectedPilotVersion := hSelectedPilotVersion)
lemma rdiv_pilot_calibration_event (rHat : ℕ → Ω → 𝒵 → ℝ)
    (δr : ℕ → ℝ → ℝ) (B : ℝ)
    (hPilot : PilotRegressionRate V P sample split rHat δr)
    (hSelectedPilotVersion : RDIVSelectedPilotVersion V P sample split rHat)
    (hBound : PilotBounded V P rHat pilotInputSupport B) (n : ℕ) (hn : 0 < n) :
    ∃ E : Set Ω, MeasurableSet E ∧ (∀ᵐ ω ∂P, ω ∈ E) ∧
      ∀ ω ∈ E, ∀ i ∈ split.cal n, |rHat n ω (V.zOf (sample.Z i ω))| ≤ B := by
  have hae := rdiv_pilot_calibration_ae (hSelectedPilotVersion := hSelectedPilotVersion)
    V P sample split rHat δr B hPilot
    hBound n hn
  obtain ⟨N, hsub, hN, hnull⟩ := exists_measurable_superset_of_null (ae_iff.mp hae)
  refine ⟨Nᶜ, hN.compl, ?_, ?_⟩
  · exact ae_iff.mpr (by simpa using hnull)
  · intro ω hω
    by_contra hbad
    exact hω (hsub hbad)

end Papers.TsAdaptiveEstimationInference
