module
public import Papers.TsAdaptiveEstimationInference.Helpers.RDIVCalibrationConcentration
public import Toolkit.Foundations.Probability.Independence.ProductConditioning
/-! Transfer frozen calibration bounds across the independent training and calibration blocks.

The training experiment includes both preliminary and fitting observations.
The probability transfer uses trimmed product laws and does not require regular
conditional distributions or additional structure on the observation spaces.
-/
public section
set_option maxHeartbeats 600000

namespace Papers.TsAdaptiveEstimationInference
open MeasureTheory ProbabilityTheory

variable {Ω : Type*} [mΩ : MeasurableSpace Ω]

variable {𝒲 X Z : Type*} [MeasurableSpace 𝒲] [MeasurableSpace X]
  [MeasurableSpace Z]
  (V : IVWorld 𝒲 X Z) (P : Measure Ω) [IsProbabilityMeasure P]
  (sample : AnalysisSample V P) (split : SampleSplit)

/-- [The information generated by the observations in any fixed finite block is
contained in the ambient sample information](goal). -/
-- @node: rdiv_blockSigma_le
lemma rdiv_blockSigma_le (I : Finset ℕ) :
    (⨆ i ∈ I, MeasurableSpace.comap (sample.Z i) inferInstance) ≤ mΩ := by
  apply iSup_le
  intro i
  apply iSup_le
  intro _
  exact (sample.meas i).comap_le

/-- [The combined preliminary and fitting observations are independent of the
calibration observations](goal). -/
-- @node: rdiv_training_indep_calibration
lemma rdiv_training_indep_calibration (n : ℕ) :
    Indep (⨆ i ∈ split.pre n ∪ split.fit n,
      MeasurableSpace.comap (sample.Z i) inferInstance)
      (⨆ i ∈ split.cal n, MeasurableSpace.comap (sample.Z i) inferInstance) P := by
  classical
  have hpre : Disjoint (split.pre n) (split.cal n) :=
    (List.pairwise_cons.mp (split.disjoint n)).1 _ (by simp)
  have hfit : Disjoint (split.fit n) (split.cal n) :=
    (List.pairwise_cons.mp (List.pairwise_cons.mp (split.disjoint n)).2).1 _ (by simp)
  have hd : Disjoint (split.pre n ∪ split.fit n) (split.cal n) :=
    Finset.disjoint_union_left.mpr ⟨hpre, hfit⟩
  exact indep_iSup_of_disjoint (fun i => (sample.meas i).comap_le)
    sample.indep.iIndep (by exact_mod_cast hd)

/-- If [a training–calibration success relation is jointly measurable for the
combined preliminary and fitting information and the calibration information](hyp:hR),
[ζ lies strictly between zero and one](hyp:hζ), and [almost every fixed training
sample has calibration success probability at least 1 − ζ](hyp:hsections), then
[success on the observed sample is measurable and has probability at least
1 − ζ](goal). -/
-- @node: rdiv_calibration_event_of_frozen_sections
lemma rdiv_calibration_event_of_frozen_sections (n : ℕ) (R : Ω → Ω → Prop)
    (hR : MeasurableSet[
      (⨆ i ∈ split.pre n ∪ split.fit n,
        MeasurableSpace.comap (sample.Z i) inferInstance).prod
      (⨆ i ∈ split.cal n, MeasurableSpace.comap (sample.Z i) inferInstance)]
      {p : Ω × Ω | R p.1 p.2})
    (ζ : ℝ) (hζ : ζ ∈ Set.Ioo (0 : ℝ) 1)
    (hsections : ∀ᵐ training ∂P, 1 - ζ ≤ P.real {ω | R training ω}) :
    @MeasurableSet Ω mΩ {ω | R ω ω} ∧ 1 - ζ ≤ P.real {ω | R ω ω} := by
  exact Toolkit.Foundations.Probability.Independence.measurableSet_and_le_measureReal_diag_of_indep_of_ae_section P _ _
    (rdiv_blockSigma_le V P sample (split.pre n ∪ split.fit n))
    (rdiv_blockSigma_le V P sample (split.cal n))
    (rdiv_training_indep_calibration V P sample split n) R hR ζ hζ hsections

/-- If [ξ lies strictly between zero and one](hyp:hξ), [each grid-point success
relation is jointly measurable for training and calibration information](hyp:hR),
and [at every grid point almost every fixed training sample has success probability
at least one minus a quarter of the grid confidence budget](hyp:hsections), then
[there is a measurable event of probability at least 1 − ξ/4 on which every grid-point
relation holds with both arguments evaluated on the observed sample](goal). -/
-- @node: rdiv_calibration_grid_event_of_frozen_sections
lemma rdiv_calibration_grid_event_of_frozen_sections (n : ℕ) (ρ ξ : ℝ)
    (hξ : ξ ∈ Set.Ioo (0 : ℝ) 1) (R : ℝ → Ω → Ω → Prop)
    (hR : ∀ lam ∈ regGrid ρ n, MeasurableSet[
      (⨆ i ∈ split.pre n ∪ split.fit n,
        MeasurableSpace.comap (sample.Z i) inferInstance).prod
      (⨆ i ∈ split.cal n, MeasurableSpace.comap (sample.Z i) inferInstance)]
      {p : Ω × Ω | R lam p.1 p.2})
    (hsections : ∀ lam ∈ regGrid ρ n, ∀ᵐ training ∂P,
      1 - gridConfidence ρ ξ n / 4 ≤ P.real {ω | R lam training ω}) :
    ∃ E : Set Ω, MeasurableSet E ∧ 1 - ξ / 4 ≤ P.real E ∧
      ∀ ω ∈ E, ∀ lam ∈ regGrid ρ n, R lam ω ω := by
  have hη : gridConfidence ρ ξ n / 4 ∈ Set.Ioo (0 : ℝ) 1 := by
    have hk : (1 : ℝ) ≤ (terminalIndex ρ n + 1 : ℕ) := by
      exact_mod_cast Nat.succ_le_succ (Nat.zero_le _)
    have hηle : gridConfidence ρ ξ n ≤ ξ := by
      unfold gridConfidence
      exact (div_le_iff₀ (by positivity)).2 (by nlinarith only [hk, hξ.1])
    constructor
    · have hx := hξ.1
      unfold gridConfidence
      positivity
    · linarith only [hηle, hξ.2]
  have hlocal (lam : ℝ) (hlam : lam ∈ regGrid ρ n) :=
    rdiv_calibration_event_of_frozen_sections V P sample split n (R lam)
      (hR lam hlam) _ hη (hsections lam hlam)
  obtain ⟨hm, hp⟩ := rdiv_fitting_grid_event_budget P ρ ξ hξ.1.le n
    (fun lam => {ω | R lam ω ω}) (fun lam hlam => (hlocal lam hlam).1)
    (fun lam hlam => (hlocal lam hlam).2)
  exact ⟨⋂ lam ∈ regGrid ρ n, {ω | R lam ω ω}, hm, hp,
    fun ω hω lam hlam => Set.mem_iInter₂.mp hω lam hlam⟩

omit [IsProbabilityMeasure P] in
/-- [Averaging a function over the n calibration observations in their finite
enumeration equals its calibration block average](goal). -/
-- @node: rdiv_calibration_tuple_average
lemma rdiv_calibration_tuple_average (n : ℕ) (f : 𝒲 → ℝ) (ω : Ω) :
    (n : ℝ)⁻¹ * ∑ j : Fin n,
      f (sample.Z ((Finset.equivFinOfCardEq (split.card_cal n)).symm j) ω) =
      blockAverage V P sample (split.cal n) f ω := by
  classical
  unfold blockAverage
  rw [split.card_cal]
  congr 1
  rw [← Finset.sum_coe_sort (split.cal n)]
  exact (Equiv.sum_comp (Finset.equivFinOfCardEq (split.card_cal n)).symm
    (fun i : split.cal n => f (sample.Z i ω)))


/-- If [the residual is jointly measurable in the training sample and an
observation](hyp:hq), then [the absolute difference between its calibration average
of squares and its population second moment is jointly measurable in the training
and calibration samples](goal). -/
-- @node: rdiv_calibration_deviation_measurable
@[fun_prop] lemma rdiv_calibration_deviation_measurable
    (q : Ω → 𝒲 → ℝ) (n : ℕ)
    (hq : @Measurable (Ω × 𝒲) ℝ
      ((⨆ i ∈ split.pre n ∪ split.fit n,
        MeasurableSpace.comap (sample.Z i) inferInstance).prod inferInstance) inferInstance
      (fun p => q p.1 p.2)) :
    @Measurable (Ω × Ω) ℝ
      ((⨆ i ∈ split.pre n ∪ split.fit n,
        MeasurableSpace.comap (sample.Z i) inferInstance).prod
        (⨆ i ∈ split.cal n, MeasurableSpace.comap (sample.Z i) inferInstance))
      inferInstance (fun p =>
        |blockAverage V P sample (split.cal n) (fun w => q p.1 w ^ 2) p.2 -
          ∫ w, q p.1 w ^ 2 ∂V.law|) := by
  let mt := ⨆ i ∈ split.pre n ∪ split.fit n,
    MeasurableSpace.comap (sample.Z i) inferInstance
  letI : MeasurableSpace Ω := mΩ
  let mc := ⨆ i ∈ split.cal n, MeasurableSpace.comap (sample.Z i) inferInstance
  letI : MeasurableSpace Ω := mΩ
  have hi : @Measurable Ω ℝ mt inferInstance
      (fun ω => ∫ w, q ω w ^ 2 ∂V.law) := by
    letI : MeasurableSpace Ω := mt
    exact (hq.pow_const 2).stronglyMeasurable.integral_prod_right'.measurable
  have hobs (i : ℕ) (hi : i ∈ split.cal n) :
      @Measurable Ω 𝒲 mc inferInstance (sample.Z i) := by
    apply measurable_iff_comap_le.2
    exact le_iSup_of_le i (le_iSup_of_le hi le_rfl)
  letI : MeasurableSpace (Ω × Ω) := mt.prod mc
  have havg : Measurable (fun p : Ω × Ω =>
      blockAverage V P sample (split.cal n) (fun w => q p.1 w ^ 2) p.2) := by
    unfold blockAverage
    apply Measurable.const_mul
    apply Finset.measurable_sum
    intro i hi
    exact (hq.comp (measurable_fst.prodMk ((hobs i hi).comp measurable_snd))).pow_const 2
  exact (havg.sub (hi.comp measurable_fst)).abs

/-- If [ξ lies strictly between zero and one](hyp:hξ), [at every grid point the
residual is jointly measurable in training data and an observation](hyp:hq), and
[at every grid point, for almost every fixed training sample its calibration
second-moment deviation is at most K times the sum of a times its population
root second moment and a²,
with failure probability at most a quarter of the grid confidence budget](hyp:hsections),
then [a measurable event of probability at least 1 − ξ/4 satisfies that same
deviation bound simultaneously at every grid point for the observed sample](goal). -/
-- @node: rdiv_calibration_bernstein_event_of_frozen_bounds
lemma rdiv_calibration_bernstein_event_of_frozen_bounds
    (n : ℕ) (ρ ξ K a : ℝ) (hξ : ξ ∈ Set.Ioo (0 : ℝ) 1)
    (q : ℝ → Ω → 𝒲 → ℝ)
    (hq : ∀ lam ∈ regGrid ρ n,
      @Measurable (Ω × 𝒲) ℝ
        ((⨆ i ∈ split.pre n ∪ split.fit n,
          MeasurableSpace.comap (sample.Z i) inferInstance).prod inferInstance)
        inferInstance (fun p => q lam p.1 p.2))
    (hsections : ∀ lam ∈ regGrid ρ n, ∀ᵐ training ∂P,
      1 - gridConfidence ρ ξ n / 4 ≤ P.real {ω |
        |blockAverage V P sample (split.cal n) (fun w => q lam training w ^ 2) ω -
          ∫ w, q lam training w ^ 2 ∂V.law| ≤
            K * (a * Real.sqrt (∫ w, q lam training w ^ 2 ∂V.law) + a ^ 2)}) :
    ∃ E : Set Ω, MeasurableSet E ∧ 1 - ξ / 4 ≤ P.real E ∧
      ∀ ω ∈ E, ∀ lam ∈ regGrid ρ n,
        |blockAverage V P sample (split.cal n) (fun w => q lam ω w ^ 2) ω -
          ∫ w, q lam ω w ^ 2 ∂V.law| ≤
            K * (a * Real.sqrt (∫ w, q lam ω w ^ 2 ∂V.law) + a ^ 2) := by
  apply rdiv_calibration_grid_event_of_frozen_sections V P sample split n ρ ξ hξ
    (fun lam training ω =>
      |blockAverage V P sample (split.cal n) (fun w => q lam training w ^ 2) ω -
        ∫ w, q lam training w ^ 2 ∂V.law| ≤
          K * (a * Real.sqrt (∫ w, q lam training w ^ 2 ∂V.law) + a ^ 2))
    _ hsections
  intro lam hlam
  have hdev := rdiv_calibration_deviation_measurable V P sample split (q lam) n
    (hq lam hlam)
  let mt := ⨆ i ∈ split.pre n ∪ split.fit n,
    MeasurableSpace.comap (sample.Z i) inferInstance
  have hi : @Measurable Ω ℝ mt inferInstance
      (fun ω => ∫ w, q lam ω w ^ 2 ∂V.law) := by
    letI : MeasurableSpace Ω := mt
    exact ((hq lam hlam).pow_const 2).stronglyMeasurable.integral_prod_right'.measurable
  apply measurableSet_le hdev
  exact measurable_const.mul
    ((measurable_const.mul (Real.continuous_sqrt.measurable.comp
      (hi.comp measurable_fst))).add measurable_const)

end Papers.TsAdaptiveEstimationInference
