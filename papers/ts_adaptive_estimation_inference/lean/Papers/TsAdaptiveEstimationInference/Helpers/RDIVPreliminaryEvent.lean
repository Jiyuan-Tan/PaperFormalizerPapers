module
public import Papers.TsAdaptiveEstimationInference.Helpers.RDIVSetup
/-! Measurable pilot errors and the preliminary density/pilot union bound. -/
public section

namespace Papers.TsAdaptiveEstimationInference
open MeasureTheory

variable {𝒲 𝒳 𝒵 Ω : Type*} [MeasurableSpace 𝒲] [MeasurableSpace 𝒳]
  [MeasurableSpace 𝒵] [MeasurableSpace Ω]
  (V : IVWorld 𝒲 𝒳 𝒵) (P : Measure Ω)
  (sample : AnalysisSample V P) (split : SampleSplit)

/-- [The sigma-algebra generated by the preliminary sample block is contained
in the ambient experiment's sigma-algebra](goal). -/
-- @node: rdiv_preliminarySigma_le
lemma rdiv_preliminarySigma_le (n : ℕ) :
    preliminarySigma V P sample split n ≤ ‹MeasurableSpace Ω› := by
  apply iSup_le
  intro i
  apply iSup_le
  intro _
  exact (sample.meas i).comap_le

/-- If [the pilot regression estimator has a measurable preliminary L2 selection
and the prescribed confidence bounds](hyp:hPilot) and [the sample size is
positive](hyp:hn), [its L2 error relative to the population moment representer,
under the instrument distribution, is measurable up to a probability-zero
set](goal). -/
-- @node: rdiv_pilot_error_measurable
@[fun_prop] lemma rdiv_pilot_error_measurable
    (rHat : ℕ → Ω → 𝒵 → ℝ) (δr : ℕ → ℝ → ℝ)
    (hPilot : PilotRegressionRate V P sample split rHat δr)
    (n : ℕ) (hn : 0 < n) : AEMeasurable (fun ω =>
      inputL2Norm (V.law.map V.zOf)
        (rHat n ω - dualVersion V (momentRepresenter V))) P := by
  let : MeasurableSpace (Lp ℝ 2 (V.law.map V.zOf)) := borel _
  let : BorelSpace (Lp ℝ 2 (V.law.map V.zOf)) := ⟨rfl⟩
  obtain ⟨selected, hselected, hcoherent⟩ := hPilot.1 n hn
  have hmeas : Measurable selected :=
    hselected.mono (rdiv_preliminarySigma_le V P sample split n) le_rfl
  have hpop : MemLp (fun w => dualVersion V (momentRepresenter V) (V.zOf w)) 2 V.law :=
    (memLp_congr_ae (V.dual_coherent _)).2 (Lp.memLp (momentRepresenter V : Lp ℝ 2 V.law))
  have hq : MemLp (dualVersion V (momentRepresenter V)) 2 (V.law.map V.zOf) :=
    (memLp_map_measure_iff (V.dual_measurable _).aestronglyMeasurable
      V.measurable_z.aemeasurable).2 hpop
  let q := hq.toLp (dualVersion V (momentRepresenter V))
  have heq : (fun ω => inputL2Norm (V.law.map V.zOf)
      (rHat n ω - dualVersion V (momentRepresenter V))) =ᵐ[P]
      (fun ω => ‖selected ω - q‖) := by
    filter_upwards [hcoherent] with ω hω
    have hi : (∫ z, (rHat n ω z - dualVersion V (momentRepresenter V) z) ^ 2
        ∂V.law.map V.zOf) = ‖selected ω - q‖ ^ 2 := by
      calc
        _ = ∫ z, ((selected ω - q) z) ^ 2 ∂V.law.map V.zOf := by
          apply integral_congr_ae
          filter_upwards [hω, hq.coeFn_toLp, Lp.coeFn_sub (selected ω) q] with z hz hqz hsub
          simp only [Pi.sub_apply] at hsub
          rw [hz, hsub, hqz]
        _ = _ := by
          simpa only [L2.inner_def, RCLike.inner_apply, conj_trivial, ← pow_two] using
            real_inner_self_eq_norm_sq (selected ω - q)
    unfold inputL2Norm
    simp only [Pi.sub_apply]
    rw [hi, Real.sqrt_sq (norm_nonneg _)]
  have hcont : Continuous (fun v : Lp ℝ 2 (V.law.map V.zOf) => ‖v - q‖) :=
    (continuous_id.sub continuous_const).norm
  exact (hcont.measurable.comp hmeas).aemeasurable.congr heq.symm

/-- If [the pilot regression estimator satisfies its preliminary selection and
confidence-rate conditions](hyp:hPilot), [ξ lies strictly between zero and
one](hyp:hξ), and [the sample size is positive](hyp:hn), [there is a measurable
event of probability at least 1−ξ/2 on which the pilot's L2 error relative to
the population moment representer is at most its radius calibrated at ξ/2](goal). -/
-- @node: rdiv_pilot_half_confidence_event
lemma rdiv_pilot_half_confidence_event [IsProbabilityMeasure P]
    (rHat : ℕ → Ω → 𝒵 → ℝ) (δr : ℕ → ℝ → ℝ)
    (hPilot : PilotRegressionRate V P sample split rHat δr)
    (ξ : ℝ) (hξ : ξ ∈ Set.Ioo (0 : ℝ) 1) (n : ℕ) (hn : 0 < n) :
    ∃ R : Set Ω, MeasurableSet R ∧
      1 - ξ / 2 ≤ P.real R ∧
      ∀ ω ∈ R, inputL2Norm (V.law.map V.zOf)
        (rHat n ω - dualVersion V (momentRepresenter V)) ≤ δr n (ξ / 2) := by
  have hh : ξ / 2 ∈ Set.Ioo (0 : ℝ) 1 := by
    constructor <;> linarith [hξ.1, hξ.2]
  have hm := nullMeasurableSet_le (g := fun _ => δr n (ξ / 2))
    (rdiv_pilot_error_measurable V P sample split rHat δr hPilot n hn) aemeasurable_const
  obtain ⟨R, hsub, hR, heq⟩ := hm.exists_measurable_subset_ae_eq
  refine ⟨R, hR, ?_, fun ω hω => hsub hω⟩
  have hmass : P.real R = P.real {ω | inputL2Norm (V.law.map V.zOf)
      (rHat n ω - dualVersion V (momentRepresenter V)) ≤ δr n (ξ / 2)} := by
    exact congrArg ENNReal.toReal (measure_congr heq)
  rw [hmass]
  exact (hPilot.2 n hn (ξ / 2) hh).2.2

/-- Suppose [the pilot satisfies its preliminary selection and confidence-rate
conditions](hyp:hPilot), [ξ lies strictly between zero and one](hyp:hξ), [the
sample size is positive](hyp:hn), [the density event D is measurable](hyp:hD),
and [D has probability at least 1−ξ/2](hyp:hpD). Then [there is a measurable
event of probability at least 1−ξ contained in D on which the pilot's L2 error
relative to the population moment representer is at most its radius calibrated
at ξ/2](goal). -/
-- @node: rdiv_preliminary_event_of_density_event
lemma rdiv_preliminary_event_of_density_event [IsProbabilityMeasure P]
    (rHat : ℕ → Ω → 𝒵 → ℝ) (δr : ℕ → ℝ → ℝ)
    (hPilot : PilotRegressionRate V P sample split rHat δr)
    (ξ : ℝ) (hξ : ξ ∈ Set.Ioo (0 : ℝ) 1) (n : ℕ) (hn : 0 < n)
    (D : Set Ω) (hD : MeasurableSet D) (hpD : 1 - ξ / 2 ≤ P.real D) :
    ∃ E : Set Ω, MeasurableSet E ∧ 1 - ξ ≤ P.real E ∧
      ∀ ω ∈ E, ω ∈ D ∧ inputL2Norm (V.law.map V.zOf)
        (rHat n ω - dualVersion V (momentRepresenter V)) ≤ δr n (ξ / 2) := by
  obtain ⟨R, hR, hpR, hRbound⟩ := rdiv_pilot_half_confidence_event V P sample split rHat δr
    hPilot ξ hξ n hn
  refine ⟨D ∩ R, hD.inter hR, ?_, fun ω hω => ⟨hω.1, hRbound ω hω.2⟩⟩
  have hbad : P.real (D ∩ R)ᶜ ≤ ξ := by
    rw [Set.compl_inter]
    have hu := measureReal_union_le (μ := P) Dᶜ Rᶜ
    linarith [probReal_add_probReal_compl (μ := P) hD,
      probReal_add_probReal_compl (μ := P) hR]
  linarith [probReal_add_probReal_compl (μ := P) (hD.inter hR)]

end Papers.TsAdaptiveEstimationInference
