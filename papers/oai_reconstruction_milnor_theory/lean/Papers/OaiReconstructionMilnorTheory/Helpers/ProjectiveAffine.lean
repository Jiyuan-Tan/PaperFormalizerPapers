module

public import Papers.OaiReconstructionMilnorTheory.Helpers.ProjectiveField

/-! # Recovering every affine coordinate

A coordinate fiber is generated by its point on the distinguished axis and all
the other directions at infinity. Transporting this span recovers the coordinate
of every normalized affine point, regardless of its number of nonzero coordinates.
-/

public section

namespace Papers.OaiReconstructionMilnorTheory

variable {H C E E' : Type*} [Field H] [Field C]
  [AddCommGroup E] [Module H E] [AddCommGroup E'] [Module C E']

/-- [A vector belongs to the span of all basis vectors except those indexed by o and i
if and only if its coordinates at o and i are both zero](goal). -/
-- @node: projective_frame_omit_pair_mem
lemma projective_frame_omit_pair_mem {ι : Type*} (b : Module.Basis ι H E)
    (o i : ι) (v : E) :
    v ∈ Submodule.span H (Set.range fun k : {k : ι // o ≠ k ∧ i ≠ k} => b k) ↔
      b.repr v o = 0 ∧ b.repr v i = 0 := by
  classical
  have hs : (Set.range fun k : {k : ι // o ≠ k ∧ i ≠ k} => b k) =
      b '' {k | o ≠ k ∧ i ≠ k} := by
    ext x
    constructor
    · rintro ⟨k, rfl⟩
      exact ⟨k, k.property, rfl⟩
    · rintro ⟨k, hk, rfl⟩
      exact ⟨⟨k, hk⟩, rfl⟩
  rw [hs, b.mem_span_image]
  constructor
  · intro h
    constructor
    · by_contra hn
      exact (h (Finsupp.mem_support_iff.mpr hn)).1 rfl
    · by_contra hn
      exact (h (Finsupp.mem_support_iff.mpr hn)).2 rfl
  · rintro ⟨ho, hi⟩ k hk
    constructor
    · intro heq
      subst k
      exact Finsupp.mem_support_iff.mp hk ho
    · intro heq
      subst k
      exact Finsupp.mem_support_iff.mp hk hi

/-- If [o and i are distinct basis indices](hyp:hoi) and [v has coordinate one at
o](hyp:hvo), then [v belongs to the span of the axis vector with coordinates one at
o and the i-coordinate of v at i, together with all basis vectors outside o and i](goal). -/
-- @node: projective_affine_fiber_mem
lemma projective_affine_fiber_mem {ι : Type*} (b : Module.Basis ι H E)
    {o i : ι} (hoi : o ≠ i) {v : E} (hvo : b.repr v o = 1) :
    v ∈ Submodule.span H {b o + b.repr v i • b i} ⊔
      Submodule.span H (Set.range fun k : {k : ι // o ≠ k ∧ i ≠ k} => b k) := by
  classical
  let u := b o + b.repr v i • b i
  have hrem : v - u ∈
      Submodule.span H (Set.range fun k : {k : ι // o ≠ k ∧ i ≠ k} => b k) := by
    apply (projective_frame_omit_pair_mem b o i _).mpr
    simp [u, Module.Basis.repr_self, hoi, hoi.symm, hvo]
  have h := Submodule.add_mem_sup (Submodule.mem_span_singleton_self u) hrem
  simpa only [add_sub_cancel] using h

/-- If [o and i are distinct basis indices](hyp:hoi), [w has coordinate one at
o](hyp:hwo), and [w lies in the span of the axis vector with coordinates one at o
and a at i, together with all basis vectors outside o and i](hyp:hmem), then
[the i-coordinate of w is a](goal). -/
-- @node: projective_affine_fiber_coordinate
lemma projective_affine_fiber_coordinate {ι : Type*} (b : Module.Basis ι H E)
    {o i : ι} (hoi : o ≠ i) {w : E} (hwo : b.repr w o = 1) (a : H)
    (hmem : w ∈ Submodule.span H {b o + a • b i} ⊔
      Submodule.span H (Set.range fun k : {k : ι // o ≠ k ∧ i ≠ k} => b k)) :
    b.repr w i = a := by
  classical
  obtain ⟨u, hu, z, hz, huz⟩ := Submodule.mem_sup.mp hmem
  obtain ⟨s, rfl⟩ := Submodule.mem_span_singleton.mp hu
  have hzc := (projective_frame_omit_pair_mem b o i z).mp hz
  have ho := congrArg (fun v => b.repr v o) huz
  have hs : s = 1 := by
    simpa [Module.Basis.repr_self, hoi, hzc.1, hwo] using ho
  have hi := congrArg (fun v => b.repr v i) huz
  simpa [Module.Basis.repr_self, hoi.symm, hzc.2, hs] using hi.symm

/-- Suppose [ψ is a bijection preserving projective lines](hyp:hψ), [ψ sends each
source basis point to the corresponding target basis point](hyp:hp), and [on every
axis through o, ψ transforms affine coordinates by the field isomorphism σ](hyp:ht).
If [v is nonzero](hyp:hv) with [source coordinate one at o](hyp:hvo), [w is
nonzero](hyp:hw) with [target coordinate one at o](hyp:hwo), and [ψ sends the point
represented by v to the point represented by w](hyp:hpw), then [every coordinate
of w is σ applied to the corresponding coordinate of v](goal). -/
-- @node: projective_affine_all_coordinates
lemma projective_affine_all_coordinates
    {ψ : Projectivization H E → Projectivization C E'}
    (hψ : ProjectiveLiftBijection ψ) {ι : Type*}
    (b : Module.Basis ι H E) (b' : Module.Basis ι C E')
    (hp : ∀ k, ψ (Projectivization.mk H (b k) (b.ne_zero k)) =
      Projectivization.mk C (b' k) (b'.ne_zero k))
    (o : ι) (σ : H ≃+* C)
    (ht : ∀ k (hok : o ≠ k) a,
      ψ (projectiveAxis (projective_basis_pair b hok) a) =
        projectiveAxis (projective_basis_pair b' hok) (σ a))
    {v : E} (hv : v ≠ 0) (hvo : b.repr v o = 1)
    {w : E'} (hw : w ≠ 0) (hwo : b'.repr w o = 1)
    (hpw : ψ (Projectivization.mk H v hv) = Projectivization.mk C w hw) :
    ∀ i, b'.repr w i = σ (b.repr v i) := by
  classical
  intro i
  by_cases hoi : o = i
  · subst i
    simp [hvo, hwo]
  let W := Submodule.span H
    (Set.range fun k : {k : ι // o ≠ k ∧ i ≠ k} => b k)
  let W' := Submodule.span C
    (Set.range fun k : {k : ι // o ≠ k ∧ i ≠ k} => b' k)
  have him : collineationSubmoduleEquiv hψ W = W' :=
    collineation_frame_span_image hψ b b' hp {k | o ≠ k ∧ i ≠ k}
  have haxis := collineationSubmoduleEquiv_point hψ
    (projectiveAxis (projective_basis_pair b hoi) (b.repr v i))
  rw [ht i hoi] at haxis
  simp only [projectiveAxis, Projectivization.submodule_mk] at haxis
  have htrans : collineationSubmoduleEquiv hψ
      (Submodule.span H {b o + b.repr v i • b i} ⊔ W) =
      Submodule.span C {b' o + σ (b.repr v i) • b' i} ⊔ W' := by
    rw [map_sup, haxis, him]
  apply projective_affine_fiber_coordinate b' hoi hwo
  apply (projective_mk_mem_points _ _ hw).mp
  rw [← hpw, ← htrans]
  exact (collineation_point_mem_iff hψ _ _).mpr
    ((projective_mk_mem_points _ _ hv).mpr (projective_affine_fiber_mem b hoi hvo))

end Papers.OaiReconstructionMilnorTheory
