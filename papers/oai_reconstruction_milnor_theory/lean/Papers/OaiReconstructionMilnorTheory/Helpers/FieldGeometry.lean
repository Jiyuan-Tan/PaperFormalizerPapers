module

public import Papers.OaiReconstructionMilnorTheory.Helpers.InducedMaps
public import Papers.OaiReconstructionMilnorTheory.Helpers.ScalarLine
public import Papers.OaiReconstructionMilnorTheory.Helpers.ProjectiveLiftBasic

/-! # Field isomorphisms preserve power-subfield projective geometry -/

@[expose] public section

namespace Papers.OaiReconstructionMilnorTheory

variable (p : ℕ) {K L : Type*} [Field K] [Field L]

-- @node: fieldIso_mem_powSubfield
/-- For an exponent p and [a field isomorphism α from K to L](hyp:α),
if [x belongs to the subfield of K generated by p-th powers](hyp:hx), then
[α sends x into the subfield of L generated by p-th powers](goal). -/
lemma fieldIso_mem_powSubfield (α : K ≃+* L) {x : K}
    (hx : x ∈ powSubfield p K) : α x ∈ powSubfield p L := by
  have hle : powSubfield p K ≤ (powSubfield p L).comap α.toRingHom := by
    apply Subfield.closure_le.mpr
    rintro _ ⟨a, rfl⟩
    change α (a ^ p) ∈ powSubfield p L
    rw [map_pow]
    exact Subfield.subset_closure ⟨α a, rfl⟩
  exact hle hx

-- @node: fieldIso_powerEquiv
/-- For [an exponent p](hyp:p) and [a field isomorphism α](hyp:α) between
[a source field K](hyp:K) and [a target field L](hyp:L),
[the induced isomorphism between their subfields generated by p-th powers](goal)
is the restriction of α to those subfields. -/
noncomputable def fieldIso_powerEquiv (α : K ≃+* L) :
    ↥(powSubfield p K) ≃+* ↥(powSubfield p L) where
  toFun a := ⟨α a, fieldIso_mem_powSubfield p α a.property⟩
  invFun a := ⟨α.symm a, fieldIso_mem_powSubfield p α.symm a.property⟩
  left_inv a := Subtype.ext (α.symm_apply_apply a)
  right_inv a := Subtype.ext (α.apply_symm_apply a)
  map_mul' a b := Subtype.ext (α.map_mul a b)
  map_add' a b := Subtype.ext (α.map_add a b)

-- @node: fieldIso_powerSemilinear
/-- For [an exponent p](hyp:p) and [a field isomorphism α](hyp:α) from
[a field K](hyp:K) to [a field L](hyp:L),
[the semilinear map from K to L over the induced isomorphism of power-generated
subfields](goal) sends each element to its image under α. -/
noncomputable def fieldIso_powerSemilinear (α : K ≃+* L) :
    K →ₛₗ[(fieldIso_powerEquiv p α : ↥(powSubfield p K) →+* ↥(powSubfield p L))] L where
  toFun := α
  map_add' := α.map_add
  map_smul' a x := α.map_mul a x

-- @node: fieldIso_plane_finrank
/-- For an exponent p, [a field isomorphism α from K to L](hyp:α), and
[a subspace W of K over its subfield generated by p-th powers](hyp:W), if
[W has dimension two](hyp:hd), then [its image under α has dimension two over
the corresponding subfield of L](goal). -/
lemma fieldIso_plane_finrank (α : K ≃+* L)
    (W : Submodule ↥(powSubfield p K) K)
    (hd : Module.finrank ↥(powSubfield p K) W = 2) :
    Module.finrank ↥(powSubfield p L) (W.map (fieldIso_powerSemilinear p α)) = 2 := by
  classical
  let : FiniteDimensional ↥(powSubfield p K) W := Module.finite_of_finrank_eq_succ hd
  let b : Module.Basis (Fin 2) ↥(powSubfield p K) W :=
    (Module.finBasis ↥(powSubfield p K) W).reindex (finCongr hd)
  let v : Fin 2 → K := fun i => b i
  have hli : LinearIndependent ↥(powSubfield p K) v :=
    b.linearIndependent.map' W.subtype (Submodule.ker_subtype W)
  have hspan : Submodule.span ↥(powSubfield p K) (Set.range v) = W := by
    have h := congrArg (Submodule.map W.subtype) b.span_eq
    simpa only [Submodule.map_span, ← Set.range_comp, Submodule.map_top,
      Submodule.range_subtype, Function.comp_def, Submodule.subtype_apply, v] using h
  have himage : LinearIndependent ↥(powSubfield p L) (fun i => α (v i)) :=
    hli.map_of_surjective_injectiveₛ (fieldIso_powerEquiv p α) α.toAddEquiv.toAddMonoidHom
      (fieldIso_powerEquiv p α).surjective α.injective (fun a x => α.map_mul a x)
  rw [← hspan, Submodule.map_span, ← Set.range_comp]
  exact (finrank_span_eq_card himage).trans (by simp)

-- @node: inducedMap_preserves_lines
/-- For an exponent p, [a field isomorphism α from K to L](hyp:α), and
[a set S of degree-one Milnor classes of K modulo p](hyp:S), if
[S is a projective line over the subfield generated by p-th powers](hyp:hS), then
[the image of S under the induced map is a projective line for L](goal). -/
lemma inducedMap_preserves_lines (α : K ≃+* L)
    (S : Set (MilnorOne K p)) (hS : IsProjLine p K S) :
    IsProjLine p L (inducedMap p α '' S) := by
  obtain ⟨W, hd, rfl⟩ := hS
  refine ⟨W.map (fieldIso_powerSemilinear p α), fieldIso_plane_finrank p α W hd, ?_⟩
  ext z
  constructor
  · rintro ⟨_, ⟨f, hfW, hf, rfl⟩, rfl⟩
    exact ⟨α f, ⟨f, hfW, rfl⟩, (map_ne_zero α).mpr hf, (inducedMap_cls p α hf).symm⟩
  · rintro ⟨_, ⟨f, hfW, rfl⟩, hf, rfl⟩
    have hf0 : f ≠ 0 := fun h => hf (by simp [h])
    exact ⟨cls p f, ⟨f, hfW, hf0, rfl⟩, inducedMap_cls p α hf0⟩

-- @node: fieldIso_eq_of_inducedMap_eq
/-- For an exponent p, suppose L is finite-dimensional over its subfield
generated by p-th powers and [that dimension is at least two](hyp:hd).
If [field isomorphisms α and β from K to L](hyp:α,β)
[induce the same map on degree-one Milnor classes modulo p](hyp:h), then
[α and β are equal](goal). -/
lemma fieldIso_eq_of_inducedMap_eq
    [FiniteDimensional ↥(powSubfield p L) L]
    (hd : 2 ≤ Module.finrank ↥(powSubfield p L) L)
    (α β : K ≃+* L) (h : inducedMap p α = inducedMap p β) : α = β := by
  let T : L ≃+ L := α.symm.toAddEquiv.trans β.toAddEquiv
  have hlines (w : L) : ∃ a : ↥(powSubfield p L), T w = a • w := by
    by_cases hw : w = 0
    · exact ⟨0, by simp [hw]⟩
    have hf : α.symm w ≠ 0 := (map_ne_zero α.symm).mpr hw
    have hcls : cls p (β (α.symm w)) = cls p w := by
      have heq := congrFun h (cls p (α.symm w))
      rw [inducedMap_cls p α hf, inducedMap_cls p β hf, α.apply_symm_apply] at heq
      exact heq.symm
    let a : ↥(powSubfield p L) :=
      ⟨β (α.symm w) / w, cls_eq_ratio_mem_powSubfield p L
        ((map_ne_zero β).mpr hf) hw hcls⟩
    exact ⟨a, (div_mul_cancel₀ (β (α.symm w)) hw).symm⟩
  obtain ⟨c, hc⟩ := projective_additive_scalar hd T.toAddMonoidHom hlines
  have hc1 : (c : L) = 1 := by
    have h1 := hc 1
    change β (α.symm 1) = (c : L) * 1 at h1
    simpa only [map_one, mul_one] using h1.symm
  ext x
  have hx := hc (α x)
  change β (α.symm (α x)) = (c : L) * α x at hx
  rw [α.symm_apply_apply, hc1, one_mul] at hx
  exact hx.symm

-- @node: fieldIso_induced_scalar_eq_one
/-- Suppose [p is prime](hyp:hp), [L has characteristic p](hyp:hL), and
[the subfield of L generated by p-th powers is proper](hyp:himperfect).
For [field isomorphisms α and β from K to L](hyp:α,β) and
[an invertible coefficient r modulo p](hyp:r), if [the Milnor map induced by β
is r times the map induced by α](hyp:h), then [r is one](goal). -/
lemma fieldIso_induced_scalar_eq_one (hp : PrimeChar p) (hL : CharP L p)
    (himperfect : powSubfield p L ≠ ⊤)
    (α β : K ≃+* L) (r : (Coeff p)ˣ)
    (h : inducedMap p β = scalarAct p r (inducedMap p α)) : r = 1 := by
  apply scalar_eq_one_of_preserves_lines p L r hp hL himperfect
  intro S hS
  let S' := inducedMap p β '' (inducedMap p α.symm '' S)
  refine ⟨S', inducedMap_preserves_lines p β _
    (inducedMap_preserves_lines p α.symm S hS), ?_⟩
  have hcomp : (fun x : MilnorOne L p => (r : Coeff p) • x) =
      inducedMap p β ∘ inducedMap p α.symm := by
    funext x
    have hinv : inducedMap p α (inducedMap p α.symm x) = x := by
      simpa only [RingEquiv.symm_symm] using inducedMap_symm_apply p α.symm x
    simp only [Function.comp_apply, h, scalarAct, hinv]
  rw [hcomp, Set.image_comp]

-- @node: powSubfield_ne_top_of_finrank
/-- For an exponent p, if [the dimension of L over its subfield generated
by p-th powers is at least two](hyp:hd), then [that subfield is a proper subfield
of L](goal). -/
lemma powSubfield_ne_top_of_finrank
    (hd : 2 ≤ Module.finrank ↥(powSubfield p L) L) : powSubfield p L ≠ ⊤ := by
  intro htop
  have hspan : Submodule.span ↥(powSubfield p L) ({1} : Set L) = ⊤ := by
    apply top_unique
    intro x _
    apply Submodule.mem_span_singleton.mpr
    exact ⟨⟨x, by rw [htop]; trivial⟩, mul_one x⟩
  have heq := finrank_span_singleton (K := ↥(powSubfield p L)) (one_ne_zero : (1 : L) ≠ 0)
  rw [hspan, finrank_top] at heq
  omega

-- @node: fieldIso_eq_of_inducedMap_scalar
/-- Suppose [p is prime](hyp:hp), [L has characteristic p](hyp:hL), and L is
finite-dimensional over its subfield generated by p-th powers, with
[dimension at least two](hyp:hd). For [field isomorphisms α and β from K to L](hyp:α,β)
and [an invertible coefficient r modulo p](hyp:r), if [the Milnor map induced
by β is r times the map induced by α](hyp:h), then [α and β are equal](goal). -/
lemma fieldIso_eq_of_inducedMap_scalar (hp : PrimeChar p) (hL : CharP L p)
    [FiniteDimensional ↥(powSubfield p L) L]
    (hd : 2 ≤ Module.finrank ↥(powSubfield p L) L)
    (α β : K ≃+* L) (r : (Coeff p)ˣ)
    (h : inducedMap p β = scalarAct p r (inducedMap p α)) : α = β := by
  have hr := fieldIso_induced_scalar_eq_one p hp hL (powSubfield_ne_top_of_finrank p hd) α β r h
  rw [hr] at h
  have heq : inducedMap p α = inducedMap p β := by
    funext x
    simpa only [scalarAct, Units.val_one, one_smul] using (congrFun h x).symm
  exact fieldIso_eq_of_inducedMap_eq p hd α β heq

end Papers.OaiReconstructionMilnorTheory
