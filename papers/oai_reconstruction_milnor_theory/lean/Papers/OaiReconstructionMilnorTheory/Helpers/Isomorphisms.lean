module

public import Papers.OaiReconstructionMilnorTheory.Basic
public import Mathlib.Algebra.Ring.Equiv

/-! # Compatible Milnor isomorphisms and base-preserving field isomorphisms -/

@[expose] public section

namespace Papers.OaiReconstructionMilnorTheory

-- @env: S5
variable (p : ℕ) {K L : Type*} [Field K] [Field L]
-- @realizes K(source field)
-- @realizes L(target field)

-- @node: ass:compatible-linear
/-- For [a modulus p](hyp:p), [a source field K](hyp:K), [a target field L](hyp:L),
and [a map Θ between their degree-one Milnor groups](hyp:Θ), the
[linear compatibility condition](goal) requires [Θ to be linear over the integers
modulo p](step:1) and [Θ to be bijective](step:2). -/
def CompatibleLinear (K L : Type*) [Field K] [Field L]
    (Θ : MilnorOne K p → MilnorOne L p) : Prop := -- @realizes \Theta(carrier V_K → V_L)
  -- @realizes V_K(MilnorOne K p)
  -- @realizes V_L(MilnorOne L p)
  IsLinearMap (Coeff p) Θ ∧ Function.Bijective Θ -- @realizes \Theta(linear bijection)

-- @node: ass:compatible-relations
/-- For [a modulus p](hyp:p), [a source field K](hyp:K), [a target field L](hyp:L),
and [a map Θ between their degree-one Milnor groups](hyp:Θ), the
[relation compatibility condition](goal) requires a linear map φ such that
[φ has underlying function Θ](step:1) and [the tensor square of φ maps the
source Steinberg relation subspace onto the target Steinberg relation subspace](step:2). -/
def CompatibleRelations (K L : Type*) [Field K] [Field L]
    (Θ : MilnorOne K p → MilnorOne L p) : Prop :=
  ∃ φ : MilnorOne K p →ₗ[Coeff p] MilnorOne L p, ⇑φ = Θ ∧
    Submodule.map (TensorProduct.map φ φ)
      (steinbergRel p K) = -- @realizes R_K(source relations)
      steinbergRel p L -- @realizes R_L(target relations)
      -- @realizes \Theta(tensor map takes R_K onto R_L)

-- @node: def:compatible-isomorphisms
-- @realizes \Isom_{\mathrm M}(V_K,V_L)(compatible-isomorphism class)
/-- For [a modulus p](hyp:p) and [a map Θ between the degree-one Milnor groups
of two fields](hyp:Θ), a [compatible isomorphism](goal) satisfies
[linearity and bijectivity over the integers modulo p](step:1) and
[preservation of the Steinberg relation subspaces by its tensor square](step:2). -/
structure IsCompatibleIso (Θ : MilnorOne K p → MilnorOne L p) : Prop where
  linear : CompatibleLinear p K L Θ
  relations : CompatibleRelations p K L Θ

-- @node: ass:field-isomorphism
/-- For [a source field K](hyp:K), [a target field L](hyp:L), and
[a function α from K to L](hyp:α), the [field-isomorphism condition](goal)
says that α is the underlying function of a field isomorphism. -/
def IsFieldIsoFun (K L : Type*) [Field K] [Field L]
    (α : K → L) : Prop := -- @realizes \alpha(carrier K → L)
  ∃ e : K ≃+* L, ⇑e = α -- @realizes \alpha(field isomorphism)

-- @node: ass:base-preservation
/-- For [a source subfield k](hyp:k), [a target subfield l](hyp:l), and
[a function α between their ambient fields](hyp:α), the [base-preservation
condition](goal) says that the image of k under α is exactly l. -/
def PreservesBase (k : Subfield K) (l : Subfield L) (α : K → L) : Prop :=
  α '' (k : Set K) = (l : Set L) -- @realizes \alpha(maps k onto l)

-- @node: def:base-isomorphisms
-- @realizes \Isom(K,k;L,l)(base-preserving field-isomorphism class)
/-- For [a source subfield k](hyp:k), [a target subfield l](hyp:l), and
[a function α between their ambient fields](hyp:α), a [base-preserving
isomorphism](goal) requires [α to be a field isomorphism](step:1) and
[α to map k onto l](step:2). -/
structure IsBaseIso (k : Subfield K) (l : Subfield L) (α : K → L) : Prop where
  fieldIso : IsFieldIsoFun K L α
  base : PreservesBase k l α

-- @node: def:induced-map
-- @realizes \alpha_*(map on multiplicative quotient classes)
/-- For [a modulus p](hyp:p), [a field isomorphism α](hyp:α), and
[a degree-one Milnor class x in its source field](hyp:x), the [induced image
of x](goal) is the class of the image under α of a nonzero representative of x. -/
noncomputable def inducedMap (α : K ≃+* L) (x : MilnorOne K p) : MilnorOne L p :=
  cls p (α ((Quotient.out (Additive.toMul x) : Kˣ) : K))

/-- For [a modulus p](hyp:p), [an invertible scalar r modulo p](hyp:r), and
[a map Θ between degree-one Milnor groups](hyp:Θ), the [scalar multiple of Θ](goal)
sends each class x to r times Θ applied to x.

Its action on compatible isomorphisms is `scalarCompatibleAction`. -/
noncomputable def scalarAct (r : (Coeff p)ˣ) (Θ : MilnorOne K p → MilnorOne L p) :
    MilnorOne K p → MilnorOne L p := -- @realizes \Psi(scalar multiple nΘ when r=n)
  fun x => (r : Coeff p) • Θ x

-- @node: def:lines-power-fields
/-- For [an exponent p](hyp:p), [a field K](hyp:K), and [a field L](hyp:L), the
[pair of power subfields](goal) consists of the subfield generated by p-th powers
in K and the subfield generated by p-th powers in L, in that order. -/
abbrev linesPowerFields (K L : Type*) [Field K] [Field L] : Subfield K × Subfield L :=
  (powSubfield p K, powSubfield p L) -- @realizes H(K^p) @realizes C(L^p)

-- @node: ass:main-fields
/-- For [a characteristic parameter p](hyp:p), [a source subfield k](hyp:k), and
[a target subfield l](hyp:l), the [geometric-field condition](goal) requires
[k to be algebraically closed and its ambient field K to have characteristic p
and be finitely generated over k](step:1), and [l to be algebraically closed
and its ambient field L to have characteristic p and be finitely generated over l](step:2). -/
def MainFields (k : Subfield K) -- @realizes k(source subfield)
    (l : Subfield L) : Prop := -- @realizes l(target subfield)
  GeometricField p ↥k K ∧ -- @realizes K(FG, char p) @realizes k(alg closed)
  GeometricField p ↥l L -- @realizes L(FG, char p) @realizes l(alg closed)

-- @node: ass:main-dimension
/-- For [a source subfield k](hyp:k) and [a target subfield l](hyp:l), the
[dimension condition](goal) requires [K to have transcendence degree at least
two over k](step:1) and [L to have transcendence degree at least two over l](step:2). -/
def MainDimension (k : Subfield K) (l : Subfield L) : Prop :=
  2 ≤ Algebra.trdeg ↥k K ∧ -- @realizes K(trdeg at least 2) @realizes k(base)
  2 ≤ Algebra.trdeg ↥l L -- @realizes L(trdeg at least 2) @realizes l(base)

end Papers.OaiReconstructionMilnorTheory
