module

public import Papers.OaiReconstructionMilnorTheory.Helpers.PBasis

/-! # Rigidity of scalars preserving power-subfield projective lines -/

@[expose] public section

namespace Papers.OaiReconstructionMilnorTheory

variable (p : ℕ) (F : Type*) [Field F]

-- @node: ass:scalar-line-field
/-- For [a natural number p](hyp:p) and [a field F](hyp:F), the
[scalar-line characteristic condition](goal) says that F has characteristic p. -/
def ScalarLineFieldChar : Prop := CharP F p

-- @node: ass:scalar-line-imperfect
/-- For [an exponent p](hyp:p) and [a field F](hyp:F), the
[scalar-line imperfection condition](goal) says that the subfield generated by
p-th powers is a proper subfield of F. -/
def ScalarLineImperfect : Prop := powSubfield p F ≠ ⊤ -- @realizes F(imperfect field)

-- @node: ass:scalar-line-preservation
/-- For [a modulus p](hyp:p), [a field F](hyp:F), and [an invertible scalar r
modulo p](hyp:r), the [scalar-line preservation condition](goal) says that
multiplication by r sends each projective line of degree-one Milnor classes
into some projective line. -/
def ScalarLinePreservation (r : (Coeff p)ˣ) : Prop := -- @realizes r(nonzero scalar in F_p)
  ∀ S : Set (MilnorOne F p), IsProjLine p F S →
    ∃ S', IsProjLine p F S' ∧ (fun x => (r : Coeff p) • x) '' S ⊆ S'

-- @node: cls_eq_ratio_mem_powSubfield
/-- If [f is nonzero](hyp:hf), [g is nonzero](hyp:hg), and [their degree-one
Milnor classes modulo p agree](hyp:h), then [f divided by g belongs to the
subfield generated by p-th powers](goal). -/
lemma cls_eq_ratio_mem_powSubfield {f g : F} (hf : f ≠ 0) (hg : g ≠ 0)
    (h : cls p f = cls p g) : f / g ∈ powSubfield p F := by
  unfold cls MilnorOne at h
  rw [dif_neg hf, dif_neg hg] at h
  have heq : (QuotientGroup.mk (Units.mk0 f hf) :
      Fˣ ⧸ (powMonoidHom p : Fˣ →* Fˣ).range) =
      QuotientGroup.mk (Units.mk0 g hg) := h
  obtain ⟨u, hu⟩ := QuotientGroup.eq_iff_div_mem.mp heq
  apply Subfield.subset_closure
  refine ⟨(u : F), ?_⟩
  simpa using congrArg (fun v : Fˣ => (v : F)) hu

-- @node: powSubfield_aeval_ne_zero
/-- If [p is prime](hyp:hp), [F has characteristic p](hyp:hF), [x lies outside
the subfield generated by p-th powers](hyp:hx), and [q is a nonzero polynomial
over that subfield](hyp:hq) [of degree less than p](hyp:hd), then
[evaluating q at x gives a nonzero element](goal). -/
lemma powSubfield_aeval_ne_zero (hp : PrimeChar p) (hF : CharP F p)
    {x : F} (hx : x ∉ powSubfield p F) {q : Polynomial ↥(powSubfield p F)}
    (hq : q ≠ 0) (hd : q.natDegree < p) : Polynomial.aeval x q ≠ 0 := by
  let : Fact p.Prime := ⟨hp⟩
  let : CharP F p := hF
  let C := powSubfield p F
  let a : C := ⟨x ^ p, Subfield.subset_closure ⟨x, rfl⟩⟩
  have hirr : Irreducible (Polynomial.X ^ p - Polynomial.C a) := by
    apply X_pow_sub_C_irreducible_of_prime hp
    intro b hb
    have heq : (b : F) ^ p = x ^ p := congrArg (fun y : C => (y : F)) hb
    have hbx : (b : F) = x := (frobenius F p).injective heq
    exact hx (hbx ▸ b.property)
  have hroot : Polynomial.aeval x (Polynomial.X ^ p - Polynomial.C a) = 0 := by
    simp only [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
    change x ^ p - x ^ p = 0
    exact sub_self _
  have hmin : minpoly C x = Polynomial.X ^ p - Polynomial.C a :=
    (minpoly.eq_of_irreducible_of_monic hirr hroot (Polynomial.monic_X_pow_sub_C a hp.ne_zero)).symm
  intro heval
  have hdiv := minpoly.dvd C x heval
  have hdeg := Polynomial.natDegree_le_of_dvd hdiv hq
  rw [hmin, Polynomial.natDegree_X_pow_sub_C] at hdeg
  exact (not_le_of_gt hd) hdeg

-- @node: scalarLine_binomial_rigidity
/-- Suppose [p is prime](hyp:hp), [F has characteristic p](hyp:hF), [x lies
outside the subfield generated by p-th powers](hyp:hx), [n is at least one](hyp:hn)
and [less than p](hyp:hnp), and [the n-th power of x + 1 equals a + b times
the n-th power of x, with a and b in that subfield](hyp:hab).
Then [n equals one](goal). -/
lemma scalarLine_binomial_rigidity (hp : PrimeChar p) (hF : CharP F p)
    {x : F} (hx : x ∉ powSubfield p F) {n : ℕ} (hn : 1 ≤ n) (hnp : n < p)
    (a b : ↥(powSubfield p F)) (hab : (x + 1) ^ n = (a : F) + (b : F) * x ^ n) :
    n = 1 := by
  let C := powSubfield p F
  let : CharP F p := hF
  let : CharP C p := (C.subtype.charP_iff Subtype.val_injective p).mpr inferInstance
  by_contra hn1
  have hn2 : 2 ≤ n := by omega
  let q : Polynomial C := (Polynomial.X + 1) ^ n -
    (Polynomial.C a + Polynomial.C b * Polynomial.X ^ n)
  have hdeg : q.natDegree < p := by
    apply lt_of_le_of_lt (b := n) ?_ hnp
    apply (Polynomial.natDegree_sub_le _ _).trans
    apply max_le
    · calc
        ((Polynomial.X + 1 : Polynomial C) ^ n).natDegree ≤
            n * (Polynomial.X + 1 : Polynomial C).natDegree := Polynomial.natDegree_pow_le
        _ ≤ n * 1 := Nat.mul_le_mul_left n (by
          simpa using Polynomial.natDegree_add_le (Polynomial.X : Polynomial C) 1)
        _ = n := mul_one _
    · exact (Polynomial.natDegree_add_le _ _).trans (max_le
        (by simp)
        ((Polynomial.natDegree_mul_le).trans (by simp)))
  have heval : Polynomial.aeval x q = 0 := by
    simp only [q, map_sub, map_add, map_pow, map_one, map_mul,
      Polynomial.aeval_X, Polynomial.aeval_C]
    change (x + 1) ^ n - ((a : F) + (b : F) * x ^ n) = 0
    exact sub_eq_zero.mpr hab
  have hq : q = 0 := by
    by_contra hne
    exact powSubfield_aeval_ne_zero p F hp hF hx hne hdeg heval
  have hcoeff := congrArg (fun f : Polynomial C => f.coeff (n - 1)) hq
  have hne : n - 1 ≠ n := by omega
  have hpos : n - 1 ≠ 0 := by omega
  have hcast : (n : C) = 0 := by
    simpa [q, Polynomial.coeff_X_add_one_pow, Polynomial.coeff_C, Polynomial.coeff_C_mul,
      Polynomial.coeff_X_pow, hne, hne.symm, hpos, Nat.choose_symm hn,
      Nat.choose_one_right] using hcoeff
  have hn0 : n = 0 := CharP.natCast_injOn_Iio C p hnp hp.pos (by simpa using hcast)
  omega

-- @node: scalarLine_pow_not_mem
/-- If [p is prime](hyp:hp), [F has characteristic p](hyp:hF), [x lies outside
the subfield generated by p-th powers](hyp:hx), and [n is at least one](hyp:hn)
and [less than p](hyp:hnp), then [the n-th power of x also lies outside that
subfield](goal). -/
lemma scalarLine_pow_not_mem (hp : PrimeChar p) (hF : CharP F p)
    {x : F} (hx : x ∉ powSubfield p F) {n : ℕ} (hn : 1 ≤ n) (hnp : n < p) :
    x ^ n ∉ powSubfield p F := by
  intro hxn
  let a : ↥(powSubfield p F) := ⟨x ^ n, hxn⟩
  have hne : Polynomial.X ^ n - Polynomial.C a ≠ 0 :=
    (Polynomial.monic_X_pow_sub_C a (by omega)).ne_zero
  apply powSubfield_aeval_ne_zero p F hp hF hx hne
    (by simpa [Polynomial.natDegree_X_pow_sub_C] using hnp)
  simp only [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
  change x ^ n - x ^ n = 0
  exact sub_self _

-- @node: scalarLine_plane_finrank
/-- If [x lies outside the subfield generated by p-th powers](hyp:hx), then
[the span of 1 and x has dimension two over that subfield](goal). -/
lemma scalarLine_plane_finrank {x : F} (hx : x ∉ powSubfield p F) :
    Module.finrank ↥(powSubfield p F)
      (Submodule.span ↥(powSubfield p F) ({(1 : F), x} : Set F)) = 2 := by
  have hli : LinearIndependent ↥(powSubfield p F) (![x, 1] : Fin 2 → F) := by
    rw [linearIndependent_fin2]
    simp only [Matrix.cons_val_one, Matrix.cons_val_zero, ne_eq,
      one_ne_zero, not_false_eq_true, true_and]
    intro a ha
    apply hx
    have heq : (a : F) = x := by
      change (a : F) * 1 = x at ha
      simpa using ha
    exact heq ▸ a.property
  have hrange : Set.range (![x, 1] : Fin 2 → F) = ({1, x} : Set F) := by
    ext y
    simp [Set.mem_insert_iff, or_comm]
  have hd := finrank_span_eq_card hli
  rw [hrange] at hd
  exact hd

-- @node: scalarLine_mem_of_cls_eq
/-- If [f is nonzero](hyp:hf), [g is nonzero](hyp:hg), [their degree-one Milnor
classes modulo p agree](hyp:h), and [g belongs to a vector subspace W over
the subfield generated by p-th powers](hyp:hgW), then [f also belongs to W](goal). -/
lemma scalarLine_mem_of_cls_eq (W : Submodule ↥(powSubfield p F) F)
    {f g : F} (hf : f ≠ 0) (hg : g ≠ 0) (h : cls p f = cls p g) (hgW : g ∈ W) :
    f ∈ W := by
  let c : ↥(powSubfield p F) := ⟨f / g, cls_eq_ratio_mem_powSubfield p F hf hg h⟩
  have hc : c • g = f := by
    change (f / g) * g = f
    exact div_mul_cancel₀ f hg
  exact hc ▸ W.smul_mem c hgW

-- @node: lem:scalar-line
/-- If [p is prime](hyp:hp), [F has characteristic p](hyp:hF), [the subfield
generated by p-th powers is proper in F](hyp:himperfect), and [multiplication
by the invertible scalar r sends every projective line of degree-one Milnor
classes into a projective line](hyp:hpreserves), then [r equals one](goal). -/
lemma scalar_eq_one_of_preserves_lines (r : (Coeff p)ˣ)
    (hp : PrimeChar p) (hF : ScalarLineFieldChar p F)
    (himperfect : ScalarLineImperfect p F) (hpreserves : ScalarLinePreservation p F r) :
    r = 1 := by
  classical
  let : Fact p.Prime := ⟨hp⟩
  let : CharP F p := hF
  let C := powSubfield p F
  obtain ⟨x, hx⟩ : ∃ x : F, x ∉ C := by
    by_contra! h
    exact himperfect (top_unique (fun x _ => h x))
  have hx0 : x ≠ 0 := fun h => hx (h ▸ C.zero_mem)
  have hx10 : x + 1 ≠ 0 := by
    intro h
    have heq : x = -1 := eq_neg_of_add_eq_zero_left h
    exact hx (heq ▸ C.neg_mem C.one_mem)
  let n : ℕ := (r : Coeff p).val
  have hnp : n < p := ZMod.val_lt _
  have hn : 1 ≤ n := ZMod.val_pos.mpr (Units.ne_zero r)
  have haction (f : F) (hf : f ≠ 0) :
      (r : Coeff p) • cls p f = cls p (f ^ n) := by
    rw [← ZMod.natCast_zmod_val (r : Coeff p), Nat.cast_smul_eq_nsmul]
    simpa only [zpow_natCast, natCast_zsmul] using (cls_zpow p f hf (n : ℤ)).symm
  let W := Submodule.span C ({(1 : F), x} : Set F)
  let S : Set (MilnorOne F p) := {z | ∃ f ∈ W, f ≠ 0 ∧ cls p f = z}
  have hline : IsProjLine p F S := ⟨W, scalarLine_plane_finrank p F hx, rfl⟩
  obtain ⟨S', ⟨W', hdW', hS'⟩, hmap⟩ := hpreserves S hline
  have hmem (f : F) (hfW : f ∈ W) (hf : f ≠ 0) : f ^ n ∈ W' := by
    have hc : (r : Coeff p) • cls p f ∈ S' :=
      hmap ⟨cls p f, ⟨f, hfW, hf, rfl⟩, rfl⟩
    rw [haction f hf, hS'] at hc
    obtain ⟨g, hgW, hg0, hgc⟩ := hc
    exact scalarLine_mem_of_cls_eq p F W' (pow_ne_zero _ hf) hg0 hgc.symm hgW
  have h1W : (1 : F) ∈ W := Submodule.subset_span (by simp)
  have hxW : x ∈ W := Submodule.subset_span (by simp)
  have h1W' : (1 : F) ∈ W' := by simpa using hmem 1 h1W one_ne_zero
  have hxnW' : x ^ n ∈ W' := hmem x hxW hx0
  have hsumW' : (x + 1) ^ n ∈ W' := hmem (x + 1) (W.add_mem hxW h1W) hx10
  have hxn : x ^ n ∉ C := scalarLine_pow_not_mem p F hp hF hx hn hnp
  let P := Submodule.span C ({(1 : F), x ^ n} : Set F)
  have hle : P ≤ W' := Submodule.span_le.mpr (by
    intro y hy
    rcases hy with rfl | hy
    · exact h1W'
    · have hy' : y = x ^ n := hy
      exact hy' ▸ hxnW')
  have hfinite : FiniteDimensional C W' :=
    Module.finite_of_finrank_eq_succ hdW'
  let := hfinite
  have hPW : P = W' := Submodule.eq_of_le_of_finrank_eq hle
    ((scalarLine_plane_finrank p F hxn).trans hdW'.symm)
  rw [← hPW] at hsumW'
  obtain ⟨a, b, hab⟩ := Submodule.mem_span_pair.mp hsumW'
  have hab' : (x + 1) ^ n = (a : F) + (b : F) * x ^ n := by
    change (a : F) * 1 + (b : F) * x ^ n = (x + 1) ^ n at hab
    simpa using hab.symm
  have hn1 := scalarLine_binomial_rigidity p F hp hF hx hn hnp a b hab'
  apply Units.ext
  have hr := ZMod.natCast_zmod_val (r : Coeff p)
  change (r : Coeff p) = 1
  rw [← hr]
  change (n : Coeff p) = 1
  rw [hn1, Nat.cast_one]

end Papers.OaiReconstructionMilnorTheory
