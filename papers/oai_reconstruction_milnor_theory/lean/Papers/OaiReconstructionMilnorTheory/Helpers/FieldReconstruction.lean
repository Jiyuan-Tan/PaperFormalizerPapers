module

public import Papers.OaiReconstructionMilnorTheory.Helpers.MilnorProjective
public import Papers.OaiReconstructionMilnorTheory.Helpers.NormalizedLift
public import Papers.OaiReconstructionMilnorTheory.Helpers.PDegree
public import Mathlib.FieldTheory.FinTrdeg

/-! # Reconstructing a field map from a line-preserving Milnor isomorphism -/

@[expose] public section

namespace Papers.OaiReconstructionMilnorTheory

variable (p : ℕ) {K L : Type*} [Field K] [Field L]

-- @node: geometricField_powSubfield_finrank_ge_four
/-- For [a base field κ](hyp:κ), suppose [p is prime](hyp:hp),
[κ is algebraically closed and K is a finitely generated extension of κ of
characteristic p](hyp:hK), and [K has transcendence degree at least two over κ](hyp:hdim).
Then [K has dimension at least four over its subfield generated by p-th powers](goal). -/
lemma geometricField_powSubfield_finrank_ge_four
    (κ : Type*) [Field κ] [Algebra κ K] (hp : PrimeChar p)
    (hK : GeometricField p κ K) (hdim : 2 ≤ Algebra.trdeg κ K) :
    4 ≤ Module.finrank ↥(powSubfield p K) K := by
  have hdegree := (finrank_powSubfield_eq_pow_trdeg p κ K hp hK).2
  change Module.finrank ↥(powSubfield p K) K = p ^ (Algebra.trdeg κ K).toNat at hdegree
  let : Algebra.EssFiniteType κ K := IntermediateField.fg_top_iff.mp hK.2.2
  have hd : 2 ≤ (Algebra.trdeg κ K).toNat := by
    simpa only [Cardinal.toNat_ofNat] using
      Cardinal.toNat_le_toNat hdim (trdeg_lt_aleph0 κ K)
  rw [hdegree]
  calc
    4 = 2 ^ 2 := rfl
    _ ≤ p ^ 2 := by gcongr; exact hp.two_le
    _ ≤ p ^ (Algebra.trdeg κ K).toNat := pow_le_pow_right' hp.one_lt.le hd

-- @node: mainFields_projectiveLiftSpaces
/-- For [a subfield k of K](hyp:k) and [a subfield l of L](hyp:l), suppose
[p is prime](hyp:hp), [k and l are algebraically closed and K and L are finitely
generated extensions of their respective bases of characteristic p](hyp:hfields),
and [both extensions have transcendence degree at least two](hyp:hdim).
Then [K and L are finite-dimensional, each of dimension at least three, over
their respective subfields generated by p-th powers](goal). -/
lemma mainFields_projectiveLiftSpaces (k : Subfield K) (l : Subfield L)
    (hp : PrimeChar p) (hfields : MainFields p k l) (hdim : MainDimension k l) :
    ProjectiveLiftSpaces ↥(powSubfield p K) ↥(powSubfield p L) K L := by
  refine ⟨geometricField_finiteDimensional_powSubfield p ↥k K hp hfields.1,
    geometricField_finiteDimensional_powSubfield p ↥l L hp hfields.2, ?_, ?_⟩
  · have := geometricField_powSubfield_finrank_ge_four p ↥k hp hfields.1 hdim.1
    omega
  · have := geometricField_powSubfield_finrank_ge_four p ↥l hp hfields.2 hdim.2
    omega

-- @node: additiveLift_normalize
/-- Suppose [p is prime](hyp:hp), [K has characteristic p](hyp:hK), and
[L has characteristic p](hyp:hL). If [an additive map Ψ between their degree-one
Milnor groups modulo p](hyp:Ψ) has [an additive bijection S from K to L](hyp:S)
[whose value at every nonzero x represents Ψ of the class of x](hyp:hcls), then
[there is an additive bijection T from K to L sending one to one and inducing
the same class map at every nonzero x](goal). -/
lemma additiveLift_normalize (hp : PrimeChar p) (hK : CharP K p) (hL : CharP L p)
    (Ψ : MilnorOne K p →+ MilnorOne L p) (S : K ≃+ L)
    (hcls : ∀ x, x ≠ 0 → cls p (S x) = Ψ (cls p x)) :
    ∃ T : K ≃+ L, T 1 = 1 ∧ ∀ x, x ≠ 0 → cls p (T x) = Ψ (cls p x) := by
  have hS1 : S 1 ≠ 0 := fun h => one_ne_zero (S.injective (h.trans S.map_zero.symm))
  have hcls1 : cls p (1 : K) = 0 :=
    cls_eq_zero_of_mem_powSubfield p hp hK (Subfield.one_mem _) one_ne_zero
  have hcls1L : cls p (1 : L) = 0 :=
    cls_eq_zero_of_mem_powSubfield p hp hL (Subfield.one_mem _) one_ne_zero
  have hC : S 1 ∈ powSubfield p L := by
    have h := cls_eq_ratio_mem_powSubfield p L hS1 one_ne_zero
      (by rw [hcls 1 one_ne_zero, hcls1, map_zero, hcls1L])
    simpa only [div_one] using h
  let T : K ≃+ L := S.trans
    (LinearEquiv.smulOfNeZero L L (S 1)⁻¹ (inv_ne_zero hS1)).toAddEquiv
  have hT (x : K) : T x = (S 1)⁻¹ * S x := rfl
  refine ⟨T, ?_, ?_⟩
  · rw [hT, inv_mul_cancel₀ hS1]
  · intro x hx
    rw [hT, cls_mul p _ _ (inv_ne_zero hS1)
      (fun h => hx (S.injective (h.trans S.map_zero.symm))),
      cls_eq_zero_of_mem_powSubfield p hp hL ((powSubfield p L).inv_mem hC)
        (inv_ne_zero hS1), zero_add, hcls x hx]

-- @node: normalizedLift_exists_of_lines
/-- Suppose [p is prime](hyp:hp), [K has characteristic p](hyp:hK),
[L has characteristic p](hyp:hL), and [both fields are finite-dimensional of
dimension at least three over their respective subfields generated by p-th powers](hyp:hspaces).
If [an additive isomorphism Ψ between their degree-one Milnor groups modulo p](hyp:Ψ)
[sends every projective line for K to a projective line for L](hyp:hlines), then
[there is an additive bijection T from K to L sending one to one, such that
the class of T of x is Ψ of the class of x for every nonzero x](goal). -/
lemma normalizedLift_exists_of_lines (hp : PrimeChar p) (hK : CharP K p) (hL : CharP L p)
    (hspaces : ProjectiveLiftSpaces ↥(powSubfield p K) ↥(powSubfield p L) K L)
    (Ψ : MilnorOne K p ≃+ MilnorOne L p)
    (hlines : ∀ S, IsProjLine p K S → IsProjLine p L (Ψ '' S)) :
    ∃ T : K ≃+ L, T 1 = 1 ∧ ∀ x, x ≠ 0 → cls p (T x) = Ψ (cls p x) := by
  let ψ := milnorProjectiveMap p hp hK hL Ψ.toEquiv
  obtain ⟨σ, S, _, hproj⟩ := projective_lift_exists ψ hspaces
    (milnorProjectiveMap_lines p hp hK hL Ψ.toEquiv hlines)
  apply additiveLift_normalize p hp hK hL Ψ.toAddMonoidHom S
  intro x hx
  have hSx : S x ≠ 0 := fun h => hx (S.injective (h.trans S.map_zero.symm))
  calc
    cls p (S x) = projectiveClass p (ψ (Projectivization.mk _ x hx)) :=
      projectiveClass_eq_of_mem p hp hL _ hSx (hproj x hx)
    _ = Ψ (cls p x) := by
      rw [milnorProjectiveMap_class, projectiveClass_mk p hp hK]
      rfl

-- @node: fieldIso_exists_of_lines
/-- Suppose [p is prime](hyp:hp), [K has characteristic p](hyp:hK),
[L has characteristic p](hyp:hL), and [both fields are finite-dimensional of
dimension at least three over their respective subfields generated by p-th powers](hyp:hspaces).
If [an additive isomorphism Ψ between their degree-one Milnor groups modulo p](hyp:Ψ)
[sends every projective line for K to a projective line for L](hyp:hlines), then
[there is a field isomorphism from K to L whose induced Milnor map equals Ψ](goal). -/
lemma fieldIso_exists_of_lines (hp : PrimeChar p) (hK : CharP K p) (hL : CharP L p)
    (hspaces : ProjectiveLiftSpaces ↥(powSubfield p K) ↥(powSubfield p L) K L)
    (Ψ : MilnorOne K p ≃+ MilnorOne L p)
    (hlines : ∀ S, IsProjLine p K S → IsProjLine p L (Ψ '' S)) :
    ∃ α : K ≃+* L, inducedMap p α = Ψ := by
  obtain ⟨T, h1, hcls⟩ := normalizedLift_exists_of_lines p hp hK hL hspaces Ψ hlines
  let : FiniteDimensional ↥(powSubfield p L) L := hspaces.2.1
  have hd : 2 ≤ Module.finrank ↥(powSubfield p L) L := by have := hspaces.2.2.2; omega
  exact ⟨normalizedLiftRingEquiv p hd Ψ.toAddMonoidHom T h1 hcls,
    normalizedLiftRingEquiv_inducedMap p hd Ψ.toAddMonoidHom T h1 hcls⟩

end Papers.OaiReconstructionMilnorTheory
